pub type AppError = Failed(String)

pub fn slowProduct(a: Int64, b: Int64) -> Int64 {
    var total: Int64 = 0
    var i: Int64 = 0
    while i < a {
        var j: Int64 = 0
        while j < b {
            total = total + 1
            j = j + 1
        }
        i = i + 1
    }
    return total
}

pub fn main() -> Result<(), AppError> {
    return Ok(())
}
