import std.concurrent as conc

pub type AppError = Failed(String)

pub fn emptyWait() effect io -> Int64 {
    let ch: conc.Channel<Int64> = conc.channel(1)
    var out: Int64 = 0
    let r = scope timeout(50) {
        let t = task effect io {
            let v = ch.receive()
            match v {
                Some(x) => { let _ = x }
                None => { let _ = 0 }
            }
        }
        let _ = t.await()
    }
    match r {
        Ok(_) => { out = 1 }
        Err(_) => { out = 100 }
    }
    return out
}

pub fn main() effect io -> Result<(), AppError> {
    return Ok(())
}
