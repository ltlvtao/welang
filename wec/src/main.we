// wec — the bootstrap compiler's We-hosted seed (B3b). The driver carries
// only the contract (design D4): read wec-input.we from the working
// directory (the language has no argv face), pass it through the lexical
// stage, and write the serialization to stdout, always exiting 0 —
// diagnostics ride the output, not the process status. The scanner and
// serializer live in lex; the pure helpers live in lexnum.

import std.fs
import std.io

import lex

pub type AppError = Failed(String)

pub fn main() effect io -> Result<(), AppError> {
    match fs.readFile("wec-input.we") {
        Ok(src) => {
            io.print(lex.run(src))
        }
        Err(_) => {
            io.print("E 1 1 E0001 cannot read wec-input.we\n")
        }
    }
    return Ok(())
}
