// lexnum — the port's pure helpers (B3b): the codepoint width table, the
// numeric renderers the message discipline needs (decimal and the two hex
// cases), the serialization escaping, the Go-%q quote faces for the
// character references, the byte-value probe, and the numeric-literal
// span and validators (E0006's clauses, ported clause for clause from
// internal/lex).
//
// The byte-value probe exists because We has no byte-exposure face: a
// single byte b >= 0x80 cannot be read as a number, only compared as a
// one-byte string. Four well-formed probe literals cover the 243 nameable
// byte values at known positions (leads C2-DF and trails 80-BF in the
// two-byte range, leads E0-EF, leads F0-F4; ASCII decodes directly), and
// membership plus offset arithmetic recovers the value. C0, C1, and F5-FF
// — the thirteen values no valid rune ever contains — are unnameable; the
// probe answers -1 and hex2 renders "??" so a miss fails loudly rather
// than silently (the reconciliation fence keeps such sources out; see
// follow-up #30). After checkEncoding passes, every byte of the source is
// nameable, so esc and the E0001 byte message never miss in practice.

import std.string

// widthOf is the codepoint's predicted UTF-8 width. After checkEncoding
// the source is well-formed, so predicted width is actual width.
pub fn widthOf(c: Int64) -> Int64 {
    if c < 0x80 {
        return 1
    }
    if c < 0x800 {
        return 2
    }
    if c < 0x10000 {
        return 3
    }
    return 4
}

fn digitChar(d: Int64) -> String {
    let table = "0123456789"
    return table.byteSlice(d, d + 1)
}

// int64ToString renders one non-negative Int64 in decimal (offsets, lines,
// columns in the messages and serialization; the stdlib has no toString
// face for this yet). Negatives render with a sign for safety, though no
// caller produces one.
pub fn int64ToString(v: Int64) -> String {
    if v == 0 {
        return "0"
    }
    var rest = v
    var neg = false
    if v < 0 {
        neg = true
        rest = 0 - v
    }
    var out = ""
    while rest > 0 {
        out = digitChar(rest % 10) + out
        rest = rest / 10
    }
    if neg {
        return "-" + out
    }
    return out
}

// hex2 renders one byte value as two uppercase hex digits (the E0001
// byte message's 0x%02X). A probe miss (-1) renders "??" so the corner
// stays visible in any output it ever reaches.
pub fn hex2(v: Int64) -> String {
    if v < 0 {
        return "??"
    }
    let table = "0123456789ABCDEF"
    return table.byteSlice(v / 16, v / 16 + 1) + table.byteSlice(v % 16, v % 16 + 1)
}

// hex2Lower is the lowercase form Go's strconv.Quote uses for \xNN
// control escapes inside quote.
fn hex2Lower(v: Int64) -> String {
    let table = "0123456789abcdef"
    return table.byteSlice(v / 16, v / 16 + 1) + table.byteSlice(v % 16, v % 16 + 1)
}

// esc is the serialization spec's escaping (design D4): backslash doubles,
// printable ASCII 0x21-0x7E passes verbatim, and every other byte — space,
// the controls, 0x7F, non-ASCII — renders as a backslash plus two
// uppercase hex digits. Mechanically reversible; the tower's Go side
// implements the same table.
pub fn esc(s: String) -> String {
    var out = ""
    var off: Int64 = 0
    let n = s.byteLength()
    while off < n {
        let b = probeByteValue(s.byteSlice(off, off + 1))
        if b == 0x5C {
            out = out + "\\\\"
        } else if b >= 0x21 && b <= 0x7E {
            out = out + s.byteSlice(off, off + 1)
        } else {
            out = out + "\\" + hex2(b)
        }
        off = off + 1
    }
    return out
}

// quote renders one rune's text the way Go's %q does in the E0001
// messages: the standard escapes, printable ASCII verbatim, and —
// matching Go for printable runes — non-ASCII verbatim. Non-printable
// non-ASCII (\uXXXX in Go) and the control range (\xNN, kept identical)
// are corners the corpus never reaches in these messages; a divergence
// there fails the reconciliation loudly rather than passing silently.
pub fn quote(text: String) -> String {
    return "\"" + quoteBody(text) + "\""
}

// quoteBody is quote's per-rune body (no surrounding quotes).
pub fn quoteBody(text: String) -> String {
    let c = string.runeCode(text.charAt(0))
    if c == 0x22 {
        return "\\\""
    }
    if c == 0x5C {
        return "\\\\"
    }
    if c == 0x0A {
        return "\\n"
    }
    if c == 0x09 {
        return "\\t"
    }
    if c == 0x0D {
        return "\\r"
    }
    if c >= 0x20 && c <= 0x7E {
        return text
    }
    if c >= 0x80 {
        return text
    }
    return "\\x" + hex2Lower(c)
}

// quoteText is the %q face for a multi-rune span (E0006's message quotes
// the whole numeric span). The spans are printable ASCII by construction;
// any other byte takes the same per-rune face as quote, so a divergence
// still fails the reconciliation loudly.
pub fn quoteText(s: String) -> String {
    var body = ""
    var off: Int64 = 0
    var ri: Int64 = 0
    let n = s.byteLength()
    while off < n {
        let w = widthOf(string.runeCode(s.charAt(ri)))
        body = body + quoteBody(s.byteSlice(off, off + w))
        off = off + w
        ri = ri + 1
    }
    return "\"" + body + "\""
}

// probeByteValue names the byte value of a one-byte string. ASCII decodes
// directly; the four probe literals place every other nameable value at a
// computable offset (see the file header). A miss answers -1.
pub fn probeByteValue(s: String) -> Int64 {
    let c = string.runeCode(s.charAt(0))
    if c < 0x80 {
        return c
    }
    // Two-byte leads C2-DF: codepoints 0x80+64j sit at even offsets, and
    // the lead of 0x80+64j is 0xC2+j.
    let leads2 = "\u{80}\u{C0}\u{100}\u{140}\u{180}\u{1C0}\u{200}\u{240}\u{280}\u{2C0}\u{300}\u{340}\u{380}\u{3C0}\u{400}\u{440}\u{480}\u{4C0}\u{500}\u{540}\u{580}\u{5C0}\u{600}\u{640}\u{680}\u{6C0}\u{700}\u{740}\u{780}\u{7C0}"
    // Continuations 80-BF: codepoints 0xC0+m encode as C3 plus trail
    // 0x80+m, so the trail of cp m sits at odd offset 2m+1.
    let trails = "\u{C0}\u{C1}\u{C2}\u{C3}\u{C4}\u{C5}\u{C6}\u{C7}\u{C8}\u{C9}\u{CA}\u{CB}\u{CC}\u{CD}\u{CE}\u{CF}\u{D0}\u{D1}\u{D2}\u{D3}\u{D4}\u{D5}\u{D6}\u{D7}\u{D8}\u{D9}\u{DA}\u{DB}\u{DC}\u{DD}\u{DE}\u{DF}\u{E0}\u{E1}\u{E2}\u{E3}\u{E4}\u{E5}\u{E6}\u{E7}\u{E8}\u{E9}\u{EA}\u{EB}\u{EC}\u{ED}\u{EE}\u{EF}\u{F0}\u{F1}\u{F2}\u{F3}\u{F4}\u{F5}\u{F6}\u{F7}\u{F8}\u{F9}\u{FA}\u{FB}\u{FC}\u{FD}\u{FE}\u{FF}"
    // Three-byte leads E0-EF: 0x800, 0x1000, 0x2000...0xF000 at stride 3.
    let leads3 = "\u{800}\u{1000}\u{2000}\u{3000}\u{4000}\u{5000}\u{6000}\u{7000}\u{8000}\u{9000}\u{A000}\u{B000}\u{C000}\u{D000}\u{E000}\u{F000}"
    // Four-byte leads F0-F4: 0x10000, 0x40000, 0x80000, 0xC0000, 0x100000
    // at stride 4.
    let leads4 = "\u{10000}\u{40000}\u{80000}\u{C0000}\u{100000}"
    var k: Int64 = 0
    let n1 = leads2.byteLength()
    while k < n1 {
        if k % 2 == 0 {
            if leads2.byteSlice(k, k + 1) == s {
                return 0xC2 + k / 2
            }
        }
        k = k + 1
    }
    k = 0
    let n2 = trails.byteLength()
    while k < n2 {
        if k % 2 == 1 {
            if trails.byteSlice(k, k + 1) == s {
                return 0x80 + (k - 1) / 2
            }
        }
        k = k + 1
    }
    k = 0
    let n3 = leads3.byteLength()
    while k < n3 {
        if k % 3 == 0 {
            if leads3.byteSlice(k, k + 1) == s {
                return 0xE0 + k / 3
            }
        }
        k = k + 1
    }
    k = 0
    let n4 = leads4.byteLength()
    while k < n4 {
        if k % 4 == 0 {
            if leads4.byteSlice(k, k + 1) == s {
                return 0xF0 + k / 4
            }
        }
        k = k + 1
    }
    return 0 - 1
}

// byteChar is probeByteValue's inverse: the one-byte string that carries
// byte value b. The serialized text this serves (B3c's T-line unescape) is
// pure ASCII on its face — esc renders every non-printable and non-ASCII
// byte as backslash-hex — so the bytes it is asked for are exactly the
// ones the probe tables can name: the controls and space (a 34-entry
// table whose offsets line up with the values), 0x7F included, and the
// multi-byte ranges through the same lead/trail leak the probes use. The
// thirteen unnameable values never occur inside valid UTF-8, which a
// token's text always is; a miss answers the empty string and any caller
// that somehow reached it fails loudly downstream.
pub fn byteChar(b: Int64) -> String {
    if b >= 0 && b <= 0x20 {
        let ctrls = "\u{0}\u{1}\u{2}\u{3}\u{4}\u{5}\u{6}\u{7}\u{8}\u{9}\u{A}\u{B}\u{C}\u{D}\u{E}\u{F}\u{10}\u{11}\u{12}\u{13}\u{14}\u{15}\u{16}\u{17}\u{18}\u{19}\u{1A}\u{1B}\u{1C}\u{1D}\u{1E}\u{1F}\u{20}\u{7F}"
        return ctrls.byteSlice(b, b + 1)
    }
    if b == 0x7F {
        let ctrls = "\u{0}\u{1}\u{2}\u{3}\u{4}\u{5}\u{6}\u{7}\u{8}\u{9}\u{A}\u{B}\u{C}\u{D}\u{E}\u{F}\u{10}\u{11}\u{12}\u{13}\u{14}\u{15}\u{16}\u{17}\u{18}\u{19}\u{1A}\u{1B}\u{1C}\u{1D}\u{1E}\u{1F}\u{20}\u{7F}"
        return ctrls.byteSlice(33, 34)
    }
    if b >= 0x80 && b <= 0xBF {
        // Codepoints U+00C0..U+00FF encode as C3 plus trail 0x80+m, so the
        // trail of m sits at odd offset 2m+1.
        let trails = "\u{C0}\u{C1}\u{C2}\u{C3}\u{C4}\u{C5}\u{C6}\u{C7}\u{C8}\u{C9}\u{CA}\u{CB}\u{CC}\u{CD}\u{CE}\u{CF}\u{D0}\u{D1}\u{D2}\u{D3}\u{D4}\u{D5}\u{D6}\u{D7}\u{D8}\u{D9}\u{DA}\u{DB}\u{DC}\u{DD}\u{DE}\u{DF}\u{E0}\u{E1}\u{E2}\u{E3}\u{E4}\u{E5}\u{E6}\u{E7}\u{E8}\u{E9}\u{EA}\u{EB}\u{EC}\u{ED}\u{EE}\u{EF}\u{F0}\u{F1}\u{F2}\u{F3}\u{F4}\u{F5}\u{F6}\u{F7}\u{F8}\u{F9}\u{FA}\u{FB}\u{FC}\u{FD}\u{FE}\u{FF}"
        let k = 2 * (b - 0x80) + 1
        return trails.byteSlice(k, k + 1)
    }
    if b >= 0xC2 && b <= 0xDF {
        // Codepoints 0x80+64j encode as lead C2+j plus trail, so lead C2+j
        // sits at even offset 2j.
        let leads2 = "\u{80}\u{C0}\u{100}\u{140}\u{180}\u{1C0}\u{200}\u{240}\u{280}\u{2C0}\u{300}\u{340}\u{380}\u{3C0}\u{400}\u{440}\u{480}\u{4C0}\u{500}\u{540}\u{580}\u{5C0}\u{600}\u{640}\u{680}\u{6C0}\u{700}\u{740}\u{780}\u{7C0}"
        let k = 2 * (b - 0xC2)
        return leads2.byteSlice(k, k + 1)
    }
    if b >= 0xE0 && b <= 0xEF {
        // Codepoints 0x800, 0x1000, 0x2000..0xF000 encode with leads
        // E0..EF; lead E0+j sits at offset 3j.
        let leads3 = "\u{800}\u{1000}\u{2000}\u{3000}\u{4000}\u{5000}\u{6000}\u{7000}\u{8000}\u{9000}\u{A000}\u{B000}\u{C000}\u{D000}\u{E000}\u{F000}"
        let k = 3 * (b - 0xE0)
        return leads3.byteSlice(k, k + 1)
    }
    if b >= 0xF0 && b <= 0xF4 {
        // Codepoints 0x10000, 0x40000, 0x80000, 0xC0000, 0x100000 encode
        // with leads F0..F4; lead F0+j sits at offset 4j.
        let leads4 = "\u{10000}\u{40000}\u{80000}\u{C0000}\u{100000}"
        let k = 4 * (b - 0xF0)
        return leads4.byteSlice(k, k + 1)
    }
    return ""
}

// --- the numeric face (B3b T3) ---
//
// Everything below works on numeric spans — runs of [0-9a-zA-Z_.+-] the
// scanner already carved out — so every byte is ASCII and byteAt is exact.

// byteAt names one byte's value. On a numeric span (always ASCII) this is
// direct; a non-ASCII byte answers -1 and fails loudly downstream.
pub fn byteAt(s: String, i: Int64) -> Int64 {
    return probeByteValue(s.byteSlice(i, i + 1))
}

pub fn isDigitB(b: Int64) -> Bool {
    return b >= 48 && b <= 57
}

pub fn isLetterB(b: Int64) -> Bool {
    return (b >= 97 && b <= 122) || (b >= 65 && b <= 90)
}

pub fn isHexDigitB(b: Int64) -> Bool {
    return isDigitB(b) || (b >= 97 && b <= 102) || (b >= 65 && b <= 70)
}

// hasDot reports whether the span carries a dot (the float branch's
// discriminator).
pub fn hasDot(s: String) -> Bool {
    let n = s.byteLength()
    var k: Int64 = 0
    while k < n {
        if byteAt(s, k) == 46 {
            return true
        }
        k = k + 1
    }
    return false
}

// numericSpan returns the end offset of the numeric-shaped run starting
// at i: [0-9a-zA-Z_] freely; '.' consumed unless the next byte opens a
// `..` token (a numeric literal's maximal munch never absorbs a dot that
// begins `..`); '+'/'-' consumed only immediately after an exponent
// marker of a dotted decimal form. s[i] must be a digit.
pub fn numericSpan(s: String, i: Int64) -> Int64 {
    let n = s.byteLength()
    var dot = false
    var k = i
    while k < n {
        let c = byteAt(s, k)
        if isDigitB(c) || isLetterB(c) || c == 95 {
            k = k + 1
        } else if c == 46 {
            var opensRange = false
            if k + 1 < n {
                if byteAt(s, k + 1) == 46 {
                    opensRange = true
                }
            }
            if opensRange {
                return k
            }
            dot = true
            k = k + 1
        } else if c == 43 || c == 45 {
            var okSign = false
            if dot && k > 0 {
                let pc = byteAt(s, k - 1)
                if pc == 101 || pc == 69 {
                    okSign = true
                }
            }
            if okSign {
                k = k + 1
            } else {
                return k
            }
        } else {
            return k
        }
    }
    return k
}

// digitRunEnd returns the end of the leading [0-9_]* run of s at i.
pub fn digitRunEnd(s: String, i: Int64) -> Int64 {
    let n = s.byteLength()
    var k = i
    while k < n {
        let c = byteAt(s, k)
        if isDigitB(c) || c == 95 {
            k = k + 1
        } else {
            break
        }
    }
    return k
}

// stripUnderscores removes every separator (checkDigitRun's bare form).
fn stripUnderscores(s: String) -> String {
    var out = ""
    let n = s.byteLength()
    var k: Int64 = 0
    while k < n {
        let c = byteAt(s, k)
        if c != 95 {
            out = out + s.byteSlice(k, k + 1)
        }
        k = k + 1
    }
    return out
}

// checkDigitRun validates one [0-9_]* run: underscores strictly between
// two digits, and — when leadZero is set (integer and float integer
// parts) — no leading decimal zero on the underscore-stripped digits.
// An empty answer means the run passes.
pub fn checkDigitRun(run: String, leadZero: Bool) -> String {
    if leadZero {
        let bare = stripUnderscores(run)
        if bare.byteLength() > 1 {
            if byteAt(bare, 0) == 48 {
                return "a decimal literal has no leading zero (0 alone is allowed)"
            }
        }
    }
    let rn = run.byteLength()
    var j: Int64 = 0
    while j < rn {
        if byteAt(run, j) == 95 {
            var bad = false
            if j == 0 {
                bad = true
            } else if j == rn - 1 {
                bad = true
            } else if isDigitB(byteAt(run, j - 1)) == false {
                bad = true
            } else if isDigitB(byteAt(run, j + 1)) == false {
                bad = true
            } else {
                bad = false
            }
            if bad {
                return "_ separates digit groups only between two digits"
            }
        }
        j = j + 1
    }
    return ""
}

// intSuffixAt is the integer suffix table in the reference's order.
fn intSuffixAt(k: Int64) -> String {
    if k == 0 {
        return "i8"
    }
    if k == 1 {
        return "u8"
    }
    if k == 2 {
        return "i16"
    }
    if k == 3 {
        return "u16"
    }
    if k == 4 {
        return "i32"
    }
    if k == 5 {
        return "u32"
    }
    if k == 6 {
        return "i64"
    }
    return "u64"
}

pub fn knownIntSuffix(tail: String) -> Bool {
    var k: Int64 = 0
    while k < 8 {
        if tail == intSuffixAt(k) {
            return true
        }
        k = k + 1
    }
    return false
}

pub fn knownFloatSuffix(tail: String) -> Bool {
    return tail == "f32" || tail == "f64"
}

pub fn allLetters(s: String) -> Bool {
    let n = s.byteLength()
    if n == 0 {
        return false
    }
    var k: Int64 = 0
    while k < n {
        if isLetterB(byteAt(s, k)) == false {
            return false
        }
        k = k + 1
    }
    return true
}

// digitOfBaseB reports whether the byte is a digit of the based literal's
// base (base is the prefix letter: x, o, or b).
fn digitOfBaseB(c: Int64, base: Int64) -> Bool {
    if base == 120 {
        return isHexDigitB(c)
    }
    if base == 111 {
        return c >= 48 && c <= 55
    }
    return c == 48 || c == 49
}

// validateBased checks 0x/0o/0b forms: integer forms only — digits of the
// base with separators, an optional integer suffix, nothing else. An
// empty answer means the form passes.
pub fn validateBased(s: String) -> String {
    let base = byteAt(s, 1)
    let rest = s.byteSlice(2, s.byteLength())
    if hasDot(rest) {
        return "based literals (0x/0o/0b) are integer forms: no dot, no exponent"
    }
    var body = rest
    let rn = rest.byteLength()
    var k: Int64 = 0
    while k < 8 {
        let suf = intSuffixAt(k)
        let sl = suf.byteLength()
        if rn > sl {
            if rest.byteSlice(rn - sl, rn) == suf {
                if digitOfBaseB(byteAt(rest, rn - sl - 1), base) {
                    body = rest.byteSlice(0, rn - sl)
                    break
                }
            }
        }
        k = k + 1
    }
    if body == "" {
        return "the base prefix wants at least one digit of its base"
    }
    let bn = body.byteLength()
    var j: Int64 = 0
    while j < bn {
        let c = byteAt(body, j)
        if digitOfBaseB(c, base) == false {
            if c == 95 {
                var bad = false
                if j == 0 {
                    bad = true
                } else if j == bn - 1 {
                    bad = true
                } else if digitOfBaseB(byteAt(body, j - 1), base) == false {
                    bad = true
                } else if digitOfBaseB(byteAt(body, j + 1), base) == false {
                    bad = true
                } else {
                    bad = false
                }
                if bad {
                    return "_ separates digit groups only between two digits"
                }
            } else {
                return "only digits of the literal's base may follow its prefix"
            }
        }
        j = j + 1
    }
    return ""
}

// validateFloat checks dotted decimal forms: digits '.' digits, an
// optional exponent (e/E, optional sign, at least one digit), an optional
// float suffix, and nothing else. An empty answer means the form passes.
pub fn validateFloat(s: String) -> String {
    var body = s
    let n0 = s.byteLength()
    var stripped = false
    if n0 > 3 {
        if s.byteSlice(n0 - 3, n0) == "f32" {
            if isDigitB(byteAt(s, n0 - 4)) {
                body = s.byteSlice(0, n0 - 3)
                stripped = true
            }
        }
    }
    if stripped == false {
        if n0 > 3 {
            if s.byteSlice(n0 - 3, n0) == "f64" {
                if isDigitB(byteAt(s, n0 - 4)) {
                    body = s.byteSlice(0, n0 - 3)
                }
            }
        }
    }
    var j = digitRunEnd(body, 0)
    let headDetail = checkDigitRun(body.byteSlice(0, j), true)
    if headDetail != "" {
        return headDetail
    }
    let bn = body.byteLength()
    if j >= bn {
        return "a float wants a digit on each side of the dot"
    }
    if byteAt(body, j) != 46 {
        return "a float wants a digit on each side of the dot"
    }
    if j == 0 {
        return "a float wants a digit on each side of the dot"
    }
    j = j + 1
    if j >= bn {
        return "a float wants a digit on each side of the dot"
    }
    if isDigitB(byteAt(body, j)) == false {
        return "a float wants a digit on each side of the dot"
    }
    var k = digitRunEnd(body, j)
    let fracDetail = checkDigitRun(body.byteSlice(j, k), false)
    if fracDetail != "" {
        return fracDetail
    }
    j = k
    if j < bn {
        let ec = byteAt(body, j)
        if ec == 101 || ec == 69 {
            j = j + 1
            if j < bn {
                let sc = byteAt(body, j)
                if sc == 43 || sc == 45 {
                    j = j + 1
                }
            }
            if j >= bn {
                return "an exponent wants at least one digit"
            }
            if isDigitB(byteAt(body, j)) == false {
                return "an exponent wants at least one digit"
            }
            k = digitRunEnd(body, j)
            let expDetail = checkDigitRun(body.byteSlice(j, k), false)
            if expDetail != "" {
                return expDetail
            }
            j = k
        }
    }
    if j < bn {
        return "the suffix set is closed (i8 i16 i32 i64 u8 u16 u32 u64, floats f32 f64)"
    }
    return ""
}

// --- the attribute-argument helpers (B3b T4) ---
//
// The raw argument region a #[unit(args)] carved out is validated
// off-line, on the region text: skipArgString/skipArgHole walk a string
// literal inside the region (mutually recursive — a hole may hold
// strings, a string may hold holes), collectArg gathers one argument's
// text for the E0009 message, trimSpace cuts the whitespace the
// reference's strings.TrimSpace would, and hexVal feeds the \u{h..}
// accumulator.

// hexVal is one hex digit's value (the \u{h..} accumulator; the caller
// has already checked the digit domain).
pub fn hexVal(b: Int64) -> Int64 {
    if b >= 48 && b <= 57 {
        return b - 48
    }
    if b >= 97 && b <= 102 {
        return b - 97 + 10
    }
    return b - 65 + 10
}

// hasPrefixAt reports whether s carries prefix at offset i.
pub fn hasPrefixAt(s: String, i: Int64, prefix: String) -> Bool {
    let sn = s.byteLength()
    let pn = prefix.byteLength()
    if i + pn > sn {
        return false
    }
    return s.byteSlice(i, i + pn) == prefix
}

// trimSpace cuts the leading and trailing whitespace of the raw argument
// region (the reference's strings.TrimSpace). The region cannot carry
// line breaks — the balanced walk that carved it dies on them first — so
// the ASCII whitespace set is the reachable face; the unicode spaces the
// reference would also trim are a corpus-unreachable corner that would
// fail the reconciliation loudly rather than pass silently.
pub fn trimSpace(s: String) -> String {
    let n = s.byteLength()
    var a: Int64 = 0
    var b = n
    while a < b {
        let c = byteAt(s, a)
        if c == 32 || c == 9 || c == 10 || c == 11 || c == 12 || c == 13 {
            a = a + 1
        } else {
            break
        }
    }
    while b > a {
        let c = byteAt(s, b - 1)
        if c == 32 || c == 9 || c == 10 || c == 11 || c == 12 || c == 13 {
            b = b - 1
        } else {
            break
        }
    }
    return s.byteSlice(a, b)
}

// skipArgString walks one string literal starting at raw[i] == '"' and
// returns the offset just past it, plus whether the literal contains an
// interpolation hole (such a string embeds an expression, so it is not a
// compile-time literal). -1 means the literal never closed — defensive
// only, the region's own walk already validated the shape.
pub fn skipArgString(raw: String, i: Int64) -> (Int64, Bool) {
    let n = raw.byteLength()
    var j = i + 1
    while j < n {
        let c = byteAt(raw, j)
        if c == 92 {
            j = j + 2
        } else if c == 34 {
            return (j + 1, false)
        } else if c == 36 {
            if j + 1 < n {
                if byteAt(raw, j + 1) == 123 {
                    return skipArgHole(raw, j + 2)
                }
            }
            j = j + 1
        } else {
            j = j + 1
        }
    }
    return (0 - 1, false)
}

// skipArgHole continues skipArgString from inside an interpolation hole:
// a brace-balanced walk (nested strings included), then the enclosing
// string resumes. Passing through a hole means the literal interpolates.
pub fn skipArgHole(raw: String, j: Int64) -> (Int64, Bool) {
    let n = raw.byteLength()
    var k = j
    var depth: Int64 = 1
    while k < n {
        if depth <= 0 {
            break
        }
        let c = byteAt(raw, k)
        if c == 123 {
            depth = depth + 1
            k = k + 1
        } else if c == 125 {
            depth = depth - 1
            k = k + 1
        } else if c == 34 {
            let (e, inner) = skipArgString(raw, k)
            if inner {
                // the reference discards this flag here too
            }
            if e < 0 {
                return (0 - 1, true)
            }
            k = e
        } else {
            k = k + 1
        }
    }
    if depth > 0 {
        return (0 - 1, true)
    }
    // continue the enclosing string after the hole
    while k < n {
        let c = byteAt(raw, k)
        if c == 92 {
            k = k + 2
        } else if c == 34 {
            return (k + 1, true)
        } else if c == 36 {
            if k + 1 < n {
                if byteAt(raw, k + 1) == 123 {
                    return skipArgHole(raw, k + 2)
                }
            }
            k = k + 1
        } else {
            k = k + 1
        }
    }
    return (0 - 1, true)
}

// collectArg gathers the argument text from a start offset to the next
// top-level comma (or the region's end), trimmed, for the E0009 message.
pub fn collectArg(raw: String, from: Int64) -> String {
    let n = raw.byteLength()
    var j = from
    var depth: Int64 = 0
    while j < n {
        let c = byteAt(raw, j)
        if c == 34 {
            let (e, inner) = skipArgString(raw, j)
            if inner {
                // the reference discards this flag here too
            }
            if e < 0 {
                j = j + 1
            } else {
                j = e
            }
        } else if c == 91 || c == 40 {
            depth = depth + 1
            j = j + 1
        } else if c == 93 || c == 41 {
            depth = depth - 1
            j = j + 1
        } else if c == 44 {
            if depth == 0 {
                return trimSpace(raw.byteSlice(from, j))
            }
            j = j + 1
        } else {
            j = j + 1
        }
    }
    return trimSpace(raw.byteSlice(from, n))
}
