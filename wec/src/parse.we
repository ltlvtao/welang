// parse — the parser port (B3c): internal/parser/parser.go transcribed as
// We source. T2 landed the file structure (the item dispatch with its
// prefix order, imports, effect declarations, the fn basic shape, top-level
// lets, the naming matrix, the module name-space collisions); T3 lands the
// composite declaration family — record in its three categories, sum with
// bare and payload variants, newtype, interface with associated types and
// method signatures, impl with associated-type bindings and methods, the
// foreign block — and the type-reference family beyond the named forms:
// the unit and tuple forms, the fn type with its effect tags, and the
// generic and where clauses every declaration takes. The faces still
// pending (statements, the full expression grammar, documentation
// attachment) latch the pending marker, so the tower records those entries
// as divergent rather than mis-parsing them.
//
// The serialized text this module walks is pure ASCII on its face — esc
// renders every byte outside 0x21-0x7E as backslash-hex — so byteAt is
// exact throughout, and the token text the cursor unescapes is always
// well-formed UTF-8 (the lexer guaranteed it before serializing), so the
// rebuilt strings load cleanly.
//
// Two language-face adaptations shape the port (the B3b pair, disclosed
// in that change's design notes): We has no panic/recover, so Go's
// first-error stop is an error latch every failure-capable caller checks,
// and the bnd latch answers the NotImplemented face the same way — here
// it also carries the pending markers for the faces later tasks own. The
// AST never materializes as a tree: each item's P lines are composed as
// strings in parse order, which is the pre-order the serializer writes.

import lexnum

// Token is one lexical unit rebuilt from a T line. It mirrors the six
// fields the serializer writes (kind, text, position, and the attr face's
// name and raw arguments) — a module-local twin of lex's Token, because
// the Parser record carries it as a field and record-with-record stays
// same-module (the language-face map's green face).
record Token {
    kind: String,
    text: String,
    line: Int64,
    col: Int64,
    attrName: String,
    attrArgs: String,
}

// Parser is the port's state carrier — the design's full field table, in
// the Go struct's order. The stacks are String-encoded (a line per entry,
// linear scans; identifiers carry no spaces or newlines, so the encodings
// stay unambiguous): fnsText holds `name;hasRet;deferBody` per fn context,
// namesText holds `name line` per declared name, itemStartsText holds the
// top-level item start lines space-separated. The error latch (failed plus
// the four err fields) replaces Go's panic(stop{d}); the bnd latch replaces
// panic(bstop{what}) — the two are independent, as in the reference.
pub record Parser {
    toksText: String,
    docsText: String,
    pos: Int64,
    cur: Token,
    last: Token,
    depth: Int64,
    loopDepth: Int64,
    direct: Int64,
    noBrace: Int64,
    shortBody: Int64,
    fnBrace: Int64,
    valSite: String,
    exprValue: Int64,
    fnsText: String,
    namesText: String,
    itemStartsText: String,
    testModule: Int64,
    inTestBody: Int64,
    astText: String,
    failed: Int64,
    errLine: Int64,
    errCol: Int64,
    errCode: String,
    errMsg: String,
    bnd: Int64,
    bndWhat: String,
}

// zeroTok is the cursor's ground state (also what a position past the last
// T line loads — the reference never reads there, its eof token being a
// real token, so the shape only guards the walk).
fn zeroTok() -> Token {
    return Token { kind: "eof", text: "", line: 0, col: 0, attrName: "", attrArgs: "" }
}

// lineEndAt returns the offset of the newline ending the line that starts
// at from (the string's length when no newline follows).
fn lineEndAt(s: String, from: Int64) -> Int64 {
    var i = from
    let n = s.byteLength()
    while i < n {
        if lexnum.byteAt(s, i) == 10 {
            return i
        }
        i = i + 1
    }
    return n
}

// fieldEnd returns the exclusive end of the field starting at from: the
// next unescaped space, or the line's end at to. A space preceded by an
// even run of backslashes is a boundary; an odd run escapes it.
fn fieldEnd(s: String, from: Int64, to: Int64) -> Int64 {
    var i = from
    var slashes: Int64 = 0
    while i < to {
        let b = lexnum.byteAt(s, i)
        if b == 0x20 && slashes % 2 == 0 {
            return i
        }
        if b == 0x5C {
            slashes = slashes + 1
        } else {
            slashes = 0
        }
        i = i + 1
    }
    return to
}

// unesc reverses the serialization escaping over s[from:to]: a doubled
// backslash is one backslash, a backslash plus two hex digits is that
// byte, anything else passes through. esc is mechanically reversible, and
// the bytes it hid always reform into the well-formed UTF-8 they were.
fn unesc(s: String, from: Int64, to: Int64) -> String {
    var out = ""
    var i = from
    while i < to {
        let b = lexnum.byteAt(s, i)
        if b == 0x5C {
            let b2 = lexnum.byteAt(s, i + 1)
            if b2 == 0x5C {
                out = out + "\\"
                i = i + 2
            } else {
                let v = lexnum.hexVal(b2) * 16 + lexnum.hexVal(lexnum.byteAt(s, i + 2))
                out = out + lexnum.byteChar(v)
                i = i + 3
            }
        } else {
            out = out + s.byteSlice(i, i + 1)
            i = i + 1
        }
    }
    return out
}

// parseDec reads an ASCII decimal run (the T line's position fields).
fn parseDec(s: String, from: Int64, to: Int64) -> Int64 {
    var v: Int64 = 0
    var i = from
    while i < to {
        v = v * 10 + (lexnum.byteAt(s, i) - 48)
        i = i + 1
    }
    return v
}

// tokAt rebuilds the token carried by the T line starting at pos; a
// position past the section answers the eof-shaped ground state. The
// line's fields split at unescaped spaces: T, line, col, kind, text,
// and — on the attr kind — the name and raw arguments.
fn tokAt(toksText: String, pos: Int64) -> Token {
    if pos >= toksText.byteLength() {
        return zeroTok()
    }
    let end = lineEndAt(toksText, pos)
    var i = pos + 2
    let e1 = fieldEnd(toksText, i, end)
    let ln = parseDec(toksText, i, e1)
    i = e1 + 1
    let e2 = fieldEnd(toksText, i, end)
    let cl = parseDec(toksText, i, e2)
    i = e2 + 1
    let e3 = fieldEnd(toksText, i, end)
    let kind = unesc(toksText, i, e3)
    i = e3 + 1
    let e4 = fieldEnd(toksText, i, end)
    let text = unesc(toksText, i, e4)
    var attrName = ""
    var attrArgs = ""
    if kind == "attr" {
        i = e4 + 1
        let e5 = fieldEnd(toksText, i, end)
        attrName = unesc(toksText, i, e5)
        i = e5 + 1
        let e6 = fieldEnd(toksText, i, end)
        attrArgs = unesc(toksText, i, e6)
    }
    return Token { kind: kind, text: text, line: ln, col: cl, attrName: attrName, attrArgs: attrArgs }
}

// --- charsets (chapter 1 naming, checked at the declarations that bind) ---

// isCamel is the identifier charset with a lowercase first byte — the
// variable, function, and method convention (E0012).
fn isCamel(s: String) -> Bool {
    let n = s.byteLength()
    if n == 0 {
        return false
    }
    let c0 = lexnum.byteAt(s, 0)
    if c0 < 97 || c0 > 122 {
        return false
    }
    var i: Int64 = 1
    while i < n {
        let c = lexnum.byteAt(s, i)
        if (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) {
            i = i + 1
        } else {
            return false
        }
    }
    return true
}

// isModuleSeg is the module-path charset: lowercase, then lowercase and
// digits (E0013).
fn isModuleSeg(s: String) -> Bool {
    let n = s.byteLength()
    if n == 0 {
        return false
    }
    let c0 = lexnum.byteAt(s, 0)
    if c0 < 97 || c0 > 122 {
        return false
    }
    var i: Int64 = 1
    while i < n {
        let c = lexnum.byteAt(s, i)
        if (c >= 97 && c <= 122) || (c >= 48 && c <= 57) {
            i = i + 1
        } else {
            return false
        }
    }
    return true
}

// isPascal is the type-name convention: a first byte in A-Z — the whole
// rule, exactly as the reference writes it (E0011 rides the type
// declarations).
fn isPascal(s: String) -> Bool {
    if s.byteLength() == 0 {
        return false
    }
    let c0 = lexnum.byteAt(s, 0)
    return c0 >= 65 && c0 <= 90
}

// isKw is the keyword test: kind keyword plus the word itself.
fn isKw(t: Token, word: String) -> Bool {
    return t.kind == "keyword" && t.text == word
}

// hasPrefix reports whether s begins with the bytes of pre.
fn hasPrefix(s: String, pre: String) -> Bool {
    let n = pre.byteLength()
    if s.byteLength() < n {
        return false
    }
    return s.byteSlice(0, n) == pre
}

// stmtReservedWord is the statement dispatch's closed rejection list —
// every keyword that names a production of its own elsewhere and so fits
// no statement production here (the reference's own switch case list).
fn stmtReservedWord(w: String) -> Bool {
    return w == "pub" || w == "import" || w == "as" || w == "mut" || w == "else" || w == "in" ||
        w == "where" || w == "derives" || w == "with" || w == "resource" || w == "effect" ||
        w == "case" || w == "timeout" || w == "collectAll" || w == "record" || w == "byval" ||
        w == "byres" || w == "newtype" || w == "type" || w == "interface" || w == "impl" || w == "test"
}

// b01 renders a bool as the 0/1 field spelling.
fn b01(v: Bool) -> String {
    if v {
        return "1"
    }
    return "0"
}

// i64 renders a decimal scalar field.
fn i64(v: Int64) -> String {
    return lexnum.int64ToString(v)
}

// namesLineOf looks one name up in an encoded name list and answers its
// declaration line, -1 when absent. Not 0: a top-level tuple binding
// declares the empty name at line 0, and the reference's existence check
// (map membership) still finds it — the second such binding is E0404
// quoting line 0.
fn namesLineOf(names: String, name: String) -> Int64 {
    let n = names.byteLength()
    var i: Int64 = 0
    while i < n {
        var sp = i
        while sp < n && lexnum.byteAt(names, sp) != 32 {
            sp = sp + 1
        }
        var nl = sp
        while nl < n && lexnum.byteAt(names, nl) != 10 {
            nl = nl + 1
        }
        if names.byteSlice(i, sp) == name {
            return parseDec(names, sp + 1, nl)
        }
        i = nl + 1
    }
    return -1
}

// nameListHas reports whether a "\n"-separated name list carries name as one
// whole line (names hold no spaces or newlines, so the line IS the name).
fn nameListHas(list: String, name: String) -> Bool {
    let n = list.byteLength()
    var i: Int64 = 0
    while i < n {
        let e = lineEndAt(list, i)
        if list.byteSlice(i, e) == name {
            return true
        }
        i = e + 1
    }
    return false
}

// nameListLen counts a "\n"-separated name list's elements.
fn nameListLen(list: String) -> Int64 {
    let n = list.byteLength()
    var cnt: Int64 = 0
    var i: Int64 = 0
    while i < n {
        if lexnum.byteAt(list, i) == 10 {
            cnt = cnt + 1
        }
        i = i + 1
    }
    return cnt
}

// firstOnlyOf names the first element of a absent from b — the or-name law's
// report names one differing name per side.
fn firstOnlyOf(a: String, b: String) -> String {
    let n = a.byteLength()
    var i: Int64 = 0
    while i < n {
        let e = lineEndAt(a, i)
        let nm = a.byteSlice(i, e)
        if nameListHas(b, nm) == false {
            return nm
        }
        i = e + 1
    }
    return ""
}

// namesAllOf reduces one branch's binds encoding to its ordered name list
// (one name per line): the or-marker is stripped, because the name-set law
// counts bindings inside nested or-branches too (the duplicate-name walk is
// the one that skips them).
fn namesAllOf(seg: String) -> String {
    let n = seg.byteLength()
    var out = ""
    var i: Int64 = 0
    while i < n {
        let e = lineEndAt(seg, i)
        var s = i
        if s < e && lexnum.byteAt(seg, s) == 0x21 {
            s = s + 1
        }
        var sp = s
        while sp < e && lexnum.byteAt(seg, sp) != 32 {
            sp = sp + 1
        }
        out = out + seg.byteSlice(s, sp) + "\n"
        i = e + 1
    }
    return out
}

// markBinds prefixes every line of a binds encoding with the or-marker: the
// duplicate-name walk skips marked lines (a branch set is the or-name law's
// business, not a duplicate). Marking is idempotent — an or nested in
// another or's branch atom already carries its marks, and a second would
// corrupt the name the or-name law extracts.
fn markBinds(binds: String) -> String {
    let n = binds.byteLength()
    var out = ""
    var i: Int64 = 0
    while i < n {
        let e = lineEndAt(binds, i)
        if i < e && lexnum.byteAt(binds, i) == 0x21 {
            out = out + binds.byteSlice(i, e + 1)
        } else {
            out = out + "!" + binds.byteSlice(i, e + 1)
        }
        i = e + 1
    }
    return out
}

// segAt extracts the idx-th ";;\n"-separated segment — the per-branch binds
// of an or-pattern (binds lines never contain a semicolon, so the separator
// cannot collide).
fn segAt(segs: String, idx: Int64) -> String {
    let n = segs.byteLength()
    var start: Int64 = 0
    var k: Int64 = 0
    var i: Int64 = 0
    while i < n {
        if i + 2 < n && lexnum.byteAt(segs, i) == 0x3B && lexnum.byteAt(segs, i + 1) == 0x3B && lexnum.byteAt(segs, i + 2) == 10 {
            if k == idx {
                return segs.byteSlice(start, i)
            }
            k = k + 1
            start = i + 3
            i = start
            continue
        }
        i = i + 1
    }
    if k == idx {
        return segs.byteSlice(start, n)
    }
    return ""
}

// hasHole reports whether a string literal's raw text carries an
// interpolation opener — the hole face is T5's, so such literals latch
// pending instead of mis-parsing.
fn hasHole(text: String) -> Bool {
    let n = text.byteLength()
    var i: Int64 = 0
    while i + 1 < n {
        if lexnum.byteAt(text, i) == 0x24 && lexnum.byteAt(text, i + 1) == 0x7B {
            return true
        }
        i = i + 1
    }
    return false
}

// typeRefMsg is the one type-reference remediation message; the token
// text rides it quoted.
fn typeRefMsg(text: String) -> String {
    return "unexpected token — " + lexnum.quoteText(text) + " fits no type reference production: type references are Name, module.Name, Name<T…>, (T1, …, Tn), (), Dyn<I>, and fn(…) -> T"
}

// closedEscapeByte answers the byte one closed-set escape decodes to —
// the escape face the lexer ratified (B3b T4) — or the empty string when
// the byte names no escape (every decode is exactly one byte, so the
// empty string is an unambiguous refusal).
fn closedEscapeByte(e: Int64) -> String {
    if e == 110 {
        return "\n"
    }
    if e == 116 {
        return "\t"
    }
    if e == 114 {
        return "\r"
    }
    if e == 48 {
        return "\0"
    }
    if e == 92 {
        return "\\"
    }
    if e == 34 {
        return "\""
    }
    if e == 39 {
        return "'"
    }
    return ""
}

// descText decodes a string token's text the way the reference's foreign
// ABI comparison does — the faithful closed-set port: the entry and exit
// quotes verified, the seven single-byte escapes and \u{h..} decoded, and
// any shape outside the decode (a dangling backslash, an unknown escape,
// an interpolation opener) refusing with the whole inner text, which can
// only compare unequal against the one accepted ABI — exactly as the
// reference's refusal to decode answers unequal.
fn descText(text: String) -> String {
    let n = text.byteLength()
    if n < 2 {
        return text
    }
    if lexnum.byteAt(text, 0) != 34 || lexnum.byteAt(text, n - 1) != 34 {
        return text
    }
    let inner = text.byteSlice(1, n - 1)
    let m = inner.byteLength()
    var out = ""
    var i: Int64 = 0
    while i < m {
        let b = lexnum.byteAt(inner, i)
        if b != 0x5C {
            if b == 0x24 && i + 1 < m && lexnum.byteAt(inner, i + 1) == 0x7B {
                return inner
            }
            out = out + inner.byteSlice(i, i + 1)
            i = i + 1
            continue
        }
        if i + 1 >= m {
            return inner
        }
        let e = lexnum.byteAt(inner, i + 1)
        if e == 117 {
            let (r, end, ok) = parseUEscape(inner, i + 1)
            if ok == false || validRune(r) == false {
                return inner
            }
            out = out + runeText(r)
            i = end + 1
            continue
        }
        let d = closedEscapeByte(e)
        if d == "" {
            return inner
        }
        out = out + d
        i = i + 2
    }
    return out
}

// parseUEscape decodes the u{h..} clause at s[i] (the u itself, one to six
// hex digits inside braces, the rune domain the reference enforces). It
// answers the rune, the closing brace's offset, and whether the clause
// decoded; the lexer has already refused every malformed escape in a green
// token, so a miss is the unreachable defensive branch.
fn parseUEscape(s: String, i: Int64) -> (Int64, Int64, Bool) {
    let n = s.byteLength()
    if i + 1 >= n {
        return (0, i, false)
    }
    if lexnum.byteAt(s, i + 1) != 123 {
        return (0, i, false)
    }
    var v: Int64 = 0
    var k = i + 2
    var digits: Int64 = 0
    while k < n {
        let d = hexDigitVal(lexnum.byteAt(s, k))
        if d < 0 {
            break
        }
        v = v * 16 + d
        digits = digits + 1
        k = k + 1
    }
    if digits < 1 || digits > 6 {
        return (0, i, false)
    }
    if k >= n {
        return (0, i, false)
    }
    if lexnum.byteAt(s, k) != 125 {
        return (0, i, false)
    }
    if validRune(v) == false {
        return (0, i, false)
    }
    return (v, k, true)
}

// hexDigitVal is one hex digit's value or -1 — unlike lexnum's hexVal it
// owns the full domain, because here the caller has NOT already checked
// the digit class.
fn hexDigitVal(b: Int64) -> Int64 {
    if b >= 48 && b <= 57 {
        return b - 48
    }
    if b >= 97 && b <= 102 {
        return b - 97 + 10
    }
    if b >= 65 && b <= 70 {
        return b - 65 + 10
    }
    return 0 - 1
}

// validRune is the \u{h..} domain: at most U+10FFFF, never a surrogate.
fn validRune(v: Int64) -> Bool {
    if v > 0x10FFFF {
        return false
    }
    if v >= 0xD800 && v <= 0xDFFF {
        return false
    }
    return true
}

// runeText renders one rune's UTF-8 bytes by arithmetic — the language has
// no shift or mask, so the low six bits come off as remainder and the
// carry moves by division. The one-byte printable range has no producer
// in lexnum (the probe tables never leak plain ASCII), so it carries its
// own run table; every other byte is exactly the ranges byteChar names.
fn runeText(r: Int64) -> String {
    if r < 0x80 {
        if r >= 0x21 && r <= 0x7E {
            let ascii = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
            return ascii.byteSlice(r - 0x20, r - 0x20 + 1)
        }
        return lexnum.byteChar(r)
    }
    if r < 0x800 {
        let b2 = 128 + r % 64
        let x = r / 64
        return lexnum.byteChar(192 + x) + lexnum.byteChar(b2)
    }
    if r < 0x10000 {
        let b3 = 128 + r % 64
        var x = r / 64
        let b2 = 128 + x % 64
        x = x / 64
        return lexnum.byteChar(224 + x) + lexnum.byteChar(b2) + lexnum.byteChar(b3)
    }
    let b4 = 128 + r % 64
    var x = r / 64
    let b3 = 128 + x % 64
    x = x / 64
    let b2 = 128 + x % 64
    x = x / 64
    return lexnum.byteChar(240 + x) + lexnum.byteChar(b2) + lexnum.byteChar(b3) + lexnum.byteChar(b4)
}

impl Parser {
    // fail latches the first diagnostic; later calls are no-ops, which is
    // the port's equivalent of Go's panic already having unwound.
    pub fn fail(mut self, line: Int64, col: Int64, code: String, message: String) {
        if self.failed == 0 {
            self.failed = 1
            self.errLine = line
            self.errCol = col
            self.errCode = code
            self.errMsg = message
        }
    }

    // failTok anchors the diagnostic at a token's own position.
    pub fn failTok(mut self, t: Token, code: String, message: String) {
        self.fail(t.line, t.col, code, message)
    }

    // bndLatch answers the NotImplemented face (the reference's one bnd
    // boundary, mut parameters) and, until their tasks land, the pending
    // faces — both are "this build does not implement the form yet".
    pub fn bndLatch(mut self, what: String) {
        if self.failed == 0 && self.bnd == 0 {
            self.bnd = 1
            self.bndWhat = what
        }
    }

    // stopped is the latch check every failure-capable caller makes.
    pub fn stopped(mut self) -> Bool {
        return self.failed != 0 || self.bnd != 0
    }

    // next consumes the current token: it becomes last, and the cursor
    // moves to the following T line. The reference's toks slice always
    // ends with a real eof token, so the walk only ever loads there or
    // before — the ground state past the end is a guard the parse faces
    // never reach (they check atEnd first, as the reference does).
    pub fn next(mut self) {
        self.last = self.cur
        self.pos = lineEndAt(self.toksText, self.pos) + 1
        self.cur = tokAt(self.toksText, self.pos)
    }

    // peek is the token after the current one.
    pub fn peek(mut self) -> Token {
        return tokAt(self.toksText, lineEndAt(self.toksText, self.pos) + 1)
    }

    // atEnd reports whether the cursor sits at the eof token.
    pub fn atEnd(mut self) -> Bool {
        return self.cur.kind == "eof"
    }

    // brokeLine reports whether the current token starts a new line
    // relative to the last consumed one — the depth-zero statement
    // boundary fact, the reference's own comparison.
    pub fn brokeLine(mut self) -> Bool {
        return self.cur.line > self.last.line
    }

    // checkCamel enforces E0012 at a binding token.
    pub fn checkCamel(mut self, t: Token) {
        if isCamel(t.text) == false {
            self.failTok(t, "E0012",
                "variable, function, and method names must be camelCase — " + lexnum.quoteText(t.text) + " is not camelCase")
        }
    }

    // checkPascal enforces E0011 at a type-name token.
    pub fn checkPascal(mut self, t: Token) {
        if isPascal(t.text) == false {
            self.failTok(t, "E0011",
                "type name must be PascalCase — " + lexnum.quoteText(t.text) + " is not PascalCase")
        }
    }

    // tupleArity enforces E0602 at a tuple's opening parenthesis, shared by
    // the type and expression tuple productions; the noun names which one.
    pub fn tupleArity(mut self, open: Token, n: Int64, noun: String) {
        if n > 8 {
            self.failTok(open, "E0602",
                "tuple arity above eight — the tuple " + noun + " has " + i64(n) + " elements; the arity bound forces naming: the longer the tuple, the more it wants to be a record")
        }
    }

    // dupCheck rejects a name the module name space already holds; the
    // collision (E0404) outranks the naming convention at the same token,
    // so the callers that run both check this one first.
    pub fn dupCheck(mut self, t: Token) {
        let prev = namesLineOf(self.namesText, t.text)
        if prev >= 0 {
            self.failTok(t, "E0404",
                "duplicate name in one module — " + lexnum.quoteText(t.text) + " is already declared at line " + i64(prev) + "; one module has one name space")
        }
    }

    // declare enters a name into the module name space (dupCheck first —
    // the later of two colliding declarations is rejected).
    pub fn declare(mut self, name: String, line: Int64, col: Int64) {
        let t = Token { kind: "ident", text: name, line: line, col: col, attrName: "", attrArgs: "" }
        self.dupCheck(t)
        if self.stopped() == false {
            self.namesText = self.namesText + name + " " + i64(line) + "\n"
        }
    }

    // registerRaw enters a name with no collision check — the fn
    // declaration's own trailing registration, whose duplicate was
    // already rejected at the name token.
    pub fn registerRaw(mut self, name: String, line: Int64) {
        self.namesText = self.namesText + name + " " + i64(line) + "\n"
    }

    // checkStart enforces the closed statement-start class at an item or
    // statement position: a token outside it is E0102 naming the end of
    // the previous statement.
    pub fn checkStart(mut self, top: Bool) {
        let t = self.cur
        if t.kind == "attr" {
            if top {
                self.failTok(t, "E0105",
                    "unexpected token — " + lexnum.quoteText(t.text) + " fits no top-level item production: no attribute target is ratified yet")
            } else {
                self.failTok(t, "E0105",
                    "unexpected token — " + lexnum.quoteText(t.text) + " fits no statement production: no attribute target is ratified yet")
            }
            return
        }
        if t.kind == "ident" || t.kind == "int" || t.kind == "float" || t.kind == "string" || t.kind == "rune" || t.kind == "keyword" ||
            t.kind == "(" || t.kind == "{" || t.kind == "!" || t.kind == "-" || t.kind == "~" {
            return
        }
        if self.last.line == 0 {
            self.failTok(t, "E0102",
                "statement begins with a continuation token — " + lexnum.quoteText(t.text) + " cannot begin a statement; no statement precedes it")
            return
        }
        self.failTok(t, "E0102",
            "statement begins with a continuation token — " + lexnum.quoteText(t.text) + " cannot begin a statement; the previous statement ends at line " + i64(self.last.line))
    }

    // parseFile parses the module: top-level items separated by line
    // breaks. The documentation attachment pass is T6's face; a source
    // carrying /// units latches pending rather than attaching wrong.
    pub fn parseFile(mut self) {
        self.astText = "P file 0 0 " + i64(self.testModule) + "\n"
        while self.atEnd() == false {
            if self.stopped() {
                return
            }
            self.checkStart(true)
            if self.stopped() {
                return
            }
            self.parseItem()
            if self.stopped() {
                return
            }
            if self.atEnd() {
                break
            }
            if self.brokeLine() == false {
                self.failTok(self.cur, "E0105",
                    "unexpected token — " + lexnum.quoteText(self.cur.text) + " after a top-level item: items are separated by line breaks")
                return
            }
        }
        if self.stopped() == false && self.docsText != "" {
            self.bndLatch("WEC-PENDING docs")
        }
    }

    // parseItem dispatches one top-level item by its keyword; a non-item
    // statement that passed the start class is E0105 naming the item
    // productions. itemStarts records the item's start line for T6's
    // documentation attachment pass, exactly where the reference records
    // it. The test block is T4's face and latches pending.
    pub fn parseItem(mut self) {
        let t = self.cur
        self.itemStartsText = self.itemStartsText + i64(t.line) + " "
        if t.kind == "keyword" {
            if t.text == "import" {
                self.parseImport()
                return
            }
            if t.text == "pub" {
                self.parsePubItem(t)
                return
            }
            if t.text == "fn" {
                self.parseFnDecl(false, t.line, t.col)
                return
            }
            if t.text == "let" {
                self.parseTopLet(false, t.line, t.col)
                return
            }
            if t.text == "var" {
                self.failTok(t, "E0403",
                    "var at the top level — module-level mutable state does not exist; declare the top-level binding with let (var is legal inside blocks)")
                return
            }
            if t.text == "return" {
                self.failTok(t, "E0401",
                    "return outside a function body — no function context encloses this return; module-level logic belongs in a fn")
                return
            }
            if t.text == "byres" {
                self.next()
                if isKw(self.cur, "record") {
                    let fc = self.parseRecordDecl(false, "resource", false, t.line, t.col)
                    return
                }
                if self.atEnd() {
                    self.failTok(self.cur, "E0105", "unexpected end of file — byres prefixes a record declaration")
                    return
                }
                self.failTok(self.cur, "E0105",
                    "unexpected token — " + lexnum.quoteText(self.cur.text) + " after byres: byres prefixes record")
                return
            }
            if t.text == "byval" {
                let pk = self.peek()
                if isKw(pk, "type") {
                    self.next()
                    self.parseSumDecl(false, true, t.line, t.col)
                    return
                }
                if isKw(pk, "pub") {
                    self.failTok(pk, "E0105",
                        "unexpected token — \"pub\" after byval: the prefix order is pub, then byval, then the declaration")
                    return
                }
                if isKw(pk, "record") {
                    self.next()
                    let fc = self.parseRecordDecl(false, "value", false, t.line, t.col)
                    return
                }
                if pk.kind == "eof" {
                    self.failTok(pk, "E0105", "unexpected end of file — byval prefixes type or record")
                    return
                }
                self.failTok(pk, "E0105",
                    "unexpected token — " + lexnum.quoteText(pk.text) + " after byval: byval prefixes type or record; the prefix order is pub, then byval")
                return
            }
            if t.text == "effect" {
                self.parseEffectDecl(false, t.line, t.col)
                return
            }
            if t.text == "record" {
                let fc = self.parseRecordDecl(false, "gc", false, t.line, t.col)
                return
            }
            if t.text == "newtype" {
                self.parseNewtypeDecl(false, t.line, t.col)
                return
            }
            if t.text == "type" {
                self.parseSumDecl(false, false, t.line, t.col)
                return
            }
            if t.text == "interface" {
                self.parseInterfaceDecl(false, t.line, t.col)
                return
            }
            if t.text == "impl" {
                self.parseImplDecl(t.line, t.col)
                return
            }
            if t.text == "foreign" {
                self.parseForeignDecl(t.line, t.col)
                return
            }
            if t.text == "test" {
                self.parseTestDecl(t.line, t.col)
                return
            }
            if t.text == "mock" {
                self.failTok(t, "E1802",
                    "mock declaration outside a test block — a mock exists only as a direct item of a test block body; move it into the test block whose calls it should intercept")
                return
            }
        }
        self.failTok(t, "E0105",
            "unexpected token — " + lexnum.quoteText(t.text) + " fits no top-level item production: top-level items are import, fn, and let declarations (optionally pub); statements exist only inside blocks")
    }

    // parsePubItem dispatches behind a consumed pub prefix: the prefix
    // order is pub, then byval/byres, then the declaration; the wrong
    // order and the trailing forms carry their own E0105 messages.
    pub fn parsePubItem(mut self, t: Token) {
        self.next()
        if isKw(self.cur, "fn") {
            self.parseFnDecl(true, t.line, t.col)
            return
        }
        if isKw(self.cur, "let") {
            self.parseTopLet(true, t.line, t.col)
            return
        }
        if isKw(self.cur, "type") {
            self.parseSumDecl(true, false, t.line, t.col)
            return
        }
        if isKw(self.cur, "byval") {
            let bv = self.cur
            self.next()
            if isKw(self.cur, "type") {
                self.parseSumDecl(true, true, t.line, t.col)
                return
            }
            if isKw(self.cur, "record") {
                let fc = self.parseRecordDecl(true, "value", false, t.line, t.col)
                return
            }
            self.failTok(bv, "E0105",
                "unexpected token — byval prefixes type or record here; the prefix order is pub, then byval, then the declaration")
            return
        }
        if isKw(self.cur, "record") {
            let fc = self.parseRecordDecl(true, "gc", false, t.line, t.col)
            return
        }
        if isKw(self.cur, "newtype") {
            self.parseNewtypeDecl(true, t.line, t.col)
            return
        }
        if isKw(self.cur, "interface") {
            self.parseInterfaceDecl(true, t.line, t.col)
            return
        }
        if isKw(self.cur, "effect") {
            self.parseEffectDecl(true, t.line, t.col)
            return
        }
        if isKw(self.cur, "byres") {
            self.next()
            if isKw(self.cur, "record") {
                let fc = self.parseRecordDecl(true, "resource", false, t.line, t.col)
                return
            }
            if self.atEnd() {
                self.fail(t.line, t.col, "E0105", "unexpected end of file — pub byres prefixes a record declaration")
                return
            }
            self.failTok(self.cur, "E0105",
                "unexpected token — " + lexnum.quoteText(self.cur.text) + " after byres: byres prefixes record")
            return
        }
        if self.atEnd() {
            self.fail(t.line, t.col, "E0105", "unexpected end of file — pub prefixes a fn, let, type, chapter 8 declaration, or interface")
            return
        }
        self.failTok(self.cur, "E0105",
            "unexpected token — " + lexnum.quoteText(self.cur.text) + " after pub: pub prefixes fn, let, type, the chapter 8 declarations, and interface (an impl block carries no pub)")
    }

    // parseImport parses `import path [as alias]`; each path segment and
    // the alias obey the module charset (E0013), and the introduced name
    // joins the module name space. The Go original carries the segment
    // token in one var; a var here may hold only a scalar or a String
    // face, so the walk keeps the last segment's three fields in their
    // own vars instead — same facts, wider storage.
    pub fn parseImport(mut self) {
        let kw = self.cur
        self.next()
        let first = self.moduleSeg()
        if self.stopped() {
            return
        }
        var segText: String = first.text
        var segLine: Int64 = first.line
        var segCol: Int64 = first.col
        var pathText = " " + lexnum.esc(segText)
        // The path's anchor is the FIRST segment's position — bound here,
        // from a field read (a let off a bare local var would alias its
        // storage, not snapshot it — the #31 face; field reads are safe).
        let pathLine: Int64 = first.line
        let pathCol: Int64 = first.col
        while self.cur.kind == "." {
            self.next()
            let seg = self.moduleSeg()
            if self.stopped() {
                return
            }
            segText = seg.text
            segLine = seg.line
            segCol = seg.col
            pathText = pathText + " " + lexnum.esc(segText)
        }
        var alias = ""
        if isKw(self.cur, "as") {
            self.next()
            let al = self.moduleSeg()
            if self.stopped() {
                return
            }
            segText = al.text
            segLine = al.line
            segCol = al.col
            alias = segText
        }
        self.declare(segText, segLine, segCol)
        if self.stopped() {
            return
        }
        self.astText = self.astText + "P import " + i64(kw.line) + " " + i64(kw.col) + " " + lexnum.esc(alias) + " " + i64(pathLine) + " " + i64(pathCol) + pathText + "\n"
    }

    // moduleSeg expects one lowercase dotted-path segment. A keyword
    // token whose text passes the charset also serves: chapter 1's
    // reserved closure governs name positions, and a module path segment
    // is another lexical class — std.test must spell. The charset gate
    // (E0013) judges the text the same either way.
    pub fn moduleSeg(mut self) -> Token {
        let t = self.cur
        if t.kind != "ident" && t.kind != "keyword" {
            if t.kind == "eof" {
                self.failTok(t, "E0105", "unexpected end of file — an import wants a lowercase dotted path (and its alias after as)")
                return zeroTok()
            }
            self.failTok(t, "E0105",
                "unexpected token — " + lexnum.quoteText(t.text) + " in an import: imports are import path [as name]")
            return zeroTok()
        }
        if isModuleSeg(t.text) == false {
            self.failTok(t, "E0013",
                "module names must be lowercase — " + lexnum.quoteText(t.text) + " is not a lowercase dotted path segment")
            return zeroTok()
        }
        self.next()
        return t
    }

    // parseEffectDecl parses chapter 16's `effect name`: the name joins
    // the module's single name space (E0404), refuses the built-in tags
    // io/net/time (E1403), and obeys camelCase (E0012) — a collision
    // outranks the built-in conflict, which outranks the convention.
    pub fn parseEffectDecl(mut self, isPub: Bool, line: Int64, col: Int64) {
        self.next()
        let nt = self.cur
        if nt.kind != "ident" {
            if self.atEnd() {
                self.failTok(nt, "E0105", "unexpected end of file — an effect declaration is effect name")
                return
            }
            self.failTok(nt, "E0105",
                "unexpected token — " + lexnum.quoteText(nt.text) + " where an effect declaration names its name")
            return
        }
        self.dupCheck(nt)
        if self.stopped() {
            return
        }
        if nt.text == "io" || nt.text == "net" || nt.text == "time" {
            self.failTok(nt, "E1403",
                "effect name conflicts with a built-in effect — " + lexnum.quoteText(nt.text) + " is one of the built-in tags (io, net, time), language-level names no module item may take; choose a camelCase name that is not one of the built-in tags")
            return
        }
        if isCamel(nt.text) == false {
            self.failTok(nt, "E0012",
                "effect names must be camelCase — " + lexnum.quoteText(nt.text) + " is not camelCase")
            return
        }
        self.namesText = self.namesText + nt.text + " " + i64(nt.line) + "\n"
        self.next()
        self.astText = self.astText + "P effect " + i64(line) + " " + i64(col) + " " + b01(isPub) + " " + lexnum.esc(nt.text) + " " + i64(nt.line) + " " + i64(nt.col) + "\n"
    }

    // parseEffectSegment parses the fn declaration's effect segment: the
    // effect keyword (the caller verified it) followed by one or more
    // effect tags, bare or qualified. The tags ride the P fn line as
    // space-joined fields, so this answers the joined spelling. The
    // foreign fn's segment is REQUIRED, so inside a foreign block a
    // non-identifier token is not an error here — the foreign item's own
    // E1703 check reports it, and the bare claim (empty tags, the effect
    // keyword's own position) answers for a trailing segment.
    pub fn parseEffectSegment(mut self, inForeign: Bool) -> (String, Int64, Int64) {
        self.next()
        let t = self.cur
        if t.kind != "ident" {
            if inForeign {
                return ("", self.last.line, self.last.col)
            }
            if self.atEnd() {
                self.failTok(t, "E0105", "unexpected end of file — an effect segment names at least one effect")
                return ("", 0, 0)
            }
            self.failTok(t, "E0105",
                "unexpected token — " + lexnum.quoteText(t.text) + " where an effect segment names at least one effect")
            return ("", 0, 0)
        }
        let line = t.line
        let col = t.col
        let tags = self.effectTagList()
        return (tags, line, col)
    }

    // effectTagList parses the tags of an effect segment: one or more,
    // each the bare name or the qualified module.name, the dot
    // continuation holding only within one line.
    pub fn effectTagList(mut self) -> String {
        var tags = ""
        while self.cur.kind == "ident" {
            let t = self.cur
            self.next()
            var name = t.text
            if self.cur.kind == "." && self.cur.line == t.line {
                let dot = self.cur
                self.next()
                let nt = self.cur
                if nt.kind != "ident" || nt.line != dot.line {
                    if self.atEnd() {
                        self.failTok(nt, "E0105", "unexpected end of file — a qualified effect tag is module.name")
                        return ""
                    }
                    self.failTok(nt, "E0105",
                        "unexpected token — " + lexnum.quoteText(nt.text) + " where a qualified effect tag names its effect: a tag is name or module.name")
                    return ""
                }
                name = name + "." + nt.text
                self.next()
            }
            if tags == "" {
                tags = name
            } else {
                tags = tags + " " + name
            }
        }
        return tags
    }

    // parseFnDecl parses `[pub] fn name<T…>(params) [effect tags] [-> type]
    // [where …] block`. The body block is the one block face T2 owns —
    // empty; anything inside it is T4's.
    pub fn parseFnDecl(mut self, isPub: Bool, line: Int64, col: Int64) {
        self.next()
        let t = self.cur
        if t.kind != "ident" {
            self.failTok(t, "E0105",
                "unexpected token — " + lexnum.quoteText(t.text) + " where a fn name goes: a fn declaration is fn name(params) [-> type] { body }")
            return
        }
        self.dupCheck(t)
        if self.stopped() {
            return
        }
        self.checkCamel(t)
        if self.stopped() {
            return
        }
        let name = t.text
        let nameLine = t.line
        let nameCol = t.col
        self.next()
        var tpsText = ""
        if self.cur.kind == "<" {
            tpsText = self.typeParamsText()
            if self.stopped() {
                return
            }
        }
        if self.cur.kind != "(" {
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — a fn wants its parameter list")
                return
            }
            self.failTok(self.cur, "E0105",
                "unexpected token — " + lexnum.quoteText(self.cur.text) + " where a fn's parameter list opens")
            return
        }
        let paramsText = self.annotatedParams()
        if self.stopped() {
            return
        }
        var effectTags = ""
        var effectLine: Int64 = 0
        var effectCol: Int64 = 0
        if isKw(self.cur, "effect") {
            let (tags, el, ec) = self.parseEffectSegment(false)
            effectTags = tags
            effectLine = el
            effectCol = ec
            if self.stopped() {
                return
            }
        }
        var retText = "-\n"
        var hasRet: Int64 = 0
        if self.cur.kind == "->" {
            self.next()
            retText = self.typeRefText()
            hasRet = 1
            if self.stopped() {
                return
            }
        }
        var whereT = ""
        if isKw(self.cur, "where") && self.brokeLine() == false {
            whereT = self.whereText()
            if self.stopped() {
                return
            }
        }
        if self.cur.kind != "{" {
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — a fn wants its body block")
                return
            }
            self.failTok(self.cur, "E0105",
                "unexpected token — " + lexnum.quoteText(self.cur.text) + " where a fn body block opens")
            return
        }
        let bodyText = self.fnBlock(name, hasRet)
        if self.stopped() {
            return
        }
        // The header carries the receiver field between the name and the
        // effect tags (empty on a plain fn — the adjacent-space spelling:
        // one space ends the name field, the second is the empty field).
        var head = "P fn " + i64(line) + " " + i64(col) + " " + b01(isPub) + " " + lexnum.esc(name) + "  "
        if effectTags != "" {
            head = head + effectTags + " "
        }
        head = head + i64(effectLine) + " " + i64(effectCol) + " 0 " + i64(nameLine) + " " + i64(nameCol) + "\n"
        self.astText = self.astText + head + tpsText + paramsText + retText + whereT + bodyText
        self.registerRaw(name, nameLine)
    }

    // annotatedParams parses the annotated parameter entries of an open
    // parameter list — everything after its leading ( through the closing
    // ) — rendering each parameter's P lines as it goes. The one bnd
    // boundary of the whole reference lives in the loop: a mut parameter.
    pub fn annotatedParams(mut self) -> String {
        self.next()
        return self.paramsLoop()
    }

    // paramsLoop is annotatedParams' loop alone — the receiver-parameter
    // list consumes its receiver entry first, then hands the remaining
    // entries (leading comma already consumed) to the same loop.
    pub fn paramsLoop(mut self) -> String {
        var out = ""
        while true {
            if self.cur.kind == ")" {
                self.next()
                return out
            }
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — a parameter list closes with )")
                return ""
            }
            let nt = self.cur
            if isKw(nt, "mut") {
                self.bndLatch("mut parameters")
                return ""
            }
            if nt.kind != "ident" {
                self.failTok(nt, "E0105",
                    "unexpected token — " + lexnum.quoteText(nt.text) + " in a parameter list: parameters are name: type pairs")
                return ""
            }
            self.next()
            if self.cur.kind != ":" {
                self.failTok(nt, "E0105",
                    "unexpected token — parameter " + lexnum.quoteText(nt.text) + " carries no annotation: parameters are name: type; parameter types are never inferred")
                return ""
            }
            self.checkCamel(nt)
            if self.stopped() {
                return ""
            }
            self.next()
            let ty = self.typeRefText()
            if self.stopped() {
                return ""
            }
            out = out + "P param 0 0 " + lexnum.esc(nt.text) + " " + i64(nt.line) + " " + i64(nt.col) + "\n" + ty
            if self.cur.kind == "," {
                self.next()
                continue
            }
            if self.cur.kind == ")" {
                self.next()
                return out
            }
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — a parameter list closes with )")
                return ""
            }
            self.failTok(self.cur, "E0105",
                "unexpected token — " + lexnum.quoteText(self.cur.text) + " in a parameter list: parameters are name: type pairs")
            return ""
        }
        return out
    }

    // fnBlock parses a function body's top-level block: the fn context
    // goes on the stack, the loop depth resets (a fn body starts no loop),
    // and the block runs at direct — the one level where defer is a legal
    // item.
    pub fn fnBlock(mut self, name: String, hasRet: Int64) -> String {
        let savedLoop = self.loopDepth
        let savedDirect = self.direct
        self.loopDepth = 0
        self.direct = 1
        let (out, n) = self.blockLoopText(1, name + ";" + i64(hasRet) + ";0")
        self.loopDepth = savedLoop
        self.direct = savedDirect
        return out
    }

    // blockLoopText is the shared `{ items }` loop (the reference's block):
    // it consumes the opening brace itself, runs at the given direct flag,
    // pushes the fn context line when one is given (the fn body's own and
    // the defer body's no-return context), applies the mock depth law
    // (a pending 1 marks this block as the test body's own — its items run
    // at 2, the one depth where mock is legal; every nested block runs at
    // 0), and enforces the statement separation law. It answers the block's
    // P lines and its item count (the else-fold probe reads the count).
    pub fn blockLoopText(mut self, direct: Int64, fctxLine: String) -> (String, Int64) {
        let open = self.cur
        self.next()
        if fctxLine != "" {
            self.fnsText = self.fnsText + fctxLine + "\n"
        }
        let savedDirect = self.direct
        self.direct = direct
        let savedTest = self.inTestBody
        if savedTest == 1 {
            self.inTestBody = 2
        } else {
            self.inTestBody = 0
        }
        var out = "P block " + i64(open.line) + " " + i64(open.col) + "\n"
        var count: Int64 = 0
        while true {
            if self.cur.kind == "}" {
                self.next()
                self.direct = savedDirect
                self.inTestBody = savedTest
                if fctxLine != "" {
                    self.popFn()
                }
                return (out, count)
            }
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — a block wants its closing }")
                return ("", 0)
            }
            self.checkStart(false)
            if self.stopped() {
                return ("", 0)
            }
            out = out + self.stmtText()
            if self.stopped() {
                return ("", 0)
            }
            count = count + 1
            if self.cur.kind == "}" {
                self.next()
                self.direct = savedDirect
                self.inTestBody = savedTest
                if fctxLine != "" {
                    self.popFn()
                }
                return (out, count)
            }
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — a block wants its closing }")
                return ("", 0)
            }
            if self.brokeLine() == false {
                self.failTok(self.cur, "E0105",
                    "unexpected token — " + lexnum.quoteText(self.cur.text) + " after a complete statement: a statement ends at its line break; only } or a new statement follows")
                return ("", 0)
            }
        }
        return (out, count)
    }

    // popFn drops the innermost fn context (the encoded stack's tail).
    pub fn popFn(mut self) {
        let n = self.fnsText.byteLength()
        var i = n - 2
        while i >= 0 {
            if lexnum.byteAt(self.fnsText, i) == 10 {
                break
            }
            i = i - 1
        }
        self.fnsText = self.fnsText.byteSlice(0, i + 1)
    }

    // fnsTopStart finds the start offset of the fn stack's top line.
    pub fn fnsTopStart(mut self) -> Int64 {
        let n = self.fnsText.byteLength()
        var i = n - 2
        while i >= 0 {
            if lexnum.byteAt(self.fnsText, i) == 10 {
                break
            }
            i = i - 1
        }
        return i + 1
    }

    // fnsTopFlag reads the hasRet (idx 0) or deferBody (idx 1) flag of the
    // top fn context — the `name;hasRet;deferBody` line's fields.
    pub fn fnsTopFlag(mut self, idx: Int64) -> Int64 {
        let st = self.fnsTopStart()
        let n = self.fnsText.byteLength()
        var j = st
        var semi: Int64 = 0
        while j < n {
            let c = lexnum.byteAt(self.fnsText, j)
            if c == 59 {
                if semi == idx {
                    if j + 1 < n && lexnum.byteAt(self.fnsText, j + 1) == 49 {
                        return 1
                    }
                    return 0
                }
                semi = semi + 1
            }
            if c == 10 {
                return 0
            }
            j = j + 1
        }
        return 0
    }

    // fnsTopName reads the top fn context's name (up to its first ;).
    pub fn fnsTopName(mut self) -> String {
        let st = self.fnsTopStart()
        let n = self.fnsText.byteLength()
        var j = st
        while j < n {
            let c = lexnum.byteAt(self.fnsText, j)
            if c == 59 || c == 10 {
                break
            }
            j = j + 1
        }
        return self.fnsText.byteSlice(st, j)
    }

    // tokAhead reads the token n positions past the cursor without
    // consuming — the statement head probes (self.field =, the assignment
    // =) walk it read-only; a position past the last T line answers the
    // eof-shaped ground state, so a probe there simply fails to match.
    pub fn tokAhead(mut self, n: Int64) -> Token {
        var p = self.pos
        var i: Int64 = 0
        while i < n {
            p = lineEndAt(self.toksText, p) + 1
            i = i + 1
        }
        return tokAt(self.toksText, p)
    }

    // headExprText parses a control-flow head (a condition or scrutinee):
    // a value expression with the postfix `{` suspended — the brace that
    // follows a head opens the body, never a construction.
    pub fn headExprText(mut self) -> String {
        self.noBrace = self.noBrace + 1
        let savedValue = self.exprValue
        self.exprValue = 1
        let e = self.exprText()
        self.exprValue = savedValue
        self.noBrace = self.noBrace - 1
        return e
    }

    // stmtText dispatches one statement by keyword (the reference's parseStmt):
    // the reserved closure rejects its own list, the self.field and
    // plain-name assignment probes read the token stream ahead, and
    // everything else in the start class is an expression statement.
    pub fn stmtText(mut self) -> String {
        let t = self.cur
        if t.kind == "keyword" {
            let w = t.text
            if w == "let" || w == "var" {
                let (body, nm, nl, nc) = self.parseBinding()
                if self.stopped() {
                    return ""
                }
                return body
            }
            if w == "return" {
                return self.returnText()
            }
            if w == "while" {
                return self.whileText()
            }
            if w == "loop" {
                return self.loopText()
            }
            if w == "break" || w == "continue" {
                return self.breakContText()
            }
            if w == "defer" {
                return self.deferText()
            }
            if w == "for" {
                return self.forText()
            }
            if w == "scope" {
                // chapter 13's resource form stays a statement of its own;
                // chapter 18's compound forms are expressions and wrap in
                // an expression statement below.
                if isKw(self.peek(), "resource") {
                    return self.scopeResText()
                }
            } else {
                if w == "mock" {
                    if self.inTestBody == 2 {
                        return self.mockDeclText()
                    }
                    self.failTok(t, "E1802",
                        "mock declaration outside a test block — a mock exists only as a direct item of a test block body; move it into the test block whose calls it should intercept")
                    return ""
                }
                if w == "foreign" {
                    // chapter 19's own position rule, its own code: the
                    // boundary is declared per module, and a block below
                    // the top level fits no statement production's intent
                    // either way (E1702 over the generic E0105).
                    self.failTok(t, "E1702",
                        "foreign block outside the top level — the boundary is declared per module, not per expression")
                    return ""
                }
                if stmtReservedWord(w) {
                    self.failTok(t, "E0105",
                        "unexpected token — " + lexnum.quoteText(w) + " fits no statement production: statements are let|var bindings, name assignments, return, chapter 3's control statements, and expression statements")
                    return ""
                }
            }
            // if/match/fn/true/false/task/select: keyword-led expression
            // forms wrap in an expression statement (chapter 2).
        }
        // `self.field = expr` — chapter 10's one field-write form, probed
        // at the token level ahead of the plain-name assignment below.
        if t.kind == "ident" && t.text == "self" {
            let t1 = self.tokAhead(1)
            let t2 = self.tokAhead(2)
            let t3 = self.tokAhead(3)
            if t1.kind == "." && t2.kind == "ident" && t3.kind == "=" && t3.line == t.line {
                self.next()
                self.next()
                let ft = self.cur
                self.next()
                let op = self.cur
                self.next()
                let savedValue = self.exprValue
                self.exprValue = 1
                let v = self.exprText()
                self.exprValue = savedValue
                if self.stopped() {
                    return ""
                }
                return "P assign " + i64(t.line) + " " + i64(t.col) + " self " + lexnum.esc(ft.text) + " " + i64(op.line) + " " + i64(op.col) + "\n" + v
            }
        }
        if t.kind == "ident" {
            let pk = self.peek()
            if pk.kind == "=" && pk.line == t.line {
                self.next()
                let op = self.cur
                self.next()
                let savedValue = self.exprValue
                self.exprValue = 1
                let v = self.exprText()
                self.exprValue = savedValue
                if self.stopped() {
                    return ""
                }
                // the empty field slot spells the adjacent-space pair
                return "P assign " + i64(t.line) + " " + i64(t.col) + " " + lexnum.esc(t.text) + "  " + i64(op.line) + " " + i64(op.col) + "\n" + v
            }
        }
        let savedValue = self.exprValue
        self.exprValue = 0
        let e = self.exprText()
        self.exprValue = savedValue
        if self.stopped() {
            return ""
        }
        return "P exprstmt " + i64(t.line) + " " + i64(t.col) + "\n" + e
    }

    // returnText parses `return` / `return expr`. Outside any fn body it
    // is E0401; a value where the fn declares none is E0402 (a bare return
    // in a fn with a declared type parses — exhaustiveness is the types
    // stage's).
    pub fn returnText(mut self) -> String {
        let t = self.cur
        self.next()
        var hasValue: Int64 = 1
        if self.atEnd() {
            hasValue = 0
        } else {
            if self.cur.kind == "}" {
                hasValue = 0
            } else {
                if self.depth == 0 && self.brokeLine() {
                    hasValue = 0
                }
            }
        }
        if self.fnsText == "" {
            self.failTok(t, "E0401",
                "return outside a function body — no function context encloses this return; a defer body runs at function exit and carries no return of its own")
            return ""
        }
        if self.fnsTopFlag(1) == 1 {
            self.failTok(t, "E0401",
                "return outside a function body — no function context encloses this return; a defer body runs at function exit and carries no return of its own")
            return ""
        }
        if hasValue == 1 && self.fnsTopFlag(0) == 0 {
            self.failTok(t, "E0402",
                "return with a value in a function that declares none — " + lexnum.quoteText(self.fnsTopName()) + " declares no return type; bare return exits a valueless function legally")
            return ""
        }
        if hasValue == 1 {
            let savedValue = self.exprValue
            self.exprValue = 1
            let v = self.exprText()
            self.exprValue = savedValue
            if self.stopped() {
                return ""
            }
            return "P return " + i64(t.line) + " " + i64(t.col) + " 1\n" + v
        }
        return "P return " + i64(t.line) + " " + i64(t.col) + " 0\n-\n"
    }

    // whileText parses `while cond block`; the body is a loop body for the
    // break/continue depth.
    pub fn whileText(mut self) -> String {
        let t = self.cur
        self.next()
        let cond = self.headExprText()
        if self.stopped() {
            return ""
        }
        if self.cur.kind != "{" {
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — a while wants its body block")
                return ""
            }
            self.failTok(self.cur, "E0105",
                "unexpected token — " + lexnum.quoteText(self.cur.text) + " where a while body block opens")
            return ""
        }
        let saved = self.loopDepth
        self.loopDepth = saved + 1
        let (body, n) = self.blockLoopText(0, "")
        self.loopDepth = saved
        if self.stopped() {
            return ""
        }
        return "P while " + i64(t.line) + " " + i64(t.col) + "\n" + cond + body
    }

    // loopText parses `loop block`.
    pub fn loopText(mut self) -> String {
        let t = self.cur
        self.next()
        if self.cur.kind != "{" {
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — a loop wants its body block")
                return ""
            }
            self.failTok(self.cur, "E0105",
                "unexpected token — " + lexnum.quoteText(self.cur.text) + " where a loop body block opens")
            return ""
        }
        let saved = self.loopDepth
        self.loopDepth = saved + 1
        let (body, n) = self.blockLoopText(0, "")
        self.loopDepth = saved
        if self.stopped() {
            return ""
        }
        return "P loop " + i64(t.line) + " " + i64(t.col) + "\n" + body
    }

    // breakContText parses bare break/continue; outside any loop body they
    // are E0201 (loop depth is a pure position fact — a closure body
    // resets it).
    pub fn breakContText(mut self) -> String {
        let t = self.cur
        self.next()
        if self.loopDepth == 0 {
            self.failTok(t, "E0201",
                "break or continue outside a loop — " + lexnum.quoteText(t.text) + " stands in a block that is not inside a loop body; bare break and continue control the innermost enclosing while or loop")
            return ""
        }
        if t.text == "break" {
            return "P break " + i64(t.line) + " " + i64(t.col) + "\n"
        }
        return "P continue " + i64(t.line) + " " + i64(t.col) + "\n"
    }

    // deferText parses `defer block` (E0203) as a direct item of a function
    // body's block (E0204). The body is a plain block in a no-return
    // context: returns inside it are E0401, whatever function encloses the
    // defer.
    pub fn deferText(mut self) -> String {
        let t = self.cur
        self.next()
        if self.direct != 1 {
            self.failTok(t, "E0204",
                "defer placement — defer is not a direct item of the function body's block; defer runs at function exit in reverse order and needs the single exit-point placement")
            return ""
        }
        if self.cur.kind != "{" {
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — defer takes a block: defer { … }")
                return ""
            }
            self.failTok(t, "E0203",
                "defer body must be a block — the operand is an expression, not a block; the single ratified shape is defer { ... }")
            return ""
        }
        let (blk, n) = self.blockLoopText(0, ";0;1")
        if self.stopped() {
            return ""
        }
        return "P defer " + i64(t.line) + " " + i64(t.col) + "\n" + blk
    }

    // forText parses `for pat in expr block` (chapter 5): the head pattern
    // is irrefutable and the iterated expression is a control-flow head.
    // The body is a loop body for the break/continue depth.
    pub fn forText(mut self) -> String {
        let t = self.cur
        self.next()
        let pat = self.forHeadText()
        if self.stopped() {
            return ""
        }
        if isKw(self.cur, "in") == false {
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — a for head is pat in iterable")
                return ""
            }
            self.failTok(self.cur, "E0105",
                "unexpected token — " + lexnum.quoteText(self.cur.text) + " where a for head's in goes: a for head is pat in iterable")
            return ""
        }
        self.next()
        let iter = self.headExprText()
        if self.stopped() {
            return ""
        }
        if self.cur.kind != "{" {
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — a for wants its body block")
                return ""
            }
            self.failTok(self.cur, "E0105",
                "unexpected token — " + lexnum.quoteText(self.cur.text) + " where a for body block opens")
            return ""
        }
        let saved = self.loopDepth
        self.loopDepth = saved + 1
        let (body, n) = self.blockLoopText(0, "")
        self.loopDepth = saved
        if self.stopped() {
            return ""
        }
        return "P for " + i64(t.line) + " " + i64(t.col) + "\n" + pat + iter + body
    }

    // forHeadText parses a for head's irrefutable pattern: a binding name,
    // the wildcard, or a tuple of them — chapter 8's let-head grammar is
    // the one authority for irrefutable patterns. The tuple form rides the
    // pattern face and latches pending; a refutable shape anchors its own
    // first token.
    pub fn forHeadText(mut self) -> String {
        let t = self.cur
        if t.kind == "_" {
            self.next()
            return "P patwild " + i64(t.line) + " " + i64(t.col) + "\n"
        }
        if t.kind == "ident" && isPascal(t.text) == false {
            self.checkCamel(t)
            if self.stopped() {
                return ""
            }
            self.next()
            return "P patbind " + i64(t.line) + " " + i64(t.col) + " " + lexnum.esc(t.text) + "\n"
        }
        if t.kind == "(" {
            let (pt, pb) = self.letTupleText()
            if self.stopped() {
                return ""
            }
            return pt
        }
        if t.kind == "eof" {
            self.failTok(t, "E0105", "unexpected end of file — the \"for\" head takes an irrefutable pattern: a binding, the wildcard, or a tuple of them")
            return ""
        }
        self.failTok(t, "E0105",
            "unexpected token — " + lexnum.quoteText(t.text) + " fits no production here: the \"for\" head takes an irrefutable pattern, a binding, the wildcard, or a tuple of them; refutable patterns are match-only")
        return ""
    }

    // scopeResText parses `scope resource(name = expr, …) block` (chapter
    // 13). The binding list is a paren region (line breaks fold, depth
    // wraps it); head names are block bindings — camelCase (E0012) and
    // duplicates (E0404, the head's own wording) keep their codes. The
    // body is a plain nested block: loop depth persists and defer inside
    // is not at a function body's top level.
    pub fn scopeResText(mut self) -> String {
        let t = self.cur
        self.next()
        self.next()
        if self.cur.kind != "(" {
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — a scope resource head is scope resource(name = expr, …) { … }")
                return ""
            }
            self.failTok(self.cur, "E0105",
                "unexpected token — " + lexnum.quoteText(self.cur.text) + " where \"(\" opens the scope resource binding list: a scope resource head is scope resource(name = expr, …) { … }")
            return ""
        }
        self.next()
        self.depth = self.depth + 1
        var out = "P scoperes " + i64(t.line) + " " + i64(t.col) + "\n"
        var seen = ""
        while true {
            let nt = self.cur
            if nt.kind != "ident" && nt.kind != "_" {
                if self.atEnd() {
                    self.failTok(nt, "E0105", "unexpected end of file — a scope resource binding is name = expr")
                    return ""
                }
                self.failTok(nt, "E0105",
                    "unexpected token — " + lexnum.quoteText(nt.text) + " where a scope resource binding's name goes: a binding is name = expr")
                return ""
            }
            if nt.kind == "_" {
                self.failTok(nt, "E0105",
                    "unexpected token — \"_\" fits no scope resource binding: each head binding takes over a handle and names it")
                return ""
            }
            self.checkCamel(nt)
            if self.stopped() {
                return ""
            }
            let prev = namesLineOf(seen, nt.text)
            if prev >= 0 {
                self.failTok(nt, "E0404",
                    "duplicate name in one module — the scope resource head binds " + lexnum.quoteText(nt.text) + " twice, first at line " + i64(prev) + "; a head binds each name at most once")
                return ""
            }
            seen = seen + nt.text + " " + i64(nt.line) + "\n"
            self.next()
            if self.cur.kind != "=" {
                if self.atEnd() {
                    self.failTok(self.cur, "E0105", "unexpected end of file — a scope resource binding is name = expr")
                    return ""
                }
                self.failTok(self.cur, "E0105",
                    "unexpected token — " + lexnum.quoteText(self.cur.text) + " where a scope resource binding's = goes: a binding is name = expr")
                return ""
            }
            self.next()
            let savedValue = self.exprValue
            self.exprValue = 1
            let val = self.exprText()
            self.exprValue = savedValue
            if self.stopped() {
                return ""
            }
            out = out + "P scopebind " + i64(nt.line) + " " + i64(nt.col) + " " + lexnum.esc(nt.text) + "\n" + val
            if self.cur.kind == "," {
                self.next()
                continue
            }
            if self.cur.kind == ")" {
                self.next()
                break
            }
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — the scope resource binding list closes with )")
                return ""
            }
            self.failTok(self.cur, "E0105",
                "unexpected token — " + lexnum.quoteText(self.cur.text) + " where the scope resource binding list closes with )")
            return ""
        }
        self.depth = self.depth - 1
        if self.cur.kind != "{" {
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — a scope resource wants its body block")
                return ""
            }
            self.failTok(self.cur, "E0105",
                "unexpected token — " + lexnum.quoteText(self.cur.text) + " where a scope resource body block opens")
            return ""
        }
        let (body, n) = self.blockLoopText(0, "")
        if self.stopped() {
            return ""
        }
        return out + body
    }

    // ifExprText parses `if cond block [else block | if]` (chapter 3). An
    // else-if chain nests in the else position; `else { if … }` folds to
    // the same shape — recognized on the composed lines, since the port
    // never materializes the tree: the fold shape is a single-item block
    // whose one item is an expression statement holding an if (the item
    // line spells P exprstmt and the child's first line spells P if), and
    // the block's own line and the wrapper strip away. Without else the
    // form produces no value — in a value position it is E0202 (the
    // statement position is legal).
    pub fn ifExprText(mut self) -> String {
        let t = self.cur
        self.next()
        let cond = self.headExprText()
        if self.stopped() {
            return ""
        }
        if self.cur.kind != "{" {
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — an if wants its then block")
                return ""
            }
            self.failTok(self.cur, "E0105",
                "unexpected token — " + lexnum.quoteText(self.cur.text) + " where an if's then block opens")
            return ""
        }
        let (thenText, tn) = self.blockLoopText(0, "")
        if self.stopped() {
            return ""
        }
        var elseText = "-\n"
        if isKw(self.cur, "else") && self.brokeLine() == false {
            self.next()
            if isKw(self.cur, "if") {
                // the chain arm is a value position, whatever the outer
                // context — the reference passes valueCtx to the recursion
                let savedValue = self.exprValue
                self.exprValue = 1
                let inner = self.ifExprText()
                self.exprValue = savedValue
                if self.stopped() {
                    return ""
                }
                elseText = inner
            } else {
                if self.cur.kind != "{" {
                    if self.atEnd() {
                        self.failTok(self.cur, "E0105", "unexpected end of file — else wants its block")
                        return ""
                    }
                    self.failTok(self.cur, "E0105",
                        "unexpected token — " + lexnum.quoteText(self.cur.text) + " where an else block opens (else if continues the chain)")
                    return ""
                }
                let (blk, cnt) = self.blockLoopText(0, "")
                if self.stopped() {
                    return ""
                }
                // the BlockExpr anchor is read AFTER the block closes —
                // the token that follows the closing } (the reference's
                // struct-literal evaluation order)
                var folded = ""
                if cnt == 1 {
                    let n1 = lineEndAt(blk, 0)
                    let rest = blk.byteSlice(n1 + 1, blk.byteLength())
                    if hasPrefix(rest, "P exprstmt ") {
                        let n2 = lineEndAt(rest, 0)
                        let rest2 = rest.byteSlice(n2 + 1, rest.byteLength())
                        if hasPrefix(rest2, "P if ") {
                            folded = rest2
                        }
                    }
                }
                if folded != "" {
                    elseText = folded
                } else {
                    elseText = "P blockexpr " + i64(self.cur.line) + " " + i64(self.cur.col) + "\n" + blk
                }
            }
        }
        if self.exprValue == 1 && elseText == "-\n" {
            var site = self.valSite
            if site == "" {
                site = "this value position"
            }
            self.failTok(t, "E0202",
                "valueless form in value position — an if without else produces no value and cannot stand in " + site + "; valueless forms are statements")
            return ""
        }
        return "P if " + i64(t.line) + " " + i64(t.col) + "\n" + cond + thenText + elseText
    }

    // typeRefText parses one type reference into an annotation slot and
    // renders its P lines: the named forms (Name, module.Name, and their
    // generic applications), the paren family (the unit type and the
    // tuple type), and the fn type with its effect tags. The Go original
    // carries the last lowercase segment as one token var; a var here
    // holds only a scalar or a String face, so the segment's three fields
    // travel in their own vars (same discipline as parseImport).
    pub fn typeRefText(mut self) -> String {
        let t = self.cur
        if isKw(t, "fn") {
            return self.fnTypeText()
        }
        if t.kind == "(" {
            return self.parenTypeText()
        }
        if t.kind == "ident" {
            self.next()
            if isPascal(t.text) {
                if self.cur.kind == "." {
                    self.failTok(self.cur, "E0105", typeRefMsg(self.cur.text))
                    return ""
                }
                let (al, ac) = self.anglePos()
                let argsText = self.genericArgsText()
                if self.stopped() {
                    return ""
                }
                return "P named " + i64(t.line) + " " + i64(t.col) + " " + lexnum.esc("") + " " + lexnum.esc(t.text) + " " + i64(al) + " " + i64(ac) + "\n" + argsText
            }
            var quals = t.text
            var lastText: String = t.text
            var lastLine: Int64 = t.line
            var lastCol: Int64 = t.col
            while self.cur.kind == "." {
                self.next()
                let nt = self.cur
                if nt.kind != "ident" {
                    self.failTok(nt, "E0105", typeRefMsg(nt.text))
                    return ""
                }
                self.next()
                if isPascal(nt.text) {
                    if self.cur.kind == "." {
                        self.failTok(self.cur, "E0105", typeRefMsg(self.cur.text))
                        return ""
                    }
                    let (al, ac) = self.anglePos()
                    let argsText = self.genericArgsText()
                    if self.stopped() {
                        return ""
                    }
                    return "P named " + i64(t.line) + " " + i64(t.col) + " " + lexnum.esc(quals) + " " + lexnum.esc(nt.text) + " " + i64(al) + " " + i64(ac) + "\n" + argsText
                }
                quals = quals + "." + nt.text
                lastText = nt.text
                lastLine = nt.line
                lastCol = nt.col
            }
            self.fail(lastLine, lastCol, "E0105", typeRefMsg(lastText))
            return ""
        }
        if t.kind == "eof" {
            self.failTok(t, "E0105", "unexpected end of file — an annotation slot wants a type reference")
            return ""
        }
        self.failTok(t, "E0105", typeRefMsg(t.text))
        return ""
    }

    // anglePos reports the position of a generic clause's `<` when one is
    // next, else the zero position — the application's anchor.
    pub fn anglePos(mut self) -> (Int64, Int64) {
        if self.cur.kind == "<" {
            return (self.cur.line, self.cur.col)
        }
        return (0, 0)
    }

    // genericArgsText consumes a `<T1, …, Tk>` application when present,
    // rendering the argument type references' P lines.
    pub fn genericArgsText(mut self) -> String {
        if self.cur.kind != "<" {
            return ""
        }
        self.next()
        var out = ""
        while true {
            if self.closeAngle() {
                return out
            }
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — a generic argument list closes with >")
                return ""
            }
            out = out + self.typeRefText()
            if self.stopped() {
                return ""
            }
            if self.cur.kind == "," {
                self.next()
                continue
            }
            if self.closeAngle() {
                return out
            }
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — a generic argument list closes with >")
                return ""
            }
            self.failTok(self.cur, "E0105",
                "unexpected token — " + lexnum.quoteText(self.cur.text) + " in a generic argument list: the list closes with >")
            return ""
        }
        return out
    }

    // closeAngle consumes the closing `>` of a generic application and
    // reports whether it did. Only the bare `>` closes: maximal munch
    // makes `>>` and `>=` the shift and ge operators, so a two-byte
    // `>`-led token at a closer position means the nested closers were
    // not separated.
    pub fn closeAngle(mut self) -> Bool {
        if self.cur.kind == ">" {
            self.next()
            return true
        }
        if self.cur.kind == ">>" || self.cur.kind == ">=" {
            self.failTok(self.cur, "E0105",
                "unexpected token — " + lexnum.quoteText(self.cur.text) + " merges the nested closers: nested closers are separated — write Name<Name<Int64> >; " + lexnum.quoteText(self.cur.text) + " is the shift operator (chapter 1)")
            return false
        }
        return false
    }

    // parseSumDecl parses `[pub] [byval] type Name<T…> = V1 | … | Vn
    // [derives …]` (chapter 8): bare variants and payload variants, the
    // payload list comma-separated. A line-starting `|` after a complete
    // variant ends the declaration without a derives clause (the keyword
    // stays for the next item position); the same-line `|` continues.
    pub fn parseSumDecl(mut self, isPub: Bool, isByval: Bool, line: Int64, col: Int64) {
        self.next()
        let t = self.cur
        if t.kind != "ident" {
            if self.atEnd() {
                self.failTok(t, "E0105", "unexpected end of file — a sum declaration is type Name = V1 | … | Vn")
                return
            }
            self.failTok(t, "E0105",
                "unexpected token — " + lexnum.quoteText(t.text) + " where the type name goes: a sum declaration is type Name = V1 | … | Vn")
            return
        }
        self.dupCheck(t)
        if self.stopped() {
            return
        }
        self.checkPascal(t)
        if self.stopped() {
            return
        }
        let name = t.text
        let nameLine = t.line
        let nameCol = t.col
        self.registerRaw(name, nameLine)
        self.next()
        var tpsText = ""
        if self.cur.kind == "<" {
            tpsText = self.typeParamsText()
            if self.stopped() {
                return
            }
        }
        if self.cur.kind != "=" {
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — a sum declaration is type Name = V1 | … | Vn")
                return
            }
            self.failTok(self.cur, "E0105",
                "unexpected token — " + lexnum.quoteText(self.cur.text) + " where the = of a sum declaration goes")
            return
        }
        self.next()
        var body = ""
        var vText = ""
        var payloadText = ""
        var payloadCount: Int64 = 0
        var derivesText = ""
        while true {
            let vt = self.cur
            if vt.kind != "ident" {
                if self.atEnd() {
                    self.failTok(vt, "E0105", "unexpected end of file — a variant list wants at least one variant")
                    return
                }
                self.failTok(vt, "E0105",
                    "unexpected token — " + lexnum.quoteText(vt.text) + " where a variant name goes: variants are Name or Name(payload types)")
                return
            }
            self.dupCheck(vt)
            if self.stopped() {
                return
            }
            self.checkPascal(vt)
            if self.stopped() {
                return
            }
            self.registerRaw(vt.text, vt.line)
            vText = "P variant " + i64(vt.line) + " " + i64(vt.col) + " " + lexnum.esc(vt.text) + "\n"
            payloadText = ""
            payloadCount = 0
            self.next()
            if self.cur.kind == "(" {
                self.next()
                while true {
                    if self.cur.kind == ")" {
                        if payloadCount == 0 {
                            self.failTok(self.cur, "E0105",
                                "unexpected token — an empty payload list fits no production: a variant is bare, or carries one to eight payload types")
                            return
                        }
                        self.next()
                        break
                    }
                    if self.atEnd() {
                        self.failTok(self.cur, "E0105", "unexpected end of file — a payload list closes with )")
                        return
                    }
                    let ty = self.typeRefText()
                    if self.stopped() {
                        return
                    }
                    vText = vText + ty
                    payloadCount = payloadCount + 1
                    if self.cur.kind == "," {
                        self.next()
                        continue
                    }
                    if self.cur.kind == ")" {
                        self.next()
                        break
                    }
                    self.failTok(self.cur, "E0105",
                        "unexpected token — " + lexnum.quoteText(self.cur.text) + " in a payload list: payloads are comma-separated type references and the list closes with )")
                    return
                }
                if payloadCount > 8 {
                    self.failTok(vt, "E0701",
                        "variant payload arity above eight — " + lexnum.quoteText(vt.text) + " declares " + i64(payloadCount) + " payload types; a record payload names its fields")
                    return
                }
            }
            body = body + vText
            if self.cur.kind == "|" {
                if self.brokeLine() {
                    break
                }
                self.next()
                continue
            }
            derivesText = self.derivesSlot()
            if self.stopped() {
                return
            }
            break
        }
        if derivesText == "" {
            derivesText = "-\n"
        }
        self.astText = self.astText + "P sum " + i64(line) + " " + i64(col) + " " + b01(isPub) + " " + b01(isByval) + " " + lexnum.esc(name) + " " + i64(nameLine) + " " + i64(nameCol) + "\n" + tpsText + body + derivesText
    }

    // parseRecordDecl parses chapter 8's record declaration: `[pub] [byval |
    // byres] record Name<T…> { fields } [derives …]`. The prefixes are
    // consumed by the caller; line/col anchor at the outermost one. The
    // field list is comma- or newline-separated with a uniform trailing
    // comma — braces are brackets, so line breaks inside fold. The answer
    // is the field count: the foreign block's opaque reuse (which passes
    // opaque in) rejects a non-zero count at its item head after the
    // production has run, so no partial tree escapes the diagnostic.
    pub fn parseRecordDecl(mut self, isPub: Bool, cat: String, opaque: Bool, line: Int64, col: Int64) -> Int64 {
        self.next()
        let t = self.cur
        if t.kind != "ident" {
            if self.atEnd() {
                self.failTok(t, "E0105", "unexpected end of file — a record declaration is record Name { fields }")
                return 0
            }
            self.failTok(t, "E0105",
                "unexpected token — " + lexnum.quoteText(t.text) + " where the record name goes: a record declaration is record Name { fields }")
            return 0
        }
        self.dupCheck(t)
        if self.stopped() {
            return 0
        }
        self.checkPascal(t)
        if self.stopped() {
            return 0
        }
        let name = t.text
        let nameLine = t.line
        let nameCol = t.col
        self.registerRaw(name, nameLine)
        self.next()
        var tpsText = ""
        if self.cur.kind == "<" {
            tpsText = self.typeParamsText()
            if self.stopped() {
                return 0
            }
        }
        if self.cur.kind != "{" {
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — a record wants its field block")
                return 0
            }
            self.failTok(self.cur, "E0105",
                "unexpected token — " + lexnum.quoteText(self.cur.text) + " where a record's field block opens")
            return 0
        }
        self.next()
        self.depth = self.depth + 1
        var fieldsText = ""
        var count: Int64 = 0
        while true {
            if self.cur.kind == "}" {
                self.next()
                break
            }
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — a record's field block closes with }")
                return 0
            }
            let ft = self.cur
            if ft.kind != "ident" {
                self.failTok(ft, "E0105",
                    "unexpected token — " + lexnum.quoteText(ft.text) + " where a field name goes: fields are name: type pairs")
                return 0
            }
            self.checkCamel(ft)
            if self.stopped() {
                return 0
            }
            self.next()
            if self.cur.kind != ":" {
                self.failTok(ft, "E0105",
                    "unexpected token — field " + lexnum.quoteText(ft.text) + " carries no annotation: fields are name: type; field types are never inferred")
                return 0
            }
            self.next()
            let ty = self.typeRefText()
            if self.stopped() {
                return 0
            }
            fieldsText = fieldsText + "P field " + i64(ft.line) + " " + i64(ft.col) + " " + lexnum.esc(ft.text) + "\n" + ty
            count = count + 1
            if self.cur.kind == "," {
                self.next()
                continue
            }
            if self.cur.kind == "}" {
                self.next()
                break
            }
            if self.cur.kind == "ident" && self.brokeLine() {
                continue
            }
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — a record's field block closes with }")
                return 0
            }
            self.failTok(self.cur, "E0105",
                "unexpected token — " + lexnum.quoteText(self.cur.text) + " in a record field list: fields are name: type pairs separated by commas or line breaks")
            return 0
        }
        self.depth = self.depth - 1
        let dText = self.derivesSlot()
        if self.stopped() {
            return 0
        }
        self.astText = self.astText + "P record " + i64(line) + " " + i64(col) + " " + b01(isPub) + " " + lexnum.esc(cat) + " " + lexnum.esc(name) + " " + b01(opaque) + " " + i64(nameLine) + " " + i64(nameCol) + "\n" + tpsText + fieldsText + dText
        return count
    }

    // parseNewtypeDecl parses `newtype Name<T…>(Underlying) [derives …]`
    // (chapter 8): a zero-cost wrapper over exactly one type — the wrapped
    // list takes no comma. The prefix is consumed by the caller; line/col
    // anchor at the outermost prefix token.
    pub fn parseNewtypeDecl(mut self, isPub: Bool, line: Int64, col: Int64) {
        self.next()
        let t = self.cur
        if t.kind != "ident" {
            if self.atEnd() {
                self.failTok(t, "E0105", "unexpected end of file — a newtype declaration is newtype Name(Type)")
                return
            }
            self.failTok(t, "E0105",
                "unexpected token — " + lexnum.quoteText(t.text) + " where the newtype name goes: a newtype declaration is newtype Name(Type)")
            return
        }
        self.dupCheck(t)
        if self.stopped() {
            return
        }
        self.checkPascal(t)
        if self.stopped() {
            return
        }
        let name = t.text
        let nameLine = t.line
        let nameCol = t.col
        self.registerRaw(name, nameLine)
        self.next()
        var tpsText = ""
        if self.cur.kind == "<" {
            tpsText = self.typeParamsText()
            if self.stopped() {
                return
            }
        }
        if self.cur.kind != "(" {
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — a newtype wraps its underlying type in (…)")
                return
            }
            self.failTok(self.cur, "E0105",
                "unexpected token — " + lexnum.quoteText(self.cur.text) + " where a newtype's underlying type opens: a newtype wraps exactly one underlying type")
            return
        }
        self.next()
        let underText = self.typeRefText()
        if self.stopped() {
            return
        }
        if self.cur.kind != ")" {
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — a newtype closes with )")
                return
            }
            self.failTok(self.cur, "E0105",
                "a newtype wraps exactly one underlying type — the wrapped list takes no comma and closes with )")
            return
        }
        self.next()
        let dText = self.derivesSlot()
        if self.stopped() {
            return
        }
        self.astText = self.astText + "P newtype " + i64(line) + " " + i64(col) + " " + b01(isPub) + " " + lexnum.esc(name) + " " + i64(nameLine) + " " + i64(nameCol) + "\n" + tpsText + underText + dText
    }

    // typeParamsText parses the `<T1, …, Tk>` clause of a declaration: the
    // parameters are PascalCase names (E0011 rides here), the clause holds
    // one to eight (E0825 at the clause's own `<` after the walk), and only
    // the bare `>` closes (closeAngle owns the merged-closer diagnostic).
    pub fn typeParamsText(mut self) -> String {
        let open = self.cur
        self.next()
        if self.cur.kind == ">" {
            self.failTok(self.cur, "E0105",
                "unexpected token — \">\" opens an empty generic parameter clause: a clause holds one to eight names")
            return ""
        }
        var out = ""
        var count: Int64 = 0
        while true {
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — a generic parameter clause closes with >")
                return ""
            }
            let nt = self.cur
            if nt.kind != "ident" {
                self.failTok(nt, "E0105",
                    "unexpected token — " + lexnum.quoteText(nt.text) + " in a generic parameter clause: the parameters are PascalCase names")
                return ""
            }
            self.checkPascal(nt)
            if self.stopped() {
                return ""
            }
            out = out + "P tparam " + i64(nt.line) + " " + i64(nt.col) + " " + lexnum.esc(nt.text) + "\n"
            count = count + 1
            self.next()
            if self.cur.kind == "," {
                self.next()
                continue
            }
            if self.closeAngle() {
                break
            }
            if self.stopped() {
                return ""
            }
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — a generic parameter clause closes with >")
                return ""
            }
            self.failTok(self.cur, "E0105",
                "unexpected token — " + lexnum.quoteText(self.cur.text) + " in a generic parameter clause: the clause closes with >")
            return ""
        }
        if count > 8 {
            self.failTok(open, "E0825",
                "generic parameter count above eight — the clause declares " + i64(count) + " parameters; a clause carries at most eight")
            return ""
        }
        return out
    }

    // whereText parses the where clause's comma-separated constraint list.
    pub fn whereText(mut self) -> String {
        self.next()
        var out = ""
        while true {
            out = out + self.boundRefText()
            if self.stopped() {
                return ""
            }
            if self.cur.kind == "," {
                self.next()
                continue
            }
            return out
        }
        return out
    }

    // boundRefText parses one where constraint — `T: Iface [+ Iface2 …]`
    // or the equality form `T.Assoc == Type` — rendering the P where line
    // and its bound or equality children. The bound's iface names carry no
    // angle anchor (the reference builds them without ArgLine/ArgCol), so
    // the P named line spells 0 0 there even under a generic application.
    pub fn boundRefText(mut self) -> String {
        let st = self.cur
        if st.kind != "ident" {
            if self.atEnd() {
                self.failTok(st, "E0105", "unexpected end of file — a where constraint is T: Iface or T.Assoc == Type")
                return ""
            }
            self.failTok(st, "E0105",
                "unexpected token — " + lexnum.quoteText(st.text) + " where a where subject goes: a constraint is T: Iface or T.Assoc == Type")
            return ""
        }
        self.next()
        if self.cur.kind == "." {
            self.next()
            let at = self.cur
            if at.kind != "ident" {
                if self.atEnd() {
                    self.failTok(at, "E0105", "unexpected end of file — an equality constraint is T.Assoc == Type")
                    return ""
                }
                self.failTok(at, "E0105",
                    "unexpected token — " + lexnum.quoteText(at.text) + " where the associated type goes: an equality constraint is T.Assoc == Type")
                return ""
            }
            self.next()
            if self.cur.kind != "==" {
                if self.atEnd() {
                    self.failTok(self.cur, "E0105", "unexpected end of file — an equality constraint is T.Assoc == Type")
                    return ""
                }
                self.failTok(self.cur, "E0105",
                    "unexpected token — " + lexnum.quoteText(self.cur.text) + " where == goes: an equality constraint is T.Assoc == Type")
                return ""
            }
            let eq = self.cur
            self.next()
            let rhsText = self.typeRefText()
            if self.stopped() {
                return ""
            }
            return "P where " + i64(st.line) + " " + i64(st.col) + " " + lexnum.esc(st.text) + "\n" +
                "P typeeq " + i64(eq.line) + " " + i64(eq.col) + " " + lexnum.esc(at.text) + "\n" + rhsText
        }
        if self.cur.kind != ":" {
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — a where constraint is T: Iface or T.Assoc == Type")
                return ""
            }
            self.failTok(self.cur, "E0105",
                "unexpected token — " + lexnum.quoteText(self.cur.text) + " where a constraint's : or == goes: a constraint is T: Iface or T.Assoc == Type")
            return ""
        }
        self.next()
        var out = "P where " + i64(st.line) + " " + i64(st.col) + " " + lexnum.esc(st.text) + "\n"
        while true {
            let it = self.cur
            if it.kind != "ident" || isPascal(it.text) == false {
                if self.atEnd() {
                    self.failTok(it, "E0105", "unexpected end of file — a bound names an interface: T: Iface [+ Iface2 …]")
                    return ""
                }
                self.failTok(it, "E0105",
                    "unexpected token — " + lexnum.quoteText(it.text) + " where a bound goes: a bound names an interface, T: Iface [+ Iface2 …]")
                return ""
            }
            self.next()
            out = out + "P named " + i64(it.line) + " " + i64(it.col) + " " + lexnum.esc("") + " " + lexnum.esc(it.text) + " 0 0\n"
            let argsText = self.genericArgsText()
            if self.stopped() {
                return ""
            }
            out = out + argsText
            if self.cur.kind == "+" {
                self.next()
                continue
            }
            return out
        }
        return out
    }

    // derivesSlot parses the optional derives clause trailing a composite
    // declaration: same-line `derives` then the bare targets Eq, Hash, Show
    // (E0824's three message forms — duplicate, the Shareable misspelling,
    // the unknown name). A clause on a new line belongs to the next item
    // position, so the empty slot `-\n` answers.
    pub fn derivesSlot(mut self) -> String {
        if isKw(self.cur, "derives") == false {
            return "-\n"
        }
        if self.brokeLine() {
            return "-\n"
        }
        let t = self.cur
        self.next()
        var out = "P derives " + i64(t.line) + " " + i64(t.col)
        var seenEq = false
        var seenHash = false
        var seenShow = false
        while true {
            let nt = self.cur
            if nt.kind != "ident" {
                if self.atEnd() {
                    self.failTok(nt, "E0105", "unexpected end of file — a derives clause is derives Eq, Hash, Show")
                    return ""
                }
                self.failTok(nt, "E0105",
                    "unexpected token — " + lexnum.quoteText(nt.text) + " in a derives clause: the clause is derives followed by the bare names Eq, Hash, Show")
                return ""
            }
            self.next()
            if nt.text == "Eq" || nt.text == "Hash" || nt.text == "Show" {
                var dup = false
                if nt.text == "Eq" {
                    if seenEq {
                        dup = true
                    }
                    seenEq = true
                }
                if nt.text == "Hash" {
                    if seenHash {
                        dup = true
                    }
                    seenHash = true
                }
                if nt.text == "Show" {
                    if seenShow {
                        dup = true
                    }
                    seenShow = true
                }
                if dup {
                    self.failTok(nt, "E0824",
                        "unknown or duplicate derive target — " + lexnum.quoteText(nt.text) + " appears twice in the clause; each target appears at most once")
                    return ""
                }
            } else {
                if nt.text == "Shareable" {
                    self.failTok(nt, "E0824",
                        "unknown or duplicate derive target — \"Shareable\" is not a derive target; it is a where bound, not a clause target")
                    return ""
                }
                self.failTok(nt, "E0824",
                    "unknown or duplicate derive target — " + lexnum.quoteText(nt.text) + " is not a derive target; the clause takes \"Eq\", \"Hash\", and \"Show\"")
                return ""
            }
            out = out + " " + lexnum.esc(nt.text)
            if self.cur.kind == "," {
                self.next()
                continue
            }
            return out + "\n"
        }
        return out
    }

    // parseInterfaceDecl parses `[pub] interface Name<T…> { items }`:
    // associated types (`type Name`, at most four — E0803) and method
    // signatures, newline-separated. The serializer groups the assoc lines
    // before the method lines while the source may interleave the two
    // legally, so the walk keeps two buffers and composes grouped; the
    // method names join the interface's own member name space (not the
    // module's), where a collision is the ordinary E0404. A where clause
    // here is its own rejection (it trails a signature or an impl head,
    // not an interface declaration).
    pub fn parseInterfaceDecl(mut self, isPub: Bool, line: Int64, col: Int64) {
        self.next()
        let t = self.cur
        if t.kind != "ident" {
            if self.atEnd() {
                self.failTok(t, "E0105", "unexpected end of file — an interface declaration is interface Name { items }")
                return
            }
            self.failTok(t, "E0105",
                "unexpected token — " + lexnum.quoteText(t.text) + " where the interface name goes: an interface declaration is interface Name { items }")
            return
        }
        self.dupCheck(t)
        if self.stopped() {
            return
        }
        self.checkPascal(t)
        if self.stopped() {
            return
        }
        let name = t.text
        let nameLine = t.line
        let nameCol = t.col
        self.registerRaw(name, nameLine)
        self.next()
        var tpsText = ""
        if self.cur.kind == "<" {
            tpsText = self.typeParamsText()
            if self.stopped() {
                return
            }
        }
        if isKw(self.cur, "where") {
            self.failTok(self.cur, "E0105",
                "unexpected token — \"where\" fits no production here: a where clause trails a fn signature or an impl head, not an interface declaration")
            return
        }
        if self.cur.kind != "{" {
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — an interface wants its item block")
                return
            }
            self.failTok(self.cur, "E0105",
                "unexpected token — " + lexnum.quoteText(self.cur.text) + " where an interface's item block opens")
            return
        }
        self.next()
        self.depth = self.depth + 1
        var assocsText = ""
        var methodsText = ""
        var memberNames = ""
        var assocCount: Int64 = 0
        while true {
            if self.cur.kind == "}" {
                self.next()
                break
            }
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — an interface's item block closes with }")
                return
            }
            if isKw(self.cur, "type") {
                let kw = self.cur
                let (aText, aName) = self.assocText()
                if self.stopped() {
                    return
                }
                if assocCount >= 4 {
                    self.failTok(kw, "E0803",
                        "associated type count above four — " + lexnum.quoteText(name) + " declares a fifth associated type " + lexnum.quoteText(aName) + "; an interface declares at most four")
                    return
                }
                assocCount = assocCount + 1
                assocsText = assocsText + aText
            } else {
                if isKw(self.cur, "fn") {
                    let (mText, members2) = self.methodSigText(memberNames)
                    memberNames = members2
                    if self.stopped() {
                        return
                    }
                    methodsText = methodsText + mText
                } else {
                    self.failTok(self.cur, "E0105",
                        "unexpected token — " + lexnum.quoteText(self.cur.text) + " fits no interface item production: an interface declares associated types and methods only")
                    return
                }
            }
            if self.cur.kind == "}" {
                self.next()
                break
            }
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — an interface's item block closes with }")
                return
            }
            if self.brokeLine() == false {
                self.failTok(self.cur, "E0105",
                    "unexpected token — " + lexnum.quoteText(self.cur.text) + " fits no production: interface items are separated by newlines and carry no separator token")
                return
            }
        }
        self.depth = self.depth - 1
        self.astText = self.astText + "P interface " + i64(line) + " " + i64(col) + " " + b01(isPub) + " " + lexnum.esc(name) + " " + i64(nameLine) + " " + i64(nameCol) + "\n" + tpsText + assocsText + methodsText
    }

    // assocText parses one associated type `type Name`: PascalCase, no
    // upper bound on the hole (E0804 — bounds belong in where clauses).
    // The name answers alongside the P line, for the count diagnostic's
    // message.
    pub fn assocText(mut self) -> (String, String) {
        self.next()
        let nt = self.cur
        if nt.kind != "ident" {
            if self.atEnd() {
                self.failTok(nt, "E0105", "unexpected end of file — an associated type is type Name")
                return ("", "")
            }
            self.failTok(nt, "E0105",
                "unexpected token — " + lexnum.quoteText(nt.text) + " where the associated type's name goes: a hole is type Name")
            return ("", "")
        }
        self.checkPascal(nt)
        if self.stopped() {
            return ("", "")
        }
        self.next()
        if self.cur.kind == ":" {
            self.next()
            self.failTok(self.cur, "E0804",
                "associated type declares an upper bound — the associated type " + lexnum.quoteText(nt.text) + " carries an upper bound; bounds belong in where clauses, not on the hole's declaration")
            return ("", "")
        }
        return ("P assoc " + i64(nt.line) + " " + i64(nt.col) + " " + lexnum.esc(nt.text) + "\n", nt.text)
    }

    // methodSigText parses one interface method signature `fn name(self,
    // params…) [effect tags] [-> type] [{ default body }]`. The name joins
    // the interface's member name space before the camelCase gate (the
    // collision outranks the convention, as at module level); the body is
    // OPTIONAL — a signature without one answers the empty body slot, and
    // the item loop's separator check reports a stray token after it. The
    // updated member space answers alongside the P lines.
    pub fn methodSigText(mut self, memberNames: String) -> (String, String) {
        self.next()
        let t = self.cur
        if t.kind != "ident" {
            if self.atEnd() {
                self.failTok(t, "E0105", "unexpected end of file — a method signature is fn name(self, params…) [-> type]")
                return ("", memberNames)
            }
            self.failTok(t, "E0105",
                "unexpected token — " + lexnum.quoteText(t.text) + " where the method name goes: a method signature is fn name(self, params…) [-> type]")
            return ("", memberNames)
        }
        let prev = namesLineOf(memberNames, t.text)
        if prev >= 0 {
            self.failTok(t, "E0404",
                "duplicate name in one module — " + lexnum.quoteText(t.text) + " is already declared at line " + i64(prev) + "; one module has one name space")
            return ("", memberNames)
        }
        var members = memberNames + t.text + " " + i64(t.line) + "\n"
        self.checkCamel(t)
        if self.stopped() {
            return ("", memberNames)
        }
        let name = t.text
        let nameLine = t.line
        let nameCol = t.col
        self.next()
        var tpsText = ""
        if self.cur.kind == "<" {
            tpsText = self.typeParamsText()
            if self.stopped() {
                return ("", memberNames)
            }
        }
        if self.cur.kind != "(" {
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — a method's parameter list opens with the receiver")
                return ("", memberNames)
            }
            self.failTok(self.cur, "E0105",
                "unexpected token — " + lexnum.quoteText(self.cur.text) + " where a method's parameter list opens: the first parameter is the receiver self or mut self")
            return ("", memberNames)
        }
        let (recv, paramsText) = self.recvParamList(name)
        if self.stopped() {
            return ("", memberNames)
        }
        var effectTags = ""
        var effectLine: Int64 = 0
        var effectCol: Int64 = 0
        if isKw(self.cur, "effect") {
            let (tags, el, ec) = self.parseEffectSegment(false)
            effectTags = tags
            effectLine = el
            effectCol = ec
            if self.stopped() {
                return ("", memberNames)
            }
        }
        var retText = "-\n"
        var hasRet: Int64 = 0
        if self.cur.kind == "->" {
            self.next()
            retText = self.typeRefText()
            hasRet = 1
            if self.stopped() {
                return ("", memberNames)
            }
        }
        if isKw(self.cur, "where") {
            self.failTok(self.cur, "E0105",
                "unexpected token — \"where\" fits no production here: a where clause trails a fn declaration's signature or an impl head, not a method signature")
            return ("", memberNames)
        }
        var bodyText = "-\n"
        if self.cur.kind == "{" {
            bodyText = self.fnBlock(name, hasRet)
            if self.stopped() {
                return ("", memberNames)
            }
        }
        var head = "P msig 0 0 " + lexnum.esc(name) + " " + lexnum.esc(recv)
        if effectTags != "" {
            head = head + " " + effectTags
        }
        head = head + " " + i64(effectLine) + " " + i64(effectCol) + " " + i64(hasRet) + " " + i64(nameLine) + " " + i64(nameCol) + "\n"
        return (head + tpsText + paramsText + retText + bodyText, members)
    }

    // recvParamList parses a method's parameter list from its `(` through
    // the closing `)`: the receiver entry first — the bare parameter self
    // or mut self, unannotated and so spelled (E0801's two forms, E0802)
    // — then, after a comma, the ordinary annotated entries through the
    // shared paramsLoop. The receiver spelling answers for the header.
    pub fn recvParamList(mut self, method: String) -> (String, String) {
        let open = self.cur
        self.next()
        if self.cur.kind == ")" {
            self.failTok(open, "E0801",
                "method declares no receiver — " + lexnum.quoteText(method) + " declares no parameters; the receiver is the bare parameter \"self\" or \"mut self\"")
            return ("", "")
        }
        var recv = ""
        if isKw(self.cur, "mut") {
            self.next()
            let st = self.cur
            if st.kind != "ident" {
                if self.atEnd() {
                    self.failTok(st, "E0105", "unexpected end of file — a receiver is the bare parameter self or mut self")
                    return ("", "")
                }
                self.failTok(st, "E0105",
                    "unexpected token — " + lexnum.quoteText(st.text) + " where the receiver goes: a receiver is the bare parameter self or mut self")
                return ("", "")
            }
            if st.text != "self" {
                self.failTok(st, "E0802",
                    "method receiver must be named self — the receiver is spelled " + lexnum.quoteText(st.text) + "; a receiver is \"self\" or \"mut self\"")
                return ("", "")
            }
            recv = "mut self"
            self.next()
        } else {
            let st = self.cur
            if st.kind != "ident" {
                if self.atEnd() {
                    self.failTok(st, "E0105", "unexpected end of file — a method's parameter list opens with the receiver self or mut self")
                    return ("", "")
                }
                self.failTok(st, "E0105",
                    "unexpected token — " + lexnum.quoteText(st.text) + " where a method's receiver goes: the first parameter is the bare receiver self or mut self")
                return ("", "")
            }
            let pk = self.peek()
            if pk.kind == ":" {
                self.failTok(st, "E0801",
                    "method declares no receiver — the first parameter of " + lexnum.quoteText(method) + " carries an annotation; the receiver is the bare parameter \"self\" or \"mut self\"")
                return ("", "")
            }
            if st.text != "self" {
                self.failTok(st, "E0802",
                    "method receiver must be named self — the receiver is spelled " + lexnum.quoteText(st.text) + "; a receiver is \"self\" or \"mut self\"")
                return ("", "")
            }
            recv = "self"
            self.next()
        }
        if self.cur.kind == "," {
            self.next()
            let paramsText = self.paramsLoop()
            return (recv, paramsText)
        }
        if self.cur.kind != ")" {
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — a parameter list closes with )")
                return ("", "")
            }
            self.failTok(self.cur, "E0105",
                "unexpected token — " + lexnum.quoteText(self.cur.text) + " in a parameter list: parameters are name: type pairs")
            return ("", "")
        }
        self.next()
        return (recv, "")
    }

    // parseImplDecl parses `impl<T…> Head [for Head2] [where …] { items }`:
    // without `for` the impl is inherent (the iface slot stays empty);
    // with it the first head is the interface. The items — associated-type
    // bindings first (E0806: a binding after a method definition), then
    // method definitions — stream in source order: in a green parse the
    // bindings precede the methods, so source order is the serializer's
    // grouped order. The impl's method names enter no name space.
    pub fn parseImplDecl(mut self, line: Int64, col: Int64) {
        self.next()
        var tpsText = ""
        if self.cur.kind == "<" {
            tpsText = self.typeParamsText()
            if self.stopped() {
                return
            }
        }
        let headText = self.typeRefText()
        if self.stopped() {
            return
        }
        var ifaceText = "-\n"
        var finalHeadText = headText
        if isKw(self.cur, "for") {
            ifaceText = headText
            self.next()
            finalHeadText = self.typeRefText()
            if self.stopped() {
                return
            }
        }
        var whereT = ""
        if isKw(self.cur, "where") && self.brokeLine() == false {
            whereT = self.whereText()
            if self.stopped() {
                return
            }
        }
        if self.cur.kind != "{" {
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — an impl wants its item block")
                return
            }
            self.failTok(self.cur, "E0105",
                "unexpected token — " + lexnum.quoteText(self.cur.text) + " where an impl's item block opens")
            return
        }
        self.next()
        self.depth = self.depth + 1
        var itemsText = ""
        var lastMethod = ""
        var methodCount: Int64 = 0
        while true {
            if self.cur.kind == "}" {
                self.next()
                break
            }
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — an impl's item block closes with }")
                return
            }
            if isKw(self.cur, "type") {
                let kw = self.cur
                let (bText, bName) = self.assocBindingText()
                if self.stopped() {
                    return
                }
                if methodCount > 0 {
                    self.failTok(kw, "E0806",
                        "associated type binding after a method definition — the binding of " + lexnum.quoteText(bName) + " follows the method " + lexnum.quoteText(lastMethod) + "; associated-type bindings precede methods in an impl")
                    return
                }
                itemsText = itemsText + bText
            } else {
                if isKw(self.cur, "fn") || isKw(self.cur, "pub") {
                    let (mText, mName) = self.implMethodText()
                    if self.stopped() {
                        return
                    }
                    lastMethod = mName
                    methodCount = methodCount + 1
                    itemsText = itemsText + mText
                } else {
                    self.failTok(self.cur, "E0105",
                        "unexpected token — " + lexnum.quoteText(self.cur.text) + " fits no impl item production: an impl defines associated-type bindings and methods")
                    return
                }
            }
            if self.cur.kind == "}" {
                self.next()
                break
            }
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — an impl's item block closes with }")
                return
            }
            if self.brokeLine() == false {
                self.failTok(self.cur, "E0105",
                    "unexpected token — " + lexnum.quoteText(self.cur.text) + " fits no production: impl items are separated by newlines and carry no separator token")
                return
            }
        }
        self.depth = self.depth - 1
        self.astText = self.astText + "P impl " + i64(line) + " " + i64(col) + "\n" + tpsText + ifaceText + finalHeadText + whereT + itemsText
    }

    // assocBindingText parses one associated-type binding `type Name =
    // Type`. The name answers alongside the P lines, for the ordering
    // diagnostic's message.
    pub fn assocBindingText(mut self) -> (String, String) {
        self.next()
        let nt = self.cur
        if nt.kind != "ident" {
            if self.atEnd() {
                self.failTok(nt, "E0105", "unexpected end of file — an associated-type binding is type Name = Type")
                return ("", "")
            }
            self.failTok(nt, "E0105",
                "unexpected token — " + lexnum.quoteText(nt.text) + " where the binding's name goes: a binding is type Name = Type")
            return ("", "")
        }
        self.checkPascal(nt)
        if self.stopped() {
            return ("", "")
        }
        self.next()
        if self.cur.kind != "=" {
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — an associated-type binding is type Name = Type")
                return ("", "")
            }
            self.failTok(self.cur, "E0105",
                "unexpected token — " + lexnum.quoteText(self.cur.text) + " where a binding's = goes: a binding is type Name = Type")
            return ("", "")
        }
        self.next()
        let tyText = self.typeRefText()
        if self.stopped() {
            return ("", "")
        }
        return ("P assocbind " + i64(nt.line) + " " + i64(nt.col) + " " + lexnum.esc(nt.text) + "\n" + tyText, nt.text)
    }

    // implMethodText parses one impl method definition `[pub] fn name(self,
    // params…) [effect tags] [-> type] block`: the body block is REQUIRED
    // here (a signature without one is the interface face), a where clause
    // is rejected with its own message, and the method's name enters no
    // name space — impl methods are not module items. The name answers
    // alongside the P lines, for the ordering diagnostic's message.
    pub fn implMethodText(mut self) -> (String, String) {
        let t = self.cur
        var isPub = false
        if isKw(t, "pub") {
            isPub = true
            self.next()
            if isKw(self.cur, "fn") == false {
                if self.atEnd() {
                    self.failTok(self.cur, "E0105", "unexpected end of file — an impl method definition is [pub] fn name(self, params…) block")
                    return ("", "")
                }
                self.failTok(self.cur, "E0105",
                    "unexpected token — " + lexnum.quoteText(self.cur.text) + " after pub: an impl method definition is [pub] fn name(self, params…) block")
                return ("", "")
            }
        }
        let line = t.line
        let col = t.col
        self.next()
        let nt = self.cur
        if nt.kind != "ident" {
            if self.atEnd() {
                self.failTok(nt, "E0105", "unexpected end of file — an impl method definition is [pub] fn name(self, params…) block")
                return ("", "")
            }
            self.failTok(nt, "E0105",
                "unexpected token — " + lexnum.quoteText(nt.text) + " where the method name goes: an impl method definition is [pub] fn name(self, params…) block")
            return ("", "")
        }
        self.checkCamel(nt)
        if self.stopped() {
            return ("", "")
        }
        let name = nt.text
        let nameLine = nt.line
        let nameCol = nt.col
        self.next()
        var tpsText = ""
        if self.cur.kind == "<" {
            tpsText = self.typeParamsText()
            if self.stopped() {
                return ("", "")
            }
        }
        if self.cur.kind != "(" {
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — a method's parameter list opens with the receiver")
                return ("", "")
            }
            self.failTok(self.cur, "E0105",
                "unexpected token — " + lexnum.quoteText(self.cur.text) + " where a method's parameter list opens: the first parameter is the receiver self or mut self")
            return ("", "")
        }
        let (recv, paramsText) = self.recvParamList(name)
        if self.stopped() {
            return ("", "")
        }
        var effectTags = ""
        var effectLine: Int64 = 0
        var effectCol: Int64 = 0
        if isKw(self.cur, "effect") {
            let (tags, el, ec) = self.parseEffectSegment(false)
            effectTags = tags
            effectLine = el
            effectCol = ec
            if self.stopped() {
                return ("", "")
            }
        }
        var retText = "-\n"
        var hasRet: Int64 = 0
        if self.cur.kind == "->" {
            self.next()
            retText = self.typeRefText()
            hasRet = 1
            if self.stopped() {
                return ("", "")
            }
        }
        if isKw(self.cur, "where") {
            self.failTok(self.cur, "E0105",
                "unexpected token — \"where\" fits no production here: a where clause trails a fn declaration's signature or an impl head, not a method definition")
            return ("", "")
        }
        if self.cur.kind != "{" {
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — a method definition wants its body block")
                return ("", "")
            }
            self.failTok(self.cur, "E0105",
                "unexpected token — " + lexnum.quoteText(self.cur.text) + " where a method definition's body block opens")
            return ("", "")
        }
        let bodyText = self.fnBlock(name, hasRet)
        if self.stopped() {
            return ("", "")
        }
        var head = "P fn " + i64(line) + " " + i64(col) + " " + b01(isPub) + " " + lexnum.esc(name) + " " + lexnum.esc(recv)
        if effectTags != "" {
            head = head + " " + effectTags
        }
        head = head + " " + i64(effectLine) + " " + i64(effectCol) + " 0 " + i64(nameLine) + " " + i64(nameCol) + "\n"
        return (head + tpsText + paramsText + retText + bodyText, name)
    }

    // parseForeignDecl parses `foreign "c" { items }` (chapter 17): the
    // ABI string is exactly "c" through descText's split decode (E1701
    // carries the raw token text), and the items are foreign fn
    // declarations and opaque type declarations — record heads with no
    // field block. The head line and every item append to astText as they
    // parse, because the record item's own parseRecordDecl appends its P
    // lines directly: an fn item held back for a final compose would land
    // after a later record's lines. Braces are brackets, so the loop
    // carries no separator checks — line breaks inside fold.
    pub fn parseForeignDecl(mut self, line: Int64, col: Int64) {
        self.next()
        let ab = self.cur
        if ab.kind == "eof" {
            self.failTok(ab, "E0105", "unexpected end of file — a foreign block is foreign \"c\" { items }")
            return
        }
        if ab.kind != "string" || descText(ab.text) != "c" {
            self.failTok(ab, "E1701",
                "foreign block's ABI string is not \"c\" — got " + ab.text)
            return
        }
        self.next()
        if self.cur.kind != "{" {
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — a foreign block's item block opens with {")
                return
            }
            self.failTok(self.cur, "E0105",
                "unexpected token — " + lexnum.quoteText(self.cur.text) + " where a foreign block's item block opens")
            return
        }
        self.next()
        self.depth = self.depth + 1
        self.astText = self.astText + "P foreign " + i64(line) + " " + i64(col) + " c\n"
        while true {
            if self.cur.kind == "}" {
                self.next()
                break
            }
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — a foreign block closes with }")
                return
            }
            let head = self.cur
            var isPub = false
            if isKw(head, "pub") {
                isPub = true
                self.next()
                if self.atEnd() {
                    self.failTok(self.cur, "E0105", "unexpected end of file — a foreign block closes with }")
                    return
                }
            }
            if isKw(self.cur, "fn") {
                let itText = self.foreignFnItem(isPub, head)
                if self.stopped() {
                    return
                }
                self.astText = self.astText + itText
            } else {
                if isKw(self.cur, "record") {
                    let itText = self.foreignRecordItem(isPub, "gc", head)
                    if self.stopped() {
                        return
                    }
                    self.astText = self.astText + itText
                } else {
                    if isKw(self.cur, "byval") && isKw(self.peek(), "record") {
                        self.next()
                        let itText = self.foreignRecordItem(isPub, "value", head)
                        if self.stopped() {
                            return
                        }
                        self.astText = self.astText + itText
                    } else {
                        if isKw(self.cur, "byres") && isKw(self.peek(), "record") {
                            self.next()
                            let itText = self.foreignRecordItem(isPub, "resource", head)
                            if self.stopped() {
                                return
                            }
                            self.astText = self.astText + itText
                        } else {
                            self.failTok(head, "E0105",
                                "unexpected token — " + lexnum.quoteText(head.text) + " in a foreign block: a foreign block holds foreign function declarations and opaque type declarations, nothing else")
                            return
                        }
                    }
                }
            }
        }
        self.depth = self.depth - 1
    }

    // foreignFnItem parses one foreign fn declaration `fn name(params)
    // effect tags [-> type]`: the effect segment is REQUIRED (E1703 — the
    // declaration is the only evidence of the callee's effects), a generic
    // clause refuses the monomorphic boundary (E1704), and a body block is
    // not the form (the zero body serializes as the block line at 0 0).
    // The name's registration waits until the whole item is green, the
    // reference's own end-of-item registration point.
    pub fn foreignFnItem(mut self, isPub: Bool, head: Token) -> String {
        self.next()
        let nt = self.cur
        if nt.kind != "ident" {
            if self.atEnd() {
                self.failTok(nt, "E0105", "unexpected end of file — a foreign fn declaration is fn name(params) effect tags")
                return ""
            }
            self.failTok(nt, "E0105",
                "unexpected token — " + lexnum.quoteText(nt.text) + " where a fn name goes: a foreign fn declaration is fn name(params) effect tags")
            return ""
        }
        self.dupCheck(nt)
        if self.stopped() {
            return ""
        }
        self.checkCamel(nt)
        if self.stopped() {
            return ""
        }
        let name = nt.text
        let nameLine = nt.line
        let nameCol = nt.col
        self.next()
        if self.cur.kind == "<" {
            self.failTok(nt, "E1704",
                "foreign function declaration with a generic clause — " + lexnum.quoteText(name) + "; the boundary is monomorphic: declare each instantiation, or wrap the polymorphism in a We-side generic function")
            return ""
        }
        if self.cur.kind != "(" {
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — a fn wants its parameter list")
                return ""
            }
            self.failTok(self.cur, "E0105",
                "unexpected token — " + lexnum.quoteText(self.cur.text) + " where a fn's parameter list opens")
            return ""
        }
        let paramsText = self.annotatedParams()
        if self.stopped() {
            return ""
        }
        if isKw(self.cur, "effect") == false {
            self.failTok(nt, "E1703",
                "foreign function declaration without an effect segment — " + lexnum.quoteText(name) + " has no body; the declaration is the only evidence of the callee's effects, so the segment must be written")
            return ""
        }
        let (effectTags, effectLine, effectCol) = self.parseEffectSegment(true)
        if self.stopped() {
            return ""
        }
        var retText = "-\n"
        if self.cur.kind == "->" {
            self.next()
            retText = self.typeRefText()
            if self.stopped() {
                return ""
            }
        }
        if self.cur.kind == "{" {
            self.failTok(head, "E0105",
                "a foreign fn declares no body — the native side holds it; a foreign block holds foreign function declarations and opaque type declarations, nothing else")
            return ""
        }
        self.registerRaw(name, nameLine)
        var out = "P fn " + i64(head.line) + " " + i64(head.col) + " " + b01(isPub) + " " + lexnum.esc(name) + "  "
        if effectTags != "" {
            out = out + effectTags + " "
        }
        out = out + i64(effectLine) + " " + i64(effectCol) + " 1 " + i64(nameLine) + " " + i64(nameCol) + "\n"
        return out + paramsText + retText + "P block 0 0\n"
    }

    // foreignRecordItem parses one opaque type declaration — a record head
    // reused with the opaque flag: parseRecordDecl runs the full production
    // (so a field block's own diagnostics still report), and a non-zero
    // field count then refuses at the item head. The record's P lines land
    // inside parseRecordDecl itself, so the empty string answers here.
    pub fn foreignRecordItem(mut self, isPub: Bool, cat: String, head: Token) -> String {
        let count = self.parseRecordDecl(isPub, cat, true, head.line, head.col)
        if self.stopped() {
            return ""
        }
        if count != 0 {
            self.failTok(head, "E0105",
                "a record with fields is an ordinary record, not an opaque type declaration; a foreign block holds foreign function declarations and opaque type declarations, nothing else")
            return ""
        }
        return ""
    }

    // parenTypeText parses the paren family of type references: `()` the
    // unit type, and `(T1, …, Tn)` the tuple type — two or more elements
    // (a single parenthesized type is no production; the diagnostic anchors
    // at the open parenthesis itself), trailing comma allowed, arity bound
    // eight (E0602 at the open, shared with the expression side).
    pub fn parenTypeText(mut self) -> String {
        let open = self.cur
        self.next()
        if self.cur.kind == ")" {
            self.next()
            return "P unittype " + i64(open.line) + " " + i64(open.col) + "\n"
        }
        let firstText = self.typeRefText()
        if self.stopped() {
            return ""
        }
        if self.cur.kind != "," {
            self.failTok(open, "E0105", typeRefMsg(open.text))
            return ""
        }
        var elemsText = firstText
        var count: Int64 = 1
        while true {
            self.next()
            if self.cur.kind == ")" {
                break
            }
            elemsText = elemsText + self.typeRefText()
            if self.stopped() {
                return ""
            }
            count = count + 1
            if self.cur.kind == "," {
                continue
            }
            if self.cur.kind == ")" {
                break
            }
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — a tuple type closes with )")
                return ""
            }
            self.failTok(self.cur, "E0105", typeRefMsg(self.cur.text))
            return ""
        }
        self.next()
        self.tupleArity(open, count, "type")
        if self.stopped() {
            return ""
        }
        return "P tupletype " + i64(open.line) + " " + i64(open.col) + "\n" + elemsText
    }

    // fnTypeText parses the fn type reference `fn(T1, …, Tn) [tags] -> T`:
    // the parameter list holds bare type references (no names), the effect
    // tags are optional bare-or-qualified names anchored at the first tag
    // token, and the `->` with the result type is required.
    pub fn fnTypeText(mut self) -> String {
        let t = self.cur
        self.next()
        if self.cur.kind != "(" {
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — a fn type opens its parameter list with (")
                return ""
            }
            self.failTok(self.cur, "E0105", typeRefMsg(self.cur.text))
            return ""
        }
        self.next()
        var paramsText = ""
        var tagLine: Int64 = 0
        var tagCol: Int64 = 0
        while true {
            if self.cur.kind == ")" {
                self.next()
                break
            }
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — a fn type's parameter list closes with )")
                return ""
            }
            paramsText = paramsText + self.typeRefText()
            if self.stopped() {
                return ""
            }
            if self.cur.kind == "," {
                self.next()
                continue
            }
            if self.cur.kind == ")" {
                self.next()
                break
            }
            self.failTok(self.cur, "E0105",
                "unexpected token — " + lexnum.quoteText(self.cur.text) + " in a function type reference: fn(T1, …, Tn) [tags] -> T")
            return ""
        }
        if self.cur.kind == "ident" {
            tagLine = self.cur.line
            tagCol = self.cur.col
        }
        let tags = self.effectTagList()
        if self.cur.kind != "->" {
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — a fn type declares its result with ->")
                return ""
            }
            self.failTok(self.cur, "E0105",
                "unexpected token — " + lexnum.quoteText(self.cur.text) + " in a function type reference: fn(T1, …, Tn) [tags] -> T")
            return ""
        }
        self.next()
        let retText = self.typeRefText()
        if self.stopped() {
            return ""
        }
        var head = "P fntype " + i64(t.line) + " " + i64(t.col)
        if tags != "" {
            head = head + " " + tags
        }
        head = head + " " + i64(tagLine) + " " + i64(tagCol) + "\n"
        return head + paramsText + retText
    }

    // parseBinding parses `let|var name [: type] = expr` (the keyword
    // included), answering the P lines plus the name position for the
    // caller's declare. The irrefutable tuple pattern is T4's face; a
    // paren head latches pending.
    pub fn parseBinding(mut self) -> (String, String, Int64, Int64) {
        let kw = self.cur
        self.next()
        let t = self.cur
        let pk = self.peek()
        if t.kind == "ident" && isPascal(t.text) && pk.kind == "(" {
            self.failTok(t, "E0105",
                "unexpected token — " + lexnum.quoteText(t.text) + " fits no binding name production: refutable patterns are match-only; the let name position takes an identifier or an irrefutable tuple pattern")
            return ("", "", 0, 0)
        }
        var name = ""
        var nameLine: Int64 = 0
        var nameCol: Int64 = 0
        var patSlot = "-\n"
        if t.kind == "ident" {
            self.checkCamel(t)
            if self.stopped() {
                return ("", "", 0, 0)
            }
            name = t.text
            nameLine = t.line
            nameCol = t.col
            self.next()
        } else {
            if t.kind == "_" {
                name = "_"
                nameLine = t.line
                nameCol = t.col
                self.next()
            } else {
                if t.kind == "(" {
                    let (pt, pb) = self.letTupleText()
                    if self.stopped() {
                        return ("", "", 0, 0)
                    }
                    patSlot = pt
                } else {
                    if t.kind == "eof" {
                        self.failTok(t, "E0105", "unexpected end of file — a binding wants let|var name [: type] = expr")
                        return ("", "", 0, 0)
                    }
                    self.failTok(t, "E0105",
                        "unexpected token — " + lexnum.quoteText(t.text) + " fits no binding name production: the let name position takes an identifier or an irrefutable tuple pattern")
                    return ("", "", 0, 0)
                }
            }
        }
        var typText = "-\n"
        if self.cur.kind == ":" {
            self.next()
            typText = self.typeRefText()
            if self.stopped() {
                return ("", "", 0, 0)
            }
        }
        if self.cur.kind != "=" {
            if self.cur.kind == "eof" {
                self.failTok(self.cur, "E0105", "unexpected end of file — a binding wants = and its initializer")
                return ("", "", 0, 0)
            }
            self.failTok(self.cur, "E0105",
                "unexpected token — " + lexnum.quoteText(self.cur.text) + " in a binding head: bindings are let|var name [: type] = expr")
            return ("", "", 0, 0)
        }
        self.next()
        let saved = self.valSite
        let savedValue = self.exprValue
        self.valSite = "a let initializer"
        self.exprValue = 1
        let initText = self.exprText()
        self.valSite = saved
        self.exprValue = savedValue
        if self.stopped() {
            return ("", "", 0, 0)
        }
        let body = "P binding " + i64(kw.line) + " " + i64(kw.col) + " " + lexnum.esc(kw.text) + " " + lexnum.esc(name) + " " + i64(nameLine) + " " + i64(nameCol) + "\n" + patSlot + typText + initText
        return (body, name, nameLine, nameCol)
    }

    // parseTopLet parses `[pub] let name [: type] = expr`: the binding
    // first, then the name's entry in the module name space (the
    // underscore binding declares nothing).
    pub fn parseTopLet(mut self, isPub: Bool, line: Int64, col: Int64) {
        let (body, name, nameLine, nameCol) = self.parseBinding()
        if self.stopped() {
            return
        }
        if name != "_" {
            self.declare(name, nameLine, nameCol)
            if self.stopped() {
                return
            }
        }
        self.astText = self.astText + "P toplet " + i64(line) + " " + i64(col) + " " + b01(isPub) + "\n" + body
    }

    // letTupleText parses a let head's irrefutable tuple pattern — two or
    // more elements of bindings, wildcards, and nested tuples; variant,
    // literal, and or-patterns are match-only (chapter 4). The trailing
    // comma closes without the two-element check, exactly as the reference
    // routes it; the duplicate-name law runs once over the whole tuple.
    pub fn letTupleText(mut self) -> (String, String) {
        let open = self.cur
        self.next()
        if self.cur.kind == ")" {
            self.failTok(open, "E0105",
                "unexpected token — \"()\" fits no binding name production: the let position takes an identifier or an irrefutable tuple pattern")
            return ("", "")
        }
        var text = "P pattuple " + i64(open.line) + " " + i64(open.col) + "\n"
        var binds = ""
        var count: Int64 = 0
        while true {
            let (et, eb) = self.irrefutableText()
            if self.stopped() {
                return ("", "")
            }
            text = text + et
            binds = binds + eb
            count = count + 1
            if self.cur.kind == "," {
                self.next()
                if self.cur.kind == ")" {
                    self.next()
                    break
                }
                continue
            }
            if self.cur.kind == ")" {
                if count < 2 {
                    self.failTok(open, "E0105",
                        "unexpected token — \"(\" fits no binding name production: a let tuple pattern holds two or more elements")
                    return ("", "")
                }
                self.next()
                break
            }
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — a let tuple pattern closes with )")
                return ("", "")
            }
            self.failTok(self.cur, "E0105",
                "unexpected token — " + lexnum.quoteText(self.cur.text) + " fits no irrefutable pattern production: the let position takes bindings, wildcards, and tuples of them")
            return ("", "")
        }
        self.checkDupBindsOf(binds)
        if self.stopped() {
            return ("", "")
        }
        return (text, binds)
    }

    // irrefutableText parses one element of a let tuple pattern.
    pub fn irrefutableText(mut self) -> (String, String) {
        let t = self.cur
        if t.kind == "_" {
            self.next()
            return ("P patwild " + i64(t.line) + " " + i64(t.col) + "\n", "")
        }
        if t.kind == "ident" && isPascal(t.text) == false {
            self.checkCamel(t)
            if self.stopped() {
                return ("", "")
            }
            self.next()
            return ("P patbind " + i64(t.line) + " " + i64(t.col) + " " + lexnum.esc(t.text) + "\n", t.text + " " + i64(t.line) + " " + i64(t.col) + "\n")
        }
        if t.kind == "(" {
            return self.letTupleText()
        }
        if t.kind == "ident" {
            self.failTok(t, "E0105",
                "unexpected token — " + lexnum.quoteText(t.text) + " fits no irrefutable pattern production: refutable patterns are match-only; the let position takes bindings, wildcards, and tuples of them")
            return ("", "")
        }
        if t.kind == "eof" {
            self.failTok(t, "E0105", "unexpected end of file — a let tuple pattern holds bindings, wildcards, and nested tuples")
            return ("", "")
        }
        self.failTok(t, "E0105",
            "unexpected token — " + lexnum.quoteText(t.text) + " fits no irrefutable pattern production: the let position takes bindings, wildcards, and tuples of them")
        return ("", "")
    }

    // checkDupBindsOf enforces E0404 within one pattern walk: a name bound
    // twice is rejected at its second binding. The binds encoding carries
    // each binding as "name line col"; a line marked "!" sits under an
    // or-branch and is skipped (branch sets are the or-name law's).
    pub fn checkDupBindsOf(mut self, binds: String) {
        let n = binds.byteLength()
        var seen = ""
        var i: Int64 = 0
        while i < n {
            let e = lineEndAt(binds, i)
            if lexnum.byteAt(binds, i) != 0x21 {
                var sp = i
                while sp < e && lexnum.byteAt(binds, sp) != 32 {
                    sp = sp + 1
                }
                let name = binds.byteSlice(i, sp)
                if nameListHas(seen, name) {
                    var sp2 = sp + 1
                    while sp2 < e && lexnum.byteAt(binds, sp2) != 32 {
                        sp2 = sp2 + 1
                    }
                    let bl = parseDec(binds, sp + 1, sp2)
                    let bc = parseDec(binds, sp2 + 1, e)
                    self.fail(bl, bc, "E0404",
                        "duplicate name in one module — one pattern binds " + lexnum.quoteText(name) + " twice; a pattern binds each name at most once")
                    return
                }
                seen = seen + name + "\n"
            }
            i = e + 1
        }
    }

    // parsePatternText parses one full pattern — an atom, or a flat
    // or-chain of atoms — answering its P lines, its binds encoding, and
    // its anchor (the or form anchors at its first |). The name-set checks
    // run only after every branch has parsed, per-branch duplicates first
    // and the or-name law second, exactly the reference's order.
    pub fn parsePatternText(mut self) -> (String, String, Int64, Int64) {
        let (ft, fb, fl, fc) = self.patternAtomText()
        if self.stopped() {
            return ("", "", 0, 0)
        }
        if self.cur.kind != "|" {
            self.checkDupBindsOf(fb)
            if self.stopped() {
                return ("", "", 0, 0)
            }
            return (ft, fb, fl, fc)
        }
        let orLine = self.cur.line
        let orCol = self.cur.col
        var text = "P pator " + i64(orLine) + " " + i64(orCol) + "\n" + ft
        var all = fb
        var segs = fb
        var branches: Int64 = 1
        while self.cur.kind == "|" {
            self.next()
            let (bt, bb, bl, bc) = self.patternAtomText()
            if self.stopped() {
                return ("", "", 0, 0)
            }
            text = text + bt
            all = all + bb
            segs = segs + ";;\n" + bb
            branches = branches + 1
        }
        var bi: Int64 = 0
        while bi < branches {
            self.checkDupBindsOf(segAt(segs, bi))
            if self.stopped() {
                return ("", "", 0, 0)
            }
            bi = bi + 1
        }
        let baseNames = namesAllOf(segAt(segs, 0))
        bi = 1
        while bi < branches {
            let names = namesAllOf(segAt(segs, bi))
            var same = nameListLen(baseNames) == nameListLen(names)
            if same {
                var j: Int64 = 0
                let bn = names.byteLength()
                while j < bn {
                    let je = lineEndAt(names, j)
                    if nameListHas(baseNames, names.byteSlice(j, je)) == false {
                        same = false
                        break
                    }
                    j = je + 1
                }
            }
            if same == false {
                let a = firstOnlyOf(baseNames, names)
                let b2 = firstOnlyOf(names, baseNames)
                self.fail(orLine, orCol, "E0302",
                    "or-pattern branches must bind the same names — the branches bind different names (" + lexnum.quoteText(a) + " and " + lexnum.quoteText(b2) + "); whichever branch matches, the arm body must see one binding set")
                return ("", "", 0, 0)
            }
            bi = bi + 1
        }
        return (text, markBinds(all), orLine, orCol)
    }

    // patternAtomText parses one non-or pattern: a literal, the wildcard, a
    // binding name, a (possibly qualified) variant with optional payload
    // sub-patterns, or a tuple.
    pub fn patternAtomText(mut self) -> (String, String, Int64, Int64) {
        let t = self.cur
        if t.kind == "int" || t.kind == "float" || t.kind == "string" || t.kind == "rune" {
            self.next()
            return ("P patlit " + i64(t.line) + " " + i64(t.col) + " " + lexnum.esc(t.kind) + " " + lexnum.esc(t.text) + "\n", "", t.line, t.col)
        }
        if isKw(t, "true") || isKw(t, "false") {
            self.next()
            return ("P patlit " + i64(t.line) + " " + i64(t.col) + " bool " + lexnum.esc(t.text) + "\n", "", t.line, t.col)
        }
        if t.kind == "_" {
            self.next()
            return ("P patwild " + i64(t.line) + " " + i64(t.col) + "\n", "", t.line, t.col)
        }
        if t.kind == "ident" && isPascal(t.text) == false {
            // a lowercase identifier followed by `.` qualifies a variant
            let pk = self.peek()
            if pk.kind == "." {
                let qual = t.text
                self.next()
                self.next()
                let nt = self.cur
                if nt.kind != "ident" || isPascal(nt.text) == false {
                    self.failTok(nt, "E0105",
                        "unexpected token — " + lexnum.quoteText(nt.text) + " where the variant name goes: a qualified pattern is module.Variant or module.Variant(sub-patterns)")
                    return ("", "", 0, 0)
                }
                return self.patVariantText(nt, true, qual)
            }
            self.checkCamel(t)
            if self.stopped() {
                return ("", "", 0, 0)
            }
            self.next()
            return ("P patbind " + i64(t.line) + " " + i64(t.col) + " " + lexnum.esc(t.text) + "\n", t.text + " " + i64(t.line) + " " + i64(t.col) + "\n", t.line, t.col)
        }
        if t.kind == "ident" {
            return self.patVariantText(t, false, "")
        }
        if t.kind == "(" {
            return self.patTupleText(t)
        }
        if t.kind == "-" {
            self.failTok(t, "E0105",
                "unexpected token — \"-\" fits no pattern production: patterns take chapter-1 literals, which carry no sign")
            return ("", "", 0, 0)
        }
        if t.kind == "eof" {
            self.failTok(t, "E0105", "unexpected end of file — a match arm is pattern [if cond] => body")
            return ("", "", 0, 0)
        }
        self.failTok(t, "E0105",
            "unexpected token — " + lexnum.quoteText(t.text) + " fits no pattern production: patterns are chapter-1 literals, _, binding names, variants, and tuples of patterns")
        return ("", "", 0, 0)
    }

    // patVariantText parses a variant pattern from its name token: bare (a
    // unit variant), or with a parenthesized payload sub-pattern list. The
    // qualified form carries its module qualifier's name.
    pub fn patVariantText(mut self, t: Token, qualified: Bool, qual: String) -> (String, String, Int64, Int64) {
        var text = "P patvariant " + i64(t.line) + " " + i64(t.col) + " " + b01(qualified) + " " + lexnum.esc(qual) + " " + lexnum.esc(t.text) + "\n"
        var binds = ""
        self.next()
        if self.cur.kind != "(" {
            return (text, binds, t.line, t.col)
        }
        self.next()
        while true {
            if self.cur.kind == ")" {
                self.next()
                return (text, binds, t.line, t.col)
            }
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — a payload sub-pattern list closes with )")
                return ("", "", 0, 0)
            }
            let (at, ab, al, ac) = self.parsePatternText()
            if self.stopped() {
                return ("", "", 0, 0)
            }
            text = text + at
            binds = binds + ab
            if self.cur.kind == "," {
                self.next()
                continue
            }
            if self.cur.kind == ")" {
                self.next()
                return (text, binds, t.line, t.col)
            }
            self.failTok(self.cur, "E0105",
                "unexpected token — " + lexnum.quoteText(self.cur.text) + " in a payload sub-pattern list: sub-patterns are comma-separated and the list closes with )")
            return ("", "", 0, 0)
        }
        return (text, binds, t.line, t.col)
    }

    // patTupleText parses a tuple pattern of two or more sub-patterns: "()"
    // is no pattern (the set has no unit pattern) and a one-element group is
    // no pattern either.
    pub fn patTupleText(mut self, open: Token) -> (String, String, Int64, Int64) {
        self.next()
        if self.cur.kind == ")" {
            self.failTok(open, "E0105",
                "unexpected token — \"()\" fits no pattern production: the pattern set has no unit pattern; use the wildcard _ for unit values")
            return ("", "", 0, 0)
        }
        var text = "P pattuple " + i64(open.line) + " " + i64(open.col) + "\n"
        var binds = ""
        var count: Int64 = 0
        while true {
            let (et, eb, el, ec) = self.parsePatternText()
            if self.stopped() {
                return ("", "", 0, 0)
            }
            text = text + et
            binds = binds + eb
            count = count + 1
            if self.cur.kind == "," {
                self.next()
                if self.cur.kind == ")" {
                    self.next()
                    return (text, binds, open.line, open.col)
                }
                continue
            }
            if self.cur.kind == ")" {
                if count < 2 {
                    self.failTok(open, "E0105",
                        "unexpected token — \"(\" fits no pattern production: a tuple pattern holds two or more sub-patterns")
                    return ("", "", 0, 0)
                }
                self.next()
                return (text, binds, open.line, open.col)
            }
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — a tuple pattern closes with )")
                return ("", "", 0, 0)
            }
            self.failTok(self.cur, "E0105",
                "unexpected token — " + lexnum.quoteText(self.cur.text) + " in a tuple pattern: sub-patterns are comma-separated and the pattern closes with )")
            return ("", "", 0, 0)
        }
        return (text, binds, open.line, open.col)
    }

    // matchExprText parses `match scrutinee { arms }`: at least one arm,
    // arms separated by line breaks with no separator token.
    pub fn matchExprText(mut self) -> String {
        let t = self.cur
        self.next()
        let scrut = self.headExprText()
        if self.stopped() {
            return ""
        }
        if self.cur.kind != "{" {
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — a match opens its arms with {")
                return ""
            }
            self.failTok(self.cur, "E0105",
                "unexpected token — " + lexnum.quoteText(self.cur.text) + " where a match's arm group opens")
            return ""
        }
        let open = self.cur
        self.next()
        if self.cur.kind == "}" {
            self.failTok(open, "E0301",
                "match requires at least one arm — the brace group holds no arms; with zero arms no arm can be taken and the match could never produce a value")
            return ""
        }
        var out = "P match " + i64(t.line) + " " + i64(t.col) + "\n" + scrut
        while true {
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — a match closes with }")
                return ""
            }
            let armText = self.matchArmText()
            if self.stopped() {
                return ""
            }
            out = out + armText
            if self.cur.kind == "}" {
                self.next()
                return out
            }
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — a match closes with }")
                return ""
            }
            if self.brokeLine() == false {
                self.failTok(self.cur, "E0105",
                    "unexpected token — " + lexnum.quoteText(self.cur.text) + " fits no production: match arms are separated by newlines and carry no separator token")
                return ""
            }
        }
        return out
    }

    // matchArmText parses `pattern [if cond] => body` — the body is one
    // expression (a block body arrives as a block expression), and the arm
    // anchors at its pattern's first token (an or-chain at its first |).
    pub fn matchArmText(mut self) -> String {
        let (pt, pb, pl, pc) = self.parsePatternText()
        if self.stopped() {
            return ""
        }
        var out = "P arm " + i64(pl) + " " + i64(pc) + "\n" + pt
        if isKw(self.cur, "if") {
            self.next()
            out = out + self.headExprText()
            if self.stopped() {
                return ""
            }
        } else {
            out = out + "-\n"
        }
        if self.cur.kind != "=>" {
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — a match arm is pattern [if cond] => body")
                return ""
            }
            self.failTok(self.cur, "E0105",
                "unexpected token — " + lexnum.quoteText(self.cur.text) + " fits no production: an arm is pattern [if cond] => body")
            return ""
        }
        self.next()
        let savedValue = self.exprValue
        self.exprValue = 1
        let body = self.exprText()
        self.exprValue = savedValue
        if self.stopped() {
            return ""
        }
        return out + body
    }

    // parseTestDecl parses `test "description" block` (chapter 20): the
    // body is a function-body context under the display name "(test)" with
    // no declared return — bare return exits it, `return e` is E0402 like
    // any valueless function. The inTestBody handoff (1 around the call)
    // lets the block mark itself as the test body's own — the single depth
    // where a mock declaration is a legal direct item. E1801 rides the
    // module-identity fact once the block has parsed, so the anchor is
    // exact either way and no partial tree escapes the diagnostic.
    pub fn parseTestDecl(mut self, line: Int64, col: Int64) {
        self.next()
        let t = self.cur
        if t.kind != "string" {
            if self.atEnd() {
                self.failTok(t, "E0105", "unexpected end of file — a test block wants its description string")
                return
            }
            self.failTok(t, "E0105",
                "unexpected token — " + lexnum.quoteText(t.text) + " where a test block names its description string")
            return
        }
        let desc = descText(t.text)
        let descLine = t.line
        let descCol = t.col
        self.next()
        if self.cur.kind != "{" {
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — a test block wants its body block")
                return
            }
            self.failTok(self.cur, "E0105",
                "unexpected token — " + lexnum.quoteText(self.cur.text) + " where a test block's body block opens")
            return
        }
        let saved = self.inTestBody
        self.inTestBody = 1
        let (body, n) = self.blockLoopText(1, "(test);0;0")
        self.inTestBody = saved
        if self.stopped() {
            return
        }
        if self.testModule == 0 {
            self.fail(line, col, "E1801",
                "test block outside a test module — this file's name does not end _test.we; the suffix is the module-identity fact that makes test blocks legal")
            return
        }
        self.astText = self.astText + "P test " + i64(line) + " " + i64(col) + " " + lexnum.esc(desc) + " " + i64(descLine) + " " + i64(descCol) + "\n" + body
    }

    // mockDeclText parses chapter 20's mock declaration: `mock target(params)
    // [-> type] [effect tags] { body }` — the caller has verified the depth
    // (a direct item of a test block body; E1802 holds everywhere else). The
    // target is a bare name or module.name. The signature restates the
    // target's own, and the production orders the declared return before the
    // effect segment — chapter 6's fn declaration reverses the two. The body
    // is a function-body context under the target's display name (E0402's
    // anchor); the module name space gains nothing.
    pub fn mockDeclText(mut self) -> String {
        let kw = self.cur
        self.next()
        let t = self.cur
        if t.kind != "ident" {
            if self.atEnd() {
                self.failTok(t, "E0105", "unexpected end of file — a mock declaration wants its target function's name")
                return ""
            }
            self.failTok(t, "E0105",
                "unexpected token — " + lexnum.quoteText(t.text) + " where a mock declaration names its target function")
            return ""
        }
        self.next()
        var target = t.text
        var targetLine = t.line
        var targetCol = t.col
        var targetQual = ""
        if self.cur.kind == "." {
            self.next()
            let nt = self.cur
            if nt.kind != "ident" {
                if self.atEnd() {
                    self.failTok(nt, "E0105", "unexpected end of file — a mock's qualified target is module.name")
                    return ""
                }
                self.failTok(nt, "E0105",
                    "unexpected token — " + lexnum.quoteText(nt.text) + " where a mock's qualified target names its fn: the target is name or module.name")
                return ""
            }
            targetQual = t.text
            target = nt.text
            targetLine = nt.line
            targetCol = nt.col
            self.next()
        }
        if self.cur.kind != "(" {
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — a mock declaration wants its parameter list")
                return ""
            }
            self.failTok(self.cur, "E0105",
                "unexpected token — " + lexnum.quoteText(self.cur.text) + " where a mock declaration's parameter list opens")
            return ""
        }
        let paramsText = self.annotatedParams()
        if self.stopped() {
            return ""
        }
        var retText = "-\n"
        var hasRet: Int64 = 0
        if self.cur.kind == "->" {
            self.next()
            retText = self.typeRefText()
            hasRet = 1
            if self.stopped() {
                return ""
            }
        }
        var effectTags = ""
        var effectLine: Int64 = 0
        var effectCol: Int64 = 0
        if isKw(self.cur, "effect") {
            let (tags, el, ec) = self.parseEffectSegment(false)
            effectTags = tags
            effectLine = el
            effectCol = ec
            if self.stopped() {
                return ""
            }
        }
        if self.cur.kind != "{" {
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — a mock declaration wants its body block")
                return ""
            }
            self.failTok(self.cur, "E0105",
                "unexpected token — " + lexnum.quoteText(self.cur.text) + " where a mock declaration's body block opens")
            return ""
        }
        var display = target
        if targetQual != "" {
            display = targetQual + "." + target
        }
        let bodyText = self.fnBlock(display, hasRet)
        if self.stopped() {
            return ""
        }
        var head = "P mock " + i64(kw.line) + " " + i64(kw.col) + " " + lexnum.esc(target) + " " + lexnum.esc(targetQual)
        if effectTags != "" {
            head = head + " " + effectTags
        }
        head = head + " " + i64(effectLine) + " " + i64(effectCol) + " " + i64(hasRet) + " " + i64(targetLine) + " " + i64(targetCol) + "\n"
        return head + paramsText + retText + bodyText
    }

    // exprText parses one full expression — the reference's parseExpr: the
    // twelve-level precedence climb over the closed table, unary prefix,
    // the postfix chain, and the primary family. The composed rows are
    // pre-order by construction: every parent row is prepended at the
    // point its operator or postfix token is consumed, its operands'
    // already-composed rows following.
    pub fn exprText(mut self) -> String {
        return self.binaryText(12)
    }

    // binaryText is precedence climbing over the closed table (the
    // reference's parseBinary). The loop head carries the two
    // line-joining decision points: at depth zero a token on a new line
    // ends the expression, and a `=` after a complete expression is the
    // assignment rule — the statement context's assignment attempt
    // (E0105) or the value context's E0103. Levels 9 and 12 are
    // non-associative: a same-level operator chaining a legal
    // continuation is E0104 at the second operator.
    pub fn binaryText(mut self, level: Int64) -> String {
        if level == 2 {
            return self.unaryText()
        }
        var lhs = self.binaryText(level - 1)
        if self.stopped() {
            return ""
        }
        while true {
            if self.atEnd() {
                return lhs
            }
            if self.depth == 0 && self.brokeLine() {
                return lhs
            }
            if self.cur.kind == "=" {
                if self.exprValue == 0 {
                    self.failTok(self.cur, "E0105",
                        "unexpected token — \"=\" after a complete expression statement: assignment targets are bare names (the one field form, self.field, belongs to a method receiver)")
                    return ""
                }
                self.failTok(self.cur, "E0103",
                    "assignment is not an expression — \"=\" cannot appear in an expression position: assignment is a statement, not an expression")
                return ""
            }
            let op = self.cur
            if binLevel(op.kind) != level {
                return lhs
            }
            self.next()
            let rhs = self.binaryText(level - 1)
            if self.stopped() {
                return ""
            }
            let head = "P binary " + i64(op.line) + " " + i64(op.col) + " " + lexnum.esc(op.text) + "\n"
            if level == 9 || level == 12 {
                // Non-associative: one operator per group.
                if self.atEnd() == false {
                    if self.depth == 0 && self.brokeLine() {
                        return head + lhs + rhs
                    }
                    if binLevel(self.cur.kind) == level {
                        if self.cur.kind == ".." {
                            self.failTok(self.cur, "E0104",
                                "chained non-associative operator — \"..\" chains a non-associative level; each range must be a single explicit group")
                            return ""
                        }
                        self.failTok(self.cur, "E0104",
                            "chained non-associative operator — " + lexnum.quoteText(self.cur.text) + " chains a non-associative level; write the split form, for example (a < b) && (b < c)")
                        return ""
                    }
                }
                return head + lhs + rhs
            }
            lhs = head + lhs + rhs
        }
        return lhs
    }

    // unaryText parses prefix `!`, `-`, `~` (level 2); prefix operators
    // bind looser than postfix, so their operand carries the whole chain.
    pub fn unaryText(mut self) -> String {
        let t = self.cur
        if t.kind == "!" || t.kind == "-" || t.kind == "~" {
            self.next()
            let x = self.unaryText()
            if self.stopped() {
                return ""
            }
            return "P unary " + i64(t.line) + " " + i64(t.col) + " " + lexnum.esc(t.text) + "\n" + x
        }
        return self.postfixText()
    }

    // postfixText parses the left-associative postfix chain (level 1):
    // .name, (args), the propagation `?`, the speculative explicit
    // application `<`, and the construction brace. The bareness trackers
    // carry the two postfix gates the stream cannot recover from rows
    // alone: bareName holds the ident while the node is exactly a bare
    // identifier (the `<` gate), chainText the dotted path while the node
    // is a bare ident/member chain (the construction gate — its final
    // segment must be PascalCase).
    pub fn postfixText(mut self) -> String {
        let (first, bare0, chain0) = self.primaryText()
        if self.stopped() {
            return ""
        }
        var node = first
        var bareName = bare0
        var chainText = chain0
        while true {
            if self.atEnd() {
                return node
            }
            if self.depth == 0 && self.brokeLine() {
                return node
            }
            let t = self.cur
            if t.kind == "." {
                self.next()
                let nt = self.cur
                if nt.kind != "ident" {
                    self.failTok(nt, "E0105",
                        "unexpected token — " + lexnum.quoteText(nt.text) + " after \".\": member names are identifiers")
                    return ""
                }
                node = "P member " + i64(t.line) + " " + i64(t.col) + " " + lexnum.esc(nt.text) + " " + i64(nt.line) + " " + i64(nt.col) + "\n" + node
                if chainText != "" {
                    chainText = chainText + "." + nt.text
                }
                bareName = ""
                self.next()
                continue
            }
            if t.kind == "(" {
                let args = self.callArgsText()
                if self.stopped() {
                    return ""
                }
                node = "P call " + i64(t.line) + " " + i64(t.col) + " 0 0\n" + node + args
                bareName = ""
                chainText = ""
                continue
            }
            if t.kind == "?" {
                node = "P prop " + i64(t.line) + " " + i64(t.col) + "\n" + node
                self.next()
                bareName = ""
                chainText = ""
                continue
            }
            if t.kind == "<" {
                // Explicit type arguments reach a bare-name head only —
                // obj.m<T>() keeps the comparison reading. The attempt is
                // speculative: a shape that does not commit restores the
                // stream and the comparison levels take the tokens.
                if bareName == "" {
                    return node
                }
                let (nm, il, ic) = identRowInfo(node)
                let next = self.tryTypeArgsText(node, nm, il, ic)
                if self.stopped() {
                    return ""
                }
                if next == "" {
                    return node
                }
                node = next
                bareName = ""
                chainText = ""
                continue
            }
            if t.kind == "[" {
                self.failTok(t, "E0105",
                    "unexpected token — \"[\" fits no postfix production: postfix is .name or (args); indexing is by named methods (the collections chapter)")
                return ""
            }
            if t.kind == "{" {
                // A control-flow head ends at its body brace — never a
                // construction. The suspension binds at every depth.
                if self.noBrace > 0 {
                    return node
                }
                // Construction: a bare name/member chain whose final name
                // is PascalCase — the head is a type reference.
                if chainText == "" || isPascal(afterLastDot(chainText)) == false {
                    self.failTok(t, "E0105",
                        "unexpected token — \"{\" after a complete expression: construction heads are PascalCase type references (chapter 8)")
                    return ""
                }
                node = self.constructText(t, chainText, "", 0, 0, self.last.line, self.last.col)
                if self.stopped() {
                    return ""
                }
                bareName = ""
                chainText = ""
                continue
            }
            return node
        }
        return node
    }

    // tryTypeArgsText speculatively parses an explicit generic clause on a
    // bare-name postfix head: `name<T…>(args)` — a call whose ArgLine
    // anchors at the clause's closing `>` — or `Name<T…> { … }` — a
    // construction with the same anchor. The attempt commits only when
    // the clause's closer is followed by ( or { under the postfix
    // continuation rule, and an empty clause is no explicit form at all.
    // Anything else restores the stream and answers empty (no explicit
    // form); a diagnostic raised before the commit is rolled back with
    // the stream (the reference's recover), one raised after it stands,
    // and the pending latch propagates either way (the reference re-panics
    // its NotImplemented face).
    pub fn tryTypeArgsText(mut self, idRow: String, idName: String, idLine: Int64, idCol: Int64) -> String {
        let savedPos = self.pos
        let savedCur = self.cur
        let savedLast = self.last
        let savedFailed = self.failed
        let savedErrLine = self.errLine
        let savedErrCol = self.errCol
        let savedErrCode = self.errCode
        let savedErrMsg = self.errMsg
        var committed: Int64 = 0
        let args = self.genericArgsText()
        if self.stopped() {
            if committed == 1 {
                return ""
            }
            if self.bnd != 0 {
                return ""
            }
            self.pos = savedPos
            self.cur = savedCur
            self.last = savedLast
            self.failed = savedFailed
            self.errLine = savedErrLine
            self.errCol = savedErrCol
            self.errCode = savedErrCode
            self.errMsg = savedErrMsg
            return ""
        }
        if args == "" {
            // no clause, or an empty clause: no explicit form at all
            self.pos = savedPos
            self.cur = savedCur
            self.last = savedLast
            return ""
        }
        // The postfix continuation rule holds after the clause too: at
        // depth zero a token on a new line ends the expression.
        if self.depth == 0 && self.brokeLine() {
            self.pos = savedPos
            self.cur = savedCur
            self.last = savedLast
            return ""
        }
        let cl = self.last
        if self.cur.kind == "(" {
            committed = 1
            let op = self.cur
            let callArgs = self.callArgsText()
            if self.stopped() {
                return ""
            }
            return "P call " + i64(op.line) + " " + i64(op.col) + " " + i64(cl.line) + " " + i64(cl.col) + "\n" + idRow + callArgs + args
        }
        if self.cur.kind == "{" {
            // The head suspension mirrored for the speculative form: a
            // control-flow head's body brace backs the attempt out.
            if self.noBrace > 0 {
                self.pos = savedPos
                self.cur = savedCur
                self.last = savedLast
                return ""
            }
            committed = 1
            if isPascal(idName) == false {
                self.failTok(self.cur, "E0105",
                    "unexpected token — \"{\" after a complete expression: construction heads are PascalCase type references (chapter 8)")
                return ""
            }
            return self.constructText(self.cur, idName, args, cl.line, cl.col, idLine, idCol)
        }
        self.pos = savedPos
        self.cur = savedCur
        self.last = savedLast
        return ""
    }

    // constructText parses chapter 8's construction and update braces: the
    // dotted head's final segment is the type name, the earlier segments
    // the qualifier; the field list is comma- or newline-separated with a
    // uniform trailing comma, and the update base is one postfix
    // expression after `with &`. argLine/argCol carry the explicit
    // generic clause's closer when the lookahead path handed the shape
    // over (0 0 on the plain path); hl/hc anchor the head's own name.
    pub fn constructText(mut self, open: Token, pathText: String, typeArgsText: String, argLine: Int64, argCol: Int64, hl: Int64, hc: Int64) -> String {
        var out = "P construct " + i64(hl) + " " + i64(hc) + " " + lexnum.esc(beforeLastDot(pathText)) + " " + lexnum.esc(afterLastDot(pathText)) + " " + i64(argLine) + " " + i64(argCol) + "\n" + typeArgsText
        self.next()
        self.depth = self.depth + 1
        var baseText = "-\n"
        while true {
            if self.cur.kind == "}" {
                self.next()
                self.depth = self.depth - 1
                return out + baseText
            }
            if isKw(self.cur, "with") {
                self.next()
                if self.cur.kind != "&" {
                    if self.atEnd() {
                        self.failTok(self.cur, "E0105", "unexpected end of file — an update base is with & followed by one postfix expression")
                        return ""
                    }
                    self.failTok(self.cur, "E0105",
                        "unexpected token — " + lexnum.quoteText(self.cur.text) + " fits no production here: an update base is with & followed by one postfix expression")
                    return ""
                }
                self.next()
                let savedValue = self.exprValue
                self.exprValue = 1
                baseText = self.postfixText()
                self.exprValue = savedValue
                if self.stopped() {
                    return ""
                }
                if self.cur.kind != "}" {
                    if self.atEnd() {
                        self.failTok(self.cur, "E0105", "unexpected end of file — a construction closes with }")
                        return ""
                    }
                    self.failTok(self.cur, "E0105",
                        "unexpected token — " + lexnum.quoteText(self.cur.text) + " after the update base: a construction closes with }")
                    return ""
                }
                self.next()
                self.depth = self.depth - 1
                return out + baseText
            }
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — a construction closes with }")
                return ""
            }
            let ft = self.cur
            if ft.kind != "ident" {
                self.failTok(ft, "E0105",
                    "unexpected token — " + lexnum.quoteText(ft.text) + " where a field name goes: field initializers are name: value pairs")
                return ""
            }
            self.next()
            if self.cur.kind != ":" {
                self.failTok(ft, "E0105",
                    "unexpected token — field " + lexnum.quoteText(ft.text) + " wants its value: field initializers are name: value pairs")
                return ""
            }
            self.next()
            out = out + "P fieldinit " + i64(ft.line) + " " + i64(ft.col) + " " + lexnum.esc(ft.text) + "\n"
            let savedValue = self.exprValue
            self.exprValue = 1
            out = out + self.exprText()
            self.exprValue = savedValue
            if self.stopped() {
                return ""
            }
            if self.cur.kind == "," {
                self.next()
                continue
            }
            if self.cur.kind == "}" || isKw(self.cur, "with") {
                continue
            }
            // a newline before the next field name continues the list
            if self.cur.kind == "ident" && self.brokeLine() {
                continue
            }
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — a construction closes with }")
                return ""
            }
            self.failTok(self.cur, "E0105",
                "unexpected token — " + lexnum.quoteText(self.cur.text) + " in a field initializer list: fields are name: value pairs separated by commas or line breaks")
            return ""
        }
        return out
    }

    // listLitText parses `[e1, …, en]`, n zero or more, with the uniform
    // trailing comma. The brackets are a paren region — line breaks
    // inside fold.
    pub fn listLitText(mut self, open: Token) -> String {
        var out = "P listlit " + i64(open.line) + " " + i64(open.col) + "\n"
        self.next()
        self.depth = self.depth + 1
        while true {
            if self.cur.kind == "]" {
                self.next()
                self.depth = self.depth - 1
                return out
            }
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — a list literal closes with ]")
                return ""
            }
            let savedValue = self.exprValue
            self.exprValue = 1
            out = out + self.exprText()
            self.exprValue = savedValue
            if self.stopped() {
                return ""
            }
            if self.cur.kind == "," {
                self.next()
                continue
            }
            if self.cur.kind == "]" {
                self.next()
                self.depth = self.depth - 1
                return out
            }
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — a list literal closes with ]")
                return ""
            }
            self.failTok(self.cur, "E0105",
                "unexpected token — " + lexnum.quoteText(self.cur.text) + " in a list literal: elements are comma-separated expressions and the literal closes with ]")
            return ""
        }
        return out
    }

    // tupleTailText parses a tuple expression's remainder after the first
    // comma and closes the paren group (the caller opened the depth; this
    // closes it). The tuple node and the E0602 arity report both anchor at
    // the group's opening paren.
    pub fn tupleTailText(mut self, open: Token, firstRows: String) -> String {
        var out = "P tuple " + i64(open.line) + " " + i64(open.col) + "\n" + firstRows
        var count: Int64 = 1
        while true {
            self.next()
            if self.cur.kind == ")" {
                self.next()
                self.depth = self.depth - 1
                self.tupleArity(open, count, "expression")
                if self.stopped() {
                    return ""
                }
                return out
            }
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — a tuple expression closes with )")
                return ""
            }
            let savedValue = self.exprValue
            self.exprValue = 1
            out = out + self.exprText()
            self.exprValue = savedValue
            if self.stopped() {
                return ""
            }
            count = count + 1
            if self.cur.kind == "," {
                continue
            }
            if self.cur.kind == ")" {
                self.next()
                self.depth = self.depth - 1
                self.tupleArity(open, count, "expression")
                if self.stopped() {
                    return ""
                }
                return out
            }
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — a tuple expression closes with )")
                return ""
            }
            self.failTok(self.cur, "E0105",
                "unexpected token — " + lexnum.quoteText(self.cur.text) + " where ) closes the tuple")
            return ""
        }
        return out
    }

    // callArgsText consumes `( … )` with comma-separated expressions and a
    // uniform trailing comma; inside, line breaks are insignificant. The
    // arguments are value positions.
    pub fn callArgsText(mut self) -> String {
        self.next()
        self.depth = self.depth + 1
        var out = ""
        while true {
            if self.cur.kind == ")" {
                self.next()
                self.depth = self.depth - 1
                return out
            }
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — a call argument list closes with )")
                return ""
            }
            let savedValue = self.exprValue
            self.exprValue = 1
            out = out + self.exprText()
            self.exprValue = savedValue
            if self.stopped() {
                return ""
            }
            if self.cur.kind == "," {
                self.next()
                continue
            }
            if self.cur.kind == ")" {
                self.next()
                self.depth = self.depth - 1
                return out
            }
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — a call argument list closes with )")
                return ""
            }
            self.failTok(self.cur, "E0105",
                "unexpected token — " + lexnum.quoteText(self.cur.text) + " in a call argument list: arguments are comma-separated expressions and the list closes with )")
            return ""
        }
        return out
    }

    // primaryText parses one primary expression, answering its rows plus
    // the two bareness trackers the postfix gates read (both empty unless
    // the primary is a bare identifier). fnBrace is one-shot: only this
    // primary — the short closure body's own leading brace — gets the
    // function-block reading.
    pub fn primaryText(mut self) -> (String, String, String) {
        let t = self.cur
        let fnBrace = self.fnBrace
        self.fnBrace = 0
        if t.kind == "ident" {
            self.next()
            return ("P ident " + i64(t.line) + " " + i64(t.col) + " " + lexnum.esc(t.text) + "\n", t.text, t.text)
        }
        if t.kind == "int" || t.kind == "float" || t.kind == "rune" {
            self.next()
            return ("P literal " + i64(t.line) + " " + i64(t.col) + " " + lexnum.esc(t.kind) + " " + lexnum.esc(t.text) + "\n", "", "")
        }
        if t.kind == "string" {
            if hasHole(t.text) {
                self.bndLatch("WEC-PENDING hole")
                return ("", "", "")
            }
            self.next()
            return ("P literal " + i64(t.line) + " " + i64(t.col) + " " + lexnum.esc(t.kind) + " " + lexnum.esc(t.text) + "\n", "", "")
        }
        if t.kind == "keyword" {
            if t.text == "true" || t.text == "false" {
                self.next()
                return ("P literal " + i64(t.line) + " " + i64(t.col) + " bool " + lexnum.esc(t.text) + "\n", "", "")
            }
            if t.text == "if" {
                return (self.ifExprText(), "", "")
            }
            if t.text == "match" {
                return (self.matchExprText(), "", "")
            }
            if t.text == "scope" {
                // the resource form is chapter 13's statement — it
                // produces no value; the compound forms are chapter 18's
                // value-carrying expressions
                if isKw(self.peek(), "resource") {
                    self.failTok(t, "E0202",
                        "valueless form in value position — " + lexnum.quoteText(t.text) + " produces no value and cannot stand in " + self.valSite + "; valueless forms are statements")
                    return ("", "", "")
                }
                return (self.scopeCompoundText(), "", "")
            }
            if t.text == "task" {
                return (self.taskText(), "", "")
            }
            if t.text == "select" {
                return (self.selectText(), "", "")
            }
            if t.text == "while" || t.text == "loop" || t.text == "break" || t.text == "continue" || t.text == "defer" || t.text == "for" {
                // ratified valueless statement forms. Inside a short
                // closure's maximal body break/continue hit the
                // closure-body loop reset first: E0201's position fact
                // outranks E0202's.
                if (t.text == "break" || t.text == "continue") && self.shortBody > 0 {
                    self.failTok(t, "E0201",
                        "break or continue outside a loop — " + lexnum.quoteText(t.text) + " stands in a block that is not inside a loop body; bare break and continue control the innermost enclosing while or loop")
                    return ("", "", "")
                }
                self.failTok(t, "E0202",
                    "valueless form in value position — " + lexnum.quoteText(t.text) + " produces no value and cannot stand in " + self.valSite + "; valueless forms are statements")
                return ("", "", "")
            }
            if t.text == "fn" {
                // an expression fn is a closure: the full form opens its
                // parameter list right after the keyword. peek is bound
                // first — a call result's field read is a stop face, while
                // a let-bound record's field reads are green.
                let pk = self.peek()
                if pk.kind == "(" {
                    return (self.fullClosureText(t), "", "")
                }
                if pk.kind == "eof" {
                    self.failTok(pk, "E0105", "unexpected end of file — an expression fn is a closure, fn(name: type, …) [-> type] { body }")
                    return ("", "", "")
                }
                self.failTok(t, "E0105",
                    "unexpected token — " + lexnum.quoteText(pk.text) + " where a closure's parameter list opens: an expression fn is a closure, fn(name: type, …) [-> type] { body }")
                return ("", "", "")
            }
            self.failTok(t, "E0105",
                "unexpected token — " + lexnum.quoteText(t.text) + " cannot begin an expression: expressions are identifiers, literals, (e), { block }, and unary ! - ~")
            return ("", "", "")
        }
        if t.kind == "(" {
            self.next()
            self.depth = self.depth + 1
            if self.cur.kind == ")" {
                // the unit value: the one value of the unit type
                let u = "P unit " + i64(t.line) + " " + i64(t.col) + "\n"
                self.next()
                self.depth = self.depth - 1
                return (u, "", "")
            }
            let savedValue = self.exprValue
            self.exprValue = 1
            let e = self.exprText()
            self.exprValue = savedValue
            if self.stopped() {
                return ("", "", "")
            }
            if self.cur.kind == "," {
                return (self.tupleTailText(t, e), "", "")
            }
            if self.cur.kind != ")" {
                if self.atEnd() {
                    self.failTok(self.cur, "E0105", "unexpected end of file — the group closes with )")
                    return ("", "", "")
                }
                self.failTok(self.cur, "E0105",
                    "unexpected token — " + lexnum.quoteText(self.cur.text) + " where ) closes the group")
                return ("", "", "")
            }
            self.next()
            self.depth = self.depth - 1
            // grouping folds away: grouping is binding — the inner
            // expression's bareness survives the fold, keeping the
            // postfix gates reachable through a group (`(f)<T>(1)` stays
            // an explicit application, `(std.Point) { … }` a
            // construction), so the trackers are read back from the
            // folded rows
            let ch = chainRowText(e)
            var nm = ch
            if beforeLastDot(ch) != "" {
                nm = ""
            }
            return (e, nm, ch)
        }
        if t.kind == "{" {
            if fnBrace == 1 {
                // a short closure's brace-led body is a function body block
                let (blk, n) = self.blockLoopText(1, "(closure);0;0")
                if self.stopped() {
                    return ("", "", "")
                }
                return ("P blockexpr " + i64(t.line) + " " + i64(t.col) + "\n" + blk, "", "")
            }
            let (blk, n) = self.blockLoopText(0, "")
            if self.stopped() {
                return ("", "", "")
            }
            return ("P blockexpr " + i64(t.line) + " " + i64(t.col) + "\n" + blk, "", "")
        }
        if t.kind == "[" {
            return (self.listLitText(t), "", "")
        }
        if t.kind == "|" {
            // a short closure in an operator's operand slot is
            // unreachable — the parenthesized spelling is the ratified one
            if operandSlot(self.last.kind) {
                self.failTok(t, "E0105",
                    "unexpected token — \"|\" fits no production here: a short closure in operand position must be parenthesized, as in 1 + (|x| x)")
                return ("", "", "")
            }
            return (self.shortClosureText(t), "", "")
        }
        if t.kind == "||" {
            // maximal munch leaves no zero-parameter short closure token
            self.failTok(t, "E0105",
                "unexpected token — \"||\" is the logical-or operator: no zero-parameter short closure exists; a zero-parameter closure is written in the full form fn() { ... }")
            return ("", "", "")
        }
        self.failTok(t, "E0105",
            "unexpected token — " + lexnum.quoteText(t.text) + " cannot begin an expression: expressions are identifiers, literals, (e), { block }, and unary ! - ~")
        return ("", "", "")
    }

    // fullClosureText parses the full closure form `fn(params) [-> type]
    // { body }`. A closure carries no effect segment — the body is a
    // function-body context under the closure's own name.
    pub fn fullClosureText(mut self, t: Token) -> String {
        self.next()
        var out = "P closure " + i64(t.line) + " " + i64(t.col) + " 0\n"
        out = out + self.annotatedParams()
        if self.stopped() {
            return ""
        }
        var retText = "-\n"
        var hasRet: Int64 = 0
        if self.cur.kind == "->" {
            self.next()
            retText = self.typeRefText()
            if self.stopped() {
                return ""
            }
            hasRet = 1
        }
        if self.cur.kind != "{" {
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — a closure wants its body block")
                return ""
            }
            self.failTok(self.cur, "E0105",
                "unexpected token — " + lexnum.quoteText(self.cur.text) + " where a closure's body block opens")
            return ""
        }
        let (body, n) = self.blockLoopText(1, "(closure);" + i64(hasRet) + ";0")
        if self.stopped() {
            return ""
        }
        return out + retText + body
    }

    // shortClosureText parses the short form `|p1, …, pk| body` (k at
    // least one). Parameters are bare names or name: type pairs; the body
    // is one maximal expression normalized to a one-item block. A
    // brace-led body gets the function-block reading (fnBrace), and the
    // closure-body loop reset makes break/continue in the maximal body
    // report E0201 ahead of E0202.
    pub fn shortClosureText(mut self, t: Token) -> String {
        self.next()
        var out = "P closure " + i64(t.line) + " " + i64(t.col) + " 1\n"
        if self.cur.kind == "|" {
            self.failTok(self.cur, "E0105",
                "unexpected token — \"|\" fits no production here: no zero-parameter short closure exists; a zero-parameter closure is written in the full form fn() { ... }")
            return ""
        }
        while true {
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — a short closure's parameter list closes with |")
                return ""
            }
            let nt = self.cur
            if nt.kind != "ident" {
                self.failTok(nt, "E0105",
                    "unexpected token — " + lexnum.quoteText(nt.text) + " in a short closure's parameter list: parameters are name or name: type pairs")
                return ""
            }
            self.checkCamel(nt)
            if self.stopped() {
                return ""
            }
            self.next()
            out = out + "P param 0 0 " + lexnum.esc(nt.text) + " " + i64(nt.line) + " " + i64(nt.col) + "\n"
            var typText = "-\n"
            if self.cur.kind == ":" {
                self.next()
                typText = self.typeRefText()
                if self.stopped() {
                    return ""
                }
            }
            out = out + typText
            if self.cur.kind == "," {
                self.next()
                continue
            }
            if self.cur.kind == "|" {
                self.next()
                break
            }
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — a short closure's parameter list closes with |")
                return ""
            }
            self.failTok(self.cur, "E0105",
                "unexpected token — " + lexnum.quoteText(self.cur.text) + " in a short closure's parameter list: parameters are name or name: type pairs")
            return ""
        }
        let savedLoop = self.loopDepth
        let savedDirect = self.direct
        self.loopDepth = 0
        self.direct = 1
        self.shortBody = self.shortBody + 1
        self.fnBrace = 1
        let bt = self.cur
        let savedValue = self.exprValue
        self.exprValue = 1
        let body = self.exprText()
        self.exprValue = savedValue
        self.shortBody = self.shortBody - 1
        self.fnBrace = 0
        self.loopDepth = savedLoop
        self.direct = savedDirect
        if self.stopped() {
            return ""
        }
        return out + "-\n" + "P block " + i64(t.line) + " " + i64(t.col) + "\n" + "P exprstmt " + i64(bt.line) + " " + i64(bt.col) + "\n" + body
    }

    // taskText parses `task effect tags block`: the body is a
    // function-body context under the task's own name (returns carry the
    // block's value, the loop depth resets).
    pub fn taskText(mut self) -> String {
        let t = self.cur
        self.next()
        if isKw(self.cur, "effect") == false {
            self.failTok(t, "E1601",
                "task block without an effect segment — the task keyword is followed directly by its block, leaving the body's calls answerable to no declaration; write the segment of the chapter 16 spelling: task effect tag1 tag2 ... followed by the block")
            return ""
        }
        let (tags, el, ec) = self.parseEffectSegment(false)
        if self.stopped() {
            return ""
        }
        let (body, n) = self.blockLoopText(1, "(task);1;0")
        if self.stopped() {
            return ""
        }
        return "P task " + i64(t.line) + " " + i64(t.col) + " " + tags + " " + i64(el) + " " + i64(ec) + "\n" + body
    }

    // scopeCompoundText parses chapter 18's scope forms — bare, timeout(n),
    // collectAll, timeout(n) collectAll — as the expression the value
    // positions carry. The clause order is fixed; the body is a plain
    // block.
    pub fn scopeCompoundText(mut self) -> String {
        let t = self.cur
        self.next()
        var timeoutText = "-\n"
        if isKw(self.cur, "timeout") {
            self.next()
            if self.cur.kind != "(" {
                if self.atEnd() {
                    self.failTok(self.cur, "E0105", "unexpected end of file — a scope timeout clause is timeout(n), milliseconds")
                    return ""
                }
                self.failTok(self.cur, "E0105",
                    "unexpected token — " + lexnum.quoteText(self.cur.text) + " where \"(\" opens the scope timeout clause: the clause is timeout(n), milliseconds")
                return ""
            }
            self.next()
            timeoutText = self.headExprText()
            if self.stopped() {
                return ""
            }
            if self.cur.kind != ")" {
                if self.atEnd() {
                    self.failTok(self.cur, "E0105", "unexpected end of file — the scope timeout clause closes with )")
                    return ""
                }
                self.failTok(self.cur, "E0105",
                    "unexpected token — " + lexnum.quoteText(self.cur.text) + " where the scope timeout clause closes with )")
                return ""
            }
            self.next()
        }
        var collectAllBit: Int64 = 0
        if isKw(self.cur, "collectAll") {
            self.next()
            collectAllBit = 1
        }
        if self.cur.kind != "{" {
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — a scope wants its body block")
                return ""
            }
            self.failTok(self.cur, "E0105",
                "unexpected token — " + lexnum.quoteText(self.cur.text) + " where the scope body opens")
            return ""
        }
        let (body, n) = self.blockLoopText(0, "")
        if self.stopped() {
            return ""
        }
        return "P scopeexpr " + i64(t.line) + " " + i64(t.col) + " " + i64(collectAllBit) + "\n" + timeoutText + body
    }

    // selectText parses `select { cases }`: at least two cases, separated
    // by line breaks with no separator token. Fewer than two is E1612 at
    // the select keyword.
    pub fn selectText(mut self) -> String {
        let t = self.cur
        self.next()
        if self.cur.kind != "{" {
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — a select opens its cases with {")
                return ""
            }
            self.failTok(self.cur, "E0105",
                "unexpected token — " + lexnum.quoteText(self.cur.text) + " where a select's case group opens")
            return ""
        }
        self.next()
        var out = "P select " + i64(t.line) + " " + i64(t.col) + "\n"
        var cases: Int64 = 0
        while true {
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — a select closes with }")
                return ""
            }
            if isKw(self.cur, "case") == false {
                if self.cur.kind == "}" {
                    self.next()
                    break
                }
                self.failTok(self.cur, "E0105",
                    "unexpected token — " + lexnum.quoteText(self.cur.text) + " where a select case begins: a case is case name = source => body")
                return ""
            }
            out = out + self.selectCaseText()
            if self.stopped() {
                return ""
            }
            cases = cases + 1
            if self.cur.kind == "}" {
                self.next()
                break
            }
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — a select closes with }")
                return ""
            }
            if self.brokeLine() == false {
                self.failTok(self.cur, "E0105",
                    "unexpected token — " + lexnum.quoteText(self.cur.text) + " fits no production: select cases are separated by newlines and carry no separator token")
                return ""
            }
        }
        if cases < 2 {
            self.failTok(t, "E1612",
                "select holds fewer than two cases — one case waiting on one source is a plain call wearing syntax; call the wait source directly, or add the second case the construct exists to race")
            return ""
        }
        return out
    }

    // selectCaseText parses `case name = source => body` (or the wildcard
    // `case _ = source => body`). The pattern is a bare binding name or
    // the wildcard — anything else is E1611 at the case keyword.
    pub fn selectCaseText(mut self) -> String {
        let t = self.cur
        self.next()
        var wildcard: Int64 = 0
        var name = ""
        if self.cur.kind == "_" {
            wildcard = 1
            self.next()
        } else {
            if self.cur.kind == "ident" && isCamel(self.cur.text) {
                name = self.cur.text
                self.next()
            } else {
                self.failTok(t, "E1611",
                    "select case pattern is not a binding or the wildcard — the case carries a pattern beyond a bare binding name or the wildcard _, and a no-match policy exists for no rule here; bind the whole yield to a name or discard it with _, and match inside the body if the yield needs splitting")
                return ""
            }
        }
        if self.cur.kind != "=" {
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — a select case is case name = source => body")
                return ""
            }
            self.failTok(self.cur, "E0105",
                "unexpected token — " + lexnum.quoteText(self.cur.text) + " where a select case's = goes: a case is case name = source => body")
            return ""
        }
        self.next()
        let savedValue = self.exprValue
        self.exprValue = 1
        let source = self.exprText()
        self.exprValue = savedValue
        if self.stopped() {
            return ""
        }
        if self.cur.kind != "=>" {
            if self.atEnd() {
                self.failTok(self.cur, "E0105", "unexpected end of file — a select case is case name = source => body")
                return ""
            }
            self.failTok(self.cur, "E0105",
                "unexpected token — " + lexnum.quoteText(self.cur.text) + " where a select case's => goes: a case is case name = source => body")
            return ""
        }
        self.next()
        let savedValue2 = self.exprValue
        self.exprValue = 1
        let body = self.exprText()
        self.exprValue = savedValue2
        if self.stopped() {
            return ""
        }
        return "P selectcase " + i64(t.line) + " " + i64(t.col) + " " + i64(wildcard) + " " + lexnum.esc(name) + "\n" + source + body
    }
}

// run is the parse section's entry (the design's module contract): the
// driver hands it the lexical sections — the T lines and the D/L lines —
// and appends what it returns. The empty source parses to the file line
// alone; a latched parse answers the diagnostic E line or the N line;
// everything else is the ast section's P-line family.
// binLevel is chapter 2's closed twelve-level precedence table; higher is
// looser. Levels 9 (the comparisons) and 12 (the range) are the
// non-associative ones. Zero answers "no binary operator".
fn binLevel(kind: String) -> Int64 {
    if kind == "*" || kind == "/" || kind == "%" {
        return 3
    }
    if kind == "+" || kind == "-" {
        return 4
    }
    if kind == "<<" || kind == ">>" {
        return 5
    }
    if kind == "&" {
        return 6
    }
    if kind == "^" {
        return 7
    }
    if kind == "|" {
        return 8
    }
    if kind == "<" || kind == "<=" || kind == ">" || kind == ">=" || kind == "==" || kind == "!=" {
        return 9
    }
    if kind == "&&" {
        return 10
    }
    if kind == "||" {
        return 11
    }
    if kind == ".." {
        return 12
    }
    return 0
}

// operandSlot reports whether a token kind places the next position in an
// operator's operand slot: a prefix or binary operator immediately before
// `|` means the short-closure form is unreachable there — the
// parenthesized spelling is the ratified one.
fn operandSlot(kind: String) -> Bool {
    if kind == "!" || kind == "~" {
        return true
    }
    return binLevel(kind) > 0
}

// afterLastDot returns the segment after the final dot (the whole string
// when no dot rides it).
fn afterLastDot(s: String) -> String {
    var i = s.byteLength() - 1
    while i >= 0 {
        if lexnum.byteAt(s, i) == 0x2E {
            return s.byteSlice(i + 1, s.byteLength())
        }
        i = i - 1
    }
    return s
}

// beforeLastDot returns the prefix before the final dot (empty when no
// dot rides the string).
fn beforeLastDot(s: String) -> String {
    var i = s.byteLength() - 1
    while i >= 0 {
        if lexnum.byteAt(s, i) == 0x2E {
            return s.byteSlice(0, i)
        }
        i = i - 1
    }
    return ""
}

// identRowInfo reads a bare identifier back out of its rendered rows —
// the group's fold answer. Grouping folds away, so `(x)` IS the ident x:
// the postfix faces that gate on a bare-name head (the explicit
// application `<`, the construction brace) stay reachable through a
// group. The answer is the name and its position when the rows are
// exactly one `P ident` line; the empty name refuses.
fn identRowInfo(rows: String) -> (String, Int64, Int64) {
    if hasPrefix(rows, "P ident ") == false {
        return ("", 0, 0)
    }
    let end = lineEndAt(rows, 0)
    // exactly one line, and a fifth field (the escaped name) present
    if end != rows.byteLength() - 1 {
        return ("", 0, 0)
    }
    var i: Int64 = 8
    let e1 = fieldEnd(rows, i, end)
    let ln = parseDec(rows, i, e1)
    i = e1 + 1
    let e2 = fieldEnd(rows, i, end)
    let cl = parseDec(rows, i, e2)
    i = e2 + 1
    // The name field runs to the line's end, so its exclusive end equals
    // end; presence is the start staying inside the line, not the end.
    if i >= end {
        return ("", 0, 0)
    }
    let e3 = fieldEnd(rows, i, end)
    return (unesc(rows, i, e3), ln, cl)
}

// rowNameField reads a P ident/member row's name field — the fifth field,
// after P, the node name, and the two position fields.
fn rowNameField(line: String, end: Int64) -> String {
    var i: Int64 = 0
    var f: Int64 = 0
    while f < 4 {
        i = fieldEnd(line, i, end) + 1
        f = f + 1
    }
    if i >= end {
        return ""
    }
    let e = fieldEnd(line, i, end)
    return unesc(line, i, e)
}

// chainRowText reconstructs a bare ident/member chain's dotted path from
// its rendered rows — the group's fold answer for the construction gate.
// The rows of exactly a bare chain are member rows (outermost first)
// ending in the root ident row; anything else is no chain. Grouping folds
// away (the ident-row answer above), so the postfix gates read the chain
// back out of the rows.
fn chainRowText(rows: String) -> String {
    let end = lineEndAt(rows, 0)
    if end == rows.byteLength() - 1 {
        // one line: a lone ident row is a one-segment chain
        if hasPrefix(rows, "P ident ") {
            return rowNameField(rows, end)
        }
        return ""
    }
    if hasPrefix(rows, "P member ") == false {
        return ""
    }
    let nm = rowNameField(rows, end)
    if nm == "" {
        return ""
    }
    let sub = chainRowText(rows.byteSlice(end + 1, rows.byteLength()))
    if sub == "" {
        return ""
    }
    return sub + "." + nm
}

pub fn run(toksText: String, docsText: String) -> String {
    let p = Parser {
        toksText: toksText, docsText: docsText, pos: 0,
        cur: tokAt(toksText, 0), last: zeroTok(),
        depth: 0, loopDepth: 0, direct: 0, noBrace: 0, shortBody: 0, fnBrace: 0,
        valSite: "", exprValue: 0, fnsText: "", namesText: "", itemStartsText: "",
        testModule: 0, inTestBody: 0, astText: "",
        failed: 0, errLine: 0, errCol: 0, errCode: "", errMsg: "",
        bnd: 0, bndWhat: "",
    }
    p.parseFile()
    if p.bnd != 0 {
        return "N " + p.bndWhat + "\n"
    }
    if p.failed != 0 {
        return "E " + i64(p.errLine) + " " + i64(p.errCol) + " " + p.errCode + " " + lexnum.esc(p.errMsg) + "\n"
    }
    return "ast\n" + p.astText
}

// drive adapts the driver's contract: a lexical error is the whole output
// already, so it appends nothing; otherwise the lexical output splits at
// its own line boundaries into the T-line and D/L-line sections (the
// headers drop out, the lines keep theirs) and run takes them. Escaped
// text never carries a raw newline, so the split is exact.
//
// The split is positional, not a rebuild: a serialization line is never
// empty, so the token section is exactly the byte range between the
// tokens header's newline and the docs header's line, and the docs
// section the range past the docs header's newline — two byteSlice calls,
// each sharing the source's bytes, allocate nothing. The previous form
// re-concatenated the sections one line at a time, which under the
// bootstrap runtime's immortal string buffers is quadratic dead
// intermediates; the self-host corpus entry died on that.
pub fn drive(lexOut: String) -> String {
    if lexOut.byteLength() >= 2 {
        if lexOut.byteSlice(0, 2) == "E " {
            return ""
        }
    }
    let n = lexOut.byteLength()
    let headerEnd = lineEndAt(lexOut, 0)
    var toksStart = headerEnd + 1
    if toksStart > n {
        toksStart = n
    }
    // The docs header, when present, is one whole line equal to "docs"
    // (every section line starts with its letter, so no T/D/L line can
    // spell it); its line start ends the token section.
    var docsAt = n
    var ls = toksStart
    while ls < n {
        let le = lineEndAt(lexOut, ls)
        if lexOut.byteSlice(ls, le) == "docs" {
            docsAt = ls
            break
        }
        ls = le + 1
    }
    var toksEnd = n
    var docsStart = n
    if docsAt < n {
        toksEnd = docsAt
        docsStart = lineEndAt(lexOut, docsAt) + 1
        if docsStart > n {
            docsStart = n
        }
    }
    return run(lexOut.byteSlice(toksStart, toksEnd), lexOut.byteSlice(docsStart, n))
}
