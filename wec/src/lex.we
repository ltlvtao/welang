// lex — the scanner core of the We-hosted port (B3b T2–T4): checkEncoding's
// three faces, the main token loop with whitespace and comment skipping,
// identifiers and keywords, the operator inventory, the /// docs side
// channel, the numeric and rune literal faces, and the string, escape,
// interpolation-hole, and attribute faces. The port mirrors
// internal/lex/lex.go statement for statement; the reconciliation tower
// requires the serialized output to be byte-identical to the Go lexer's.
//
// Two language-face adaptations shape the record (both disclosed in the
// change's design notes): We has no panic/recover, so Go's first-error
// stop is an error latch (failed + the four err fields) that every
// failure-capable caller checks; and this build cannot construct records
// carrying List fields, so the token stream never materializes as a list
// — each token's serialization line is appended to outText as it is
// scanned, and the docs side channel accumulates as pre-rendered strings.
// The observable contract is unchanged: a failed scan contributes only
// the E line, a successful one the tokens and docs sections.

import std.string

import lexnum

// Token is one lexical unit as it travels from a scan method to the
// emitting loop. AttrName/AttrArgs are T4's attr face and stay empty
// until then.
pub record Token {
    kind: String,
    text: String,
    line: Int64,
    col: Int64,
    attrName: String,
    attrArgs: String,
}

// Lexer is the scan state. col is the 1-based rune column of the next
// unconsumed rune. off/ri track the same position as byte offset and
// rune index (kept in lockstep; widthOf maps between them once
// checkEncoding has guaranteed well-formedness). docOpen/docLast plus
// pendStart/pendEnd/pendBody hold the /// side channel's pending unit
// until a run break or end of input flushes it into docsText.
pub record Lexer {
    src: String,
    n: Int64,
    rn: Int64,
    off: Int64,
    ri: Int64,
    line: Int64,
    col: Int64,
    failed: Bool,
    errLine: Int64,
    errCol: Int64,
    errCode: String,
    errMsg: String,
    outText: String,
    docsText: String,
    docsCount: Int64,
    docOpen: Bool,
    docLast: Int64,
    pendStart: Int64,
    pendEnd: Int64,
    pendBody: String,
}

// run scans one source and returns its full serialization (design D4):
// the tokens and docs sections on success, the single E line on the
// first lexical error. The driver passes this straight to stdout.
pub fn run(src: String) -> String {
    let l = Lexer {
        src: src, n: src.byteLength(), rn: src.runeCount(),
        off: 0, ri: 0, line: 1, col: 1,
        failed: false, errLine: 0, errCol: 0, errCode: "", errMsg: "",
        outText: "", docsText: "", docsCount: 0,
        docOpen: false, docLast: 0, pendStart: 0, pendEnd: 0, pendBody: "",
    }
    l.checkEncoding()
    if l.failed == false {
        l.scanAll()
    }
    return render(l)
}

// render folds the lexer's end state into the serialization's two
// columns: the E line replaces everything when the latch is set
// (chapter 1's first-error-stop — no token stream survives).
fn render(l: Lexer) -> String {
    if l.failed {
        return "E " + lexnum.int64ToString(l.errLine) + " " + lexnum.int64ToString(l.errCol) + " " + l.errCode + " " + lexnum.esc(l.errMsg) + "\n"
    }
    var out = "tokens\n" + l.outText
    if l.docsCount > 0 {
        out = out + "docs\n" + l.docsText
    }
    return out
}

// isKeyword is chapter 1's fully-reserved closed set (41 words). A single
// equality chain: the corpus stop-faces rule out a List<String> table in
// this build, and the linear chain is the zero-mechanism form.
fn isKeyword(t: String) -> Bool {
    return t == "fn" || t == "let" || t == "var" || t == "pub" || t == "import" || t == "as" || t == "mut" ||
        t == "if" || t == "else" || t == "return" || t == "match" || t == "for" || t == "in" ||
        t == "while" || t == "loop" || t == "break" || t == "continue" || t == "defer" ||
        t == "true" || t == "false" || t == "foreign" ||
        t == "record" || t == "byval" || t == "byres" || t == "newtype" || t == "with" ||
        t == "type" ||
        t == "interface" || t == "impl" || t == "where" || t == "derives" ||
        t == "scope" || t == "resource" ||
        t == "effect" ||
        t == "task" || t == "select" || t == "case" || t == "timeout" || t == "collectAll" ||
        t == "test" || t == "mock"
}

// isIdentStartCode / isIdentCharCode are the ASCII identifier domain:
// letters and underscore, then digits.
fn isIdentStartCode(c: Int64) -> Bool {
    return (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95
}

fn isIdentCharCode(c: Int64) -> Bool {
    return isIdentStartCode(c) || (c >= 48 && c <= 57)
}

// isOneCharOpCode is the one-byte operator and punctuation inventory:
// "+-*/%<>!&|^~=.,;:?(){}[]" by code point.
fn isOneCharOpCode(c: Int64) -> Bool {
    return c == 43 || c == 45 || c == 42 || c == 47 || c == 37 || c == 60 || c == 62 || c == 33 ||
        c == 38 || c == 124 || c == 94 || c == 126 || c == 61 || c == 46 || c == 44 || c == 59 ||
        c == 58 || c == 63 || c == 40 || c == 41 || c == 123 || c == 125 || c == 91 || c == 93
}

impl Lexer {
    // fail latches the first diagnostic; later calls are no-ops, which is
    // the port's equivalent of Go's panic already having unwound.
    pub fn fail(mut self, line: Int64, col: Int64, code: String, message: String) {
        if self.failed == false {
            self.failed = true
            self.errLine = line
            self.errCol = col
            self.errCode = code
            self.errMsg = message
        }
    }

    // codeHere is the current rune's code point; call only before end.
    pub fn codeHere(mut self) -> Int64 {
        return string.runeCode(self.src.charAt(self.ri))
    }

    // codeNext is the following rune's code point, 0 at end of input.
    pub fn codeNext(mut self) -> Int64 {
        if self.ri + 1 < self.rn {
            return string.runeCode(self.src.charAt(self.ri + 1))
        }
        return 0
    }

    // advance consumes one rune, maintaining line and the rune column.
    pub fn advance(mut self) {
        let c = self.codeHere()
        self.off = self.off + lexnum.widthOf(c)
        self.ri = self.ri + 1
        if c == 10 {
            self.line = self.line + 1
            self.col = 1
        } else {
            self.col = self.col + 1
        }
    }

    // posAt computes the 1-based line and rune column of the rune at byte
    // offset off (error paths only — it walks from the start).
    pub fn posAt(mut self, off: Int64) -> (Int64, Int64) {
        var ln: Int64 = 1
        var cl: Int64 = 1
        let pre = self.src.byteSlice(0, off)
        let m = pre.runeCount()
        var k: Int64 = 0
        while k < m {
            if string.runeCode(pre.charAt(k)) == 10 {
                ln = ln + 1
                cl = 1
            } else {
                cl = cl + 1
            }
            k = k + 1
        }
        return (ln, cl)
    }

    // fffdWellFormed reports whether the FFFFD the decoder yielded at off
    // is a literal U+FFFD (exactly EF BF BD, decoding as one rune in
    // three bytes) rather than the marker of an ill-formed sequence.
    pub fn fffdWellFormed(mut self, off: Int64) -> Bool {
        if off + 3 > self.n {
            return false
        }
        return self.src.byteSlice(off, off + 3).runeCount() == 1
    }

    // checkEncoding enforces chapter 1's Source files requirement before
    // any token scanning, in the reference's order: whole-file UTF-8
    // validity, then the byte-order-mark rule, then the bare-CR rule. On
    // success the leading BOM, if any, is stripped. The CR walk indexes
    // the stripped string while positions come from the original — the
    // reference's own quirk, preserved byte for byte.
    pub fn checkEncoding(mut self) {
        var off: Int64 = 0
        var ri: Int64 = 0
        while off < self.n {
            let c = string.runeCode(self.src.charAt(ri))
            if c == 0xFFFD {
                if self.fffdWellFormed(off) == false {
                    let badByte = lexnum.probeByteValue(self.src.byteSlice(off, off + 1))
                    let (ln, cl) = self.posAt(off)
                    self.fail(ln, cl, "E0001", "invalid character — byte 0x" + lexnum.hex2(badByte) + " at offset " + lexnum.int64ToString(off) + " is not valid UTF-8")
                    return
                }
            }
            off = off + lexnum.widthOf(c)
            ri = ri + 1
        }
        var base: Int64 = 0
        if self.rn > 0 {
            if self.src.charAt(0) == '\u{FEFF}' {
                base = 3
            }
        }
        var stripped = self.src
        if base == 3 {
            stripped = self.src.byteSlice(3, self.n)
        }
        var k: Int64 = 0
        var bo: Int64 = 0
        let m = stripped.runeCount()
        while k < m {
            if stripped.charAt(k) == '\u{FEFF}' {
                let bomOff = bo + base
                let (ln, cl) = self.posAt(bomOff)
                self.fail(ln, cl, "E0001", "invalid character — byte-order mark at offset " + lexnum.int64ToString(bomOff) + "; a single leading U+FEFF is ignored, any other appearance is an error")
                return
            }
            bo = bo + lexnum.widthOf(string.runeCode(stripped.charAt(k)))
            k = k + 1
        }
        var i: Int64 = 0
        let sn = stripped.byteLength()
        while i < sn {
            if stripped.byteSlice(i, i + 1) == "\r" {
                var bare = true
                if i + 1 < sn {
                    if stripped.byteSlice(i + 1, i + 2) == "\n" {
                        bare = false
                    }
                }
                if bare {
                    let (ln, cl) = self.posAt(i)
                    self.fail(ln, cl, "E0001", "invalid character — bare carriage return at offset " + lexnum.int64ToString(i) + "; line breaks are LF and CRLF counts as one break")
                    return
                }
            }
            i = i + 1
        }
        if base == 3 {
            self.src = self.src.byteSlice(3, self.n)
            self.n = self.n - 3
            self.rn = self.rn - 1
        }
    }

    // scanAll is the main token loop: skip whitespace and comments, then
    // scan one token, until end of input.
    pub fn scanAll(mut self) {
        while true {
            while self.off < self.n {
                let c = self.codeHere()
                if c == 32 || c == 9 || c == 10 || c == 13 {
                    self.advance()
                } else if c == 47 && self.codeNext() == 47 {
                    self.skipLineComment()
                } else if c == 47 && self.codeNext() == 42 {
                    self.docOpen = false
                    self.flushDoc()
                    self.skipBlockComment()
                    if self.failed {
                        return
                    }
                } else {
                    break
                }
            }
            if self.off >= self.n {
                self.flushDoc()
                let ln = self.line
                let cl = self.col
                self.emit(Token { kind: "eof", text: "", line: ln, col: cl, attrName: "", attrArgs: "" })
                return
            }
            let c = self.codeHere()
            if c == 34 {
                let t = self.scanString()
                if self.failed == false {
                    self.emit(t)
                }
            } else if c == 39 {
                let t = self.scanRune()
                if self.failed == false {
                    self.emit(t)
                }
            } else if c == 35 {
                let t = self.scanAttr()
                if self.failed == false {
                    self.emit(t)
                }
            } else if c >= 48 && c <= 57 {
                let t = self.scanNumber()
                if self.failed == false {
                    self.emit(t)
                }
            } else if isIdentStartCode(c) {
                let t = self.scanWord()
                self.emit(t)
            } else {
                let t = self.scanOperator()
                if self.failed == false {
                    self.emit(t)
                }
            }
            if self.failed {
                return
            }
        }
    }

    // emit appends one token's serialization line (design D4's T form;
    // attr tokens carry their name and raw argument text as two more
    // fields — unreachable in this build, where the empty whitelist
    // fails every unit, but the serialization spec's own shape).
    pub fn emit(mut self, t: Token) {
        var line = "T " + lexnum.int64ToString(t.line) + " " + lexnum.int64ToString(t.col) + " " + t.kind + " " + lexnum.esc(t.text)
        if t.kind == "attr" {
            line = line + " " + lexnum.esc(t.attrName) + " " + lexnum.esc(t.attrArgs)
        }
        self.outText = self.outText + line + "\n"
    }

    // flushDoc emits the pending /// unit, if any, as a D line plus its
    // already-escaped L lines, and closes the run.
    pub fn flushDoc(mut self) {
        if self.docOpen {
            self.docsText = self.docsText + "D " + lexnum.int64ToString(self.pendStart) + " " + lexnum.int64ToString(self.pendEnd) + "\n" + self.pendBody
            self.docsCount = self.docsCount + 1
            self.docOpen = false
        }
    }

    // skipLineComment consumes one // or /// comment to the end of the
    // line. A /// comment feeds the documentation side channel:
    // consecutive /// lines extend one unit; an ordinary // comment
    // breaks the run.
    pub fn skipLineComment(mut self) {
        let start = self.off
        let docLine = self.line
        while self.off < self.n {
            if self.codeHere() == 10 {
                break
            }
            self.advance()
        }
        var text = self.src.byteSlice(start, self.off)
        var tn = text.byteLength()
        while tn > 0 {
            if text.byteSlice(tn - 1, tn) == "\r" {
                tn = tn - 1
            } else {
                break
            }
        }
        text = text.byteSlice(0, tn)
        if tn >= 3 {
            if text.byteSlice(0, 3) == "///" {
                var inner = text.byteSlice(3, tn)
                let inLen = inner.byteLength()
                if inLen > 0 {
                    if inner.byteSlice(0, 1) == " " {
                        inner = inner.byteSlice(1, inLen)
                    }
                }
                if self.docOpen && self.docLast == docLine - 1 {
                    self.pendBody = self.pendBody + "L " + lexnum.esc(inner) + "\n"
                    self.pendEnd = docLine
                } else {
                    self.flushDoc()
                    self.pendStart = docLine
                    self.pendEnd = docLine
                    self.pendBody = "L " + lexnum.esc(inner) + "\n"
                    self.docOpen = true
                }
                self.docLast = docLine
                return
            }
        }
        self.flushDoc()
        self.docOpen = false
    }

    // skipBlockComment consumes one /* */ comment. Block comments do not
    // nest: the first */ closes the comment, an inner /* is ordinary
    // text, and end of input before the close is E0004.
    pub fn skipBlockComment(mut self) {
        let sl = self.line
        let sc = self.col
        self.advance()
        self.advance()
        while true {
            if self.off >= self.n {
                self.fail(sl, sc, "E0004", "unterminated block comment — /* is not closed by */ before end of file")
                return
            }
            if self.codeHere() == 42 {
                if self.codeNext() == 47 {
                    self.advance()
                    self.advance()
                    return
                }
            }
            self.advance()
        }
    }

    // scanWord consumes an identifier-shaped run and classifies it:
    // keyword (the closed reserved set), the bare underscore (chapter 1
    // lists `_` as punctuation), or identifier.
    pub fn scanWord(mut self) -> Token {
        let ln = self.line
        let cl = self.col
        let start = self.off
        while self.off < self.n {
            if isIdentCharCode(self.codeHere()) {
                self.advance()
            } else {
                break
            }
        }
        let text = self.src.byteSlice(start, self.off)
        var kind = "ident"
        if isKeyword(text) {
            kind = "keyword"
        }
        if text == "_" {
            kind = "_"
        }
        return Token { kind: kind, text: text, line: ln, col: cl, attrName: "", attrArgs: "" }
    }

    // scanRune consumes one rune literal token: exactly one character or
    // one escape between single quotes on a single line.
    pub fn scanRune(mut self) -> Token {
        let ln = self.line
        let cl = self.col
        let start = self.off
        self.consumeRuneLit()
        return Token { kind: "rune", text: self.src.byteSlice(start, self.off), line: ln, col: cl, attrName: "", attrArgs: "" }
    }

    // consumeRuneLit consumes one rune literal starting at its opening
    // quote. The registry folds the content rule into E0003: a rune
    // literal holds exactly one character or one escape, and it must
    // close on the same line. Go's fail panics, so the port returns
    // outright at each failure site.
    pub fn consumeRuneLit(mut self) {
        let quoteLine = self.line
        let quoteCol = self.col
        self.advance() // opening '
        if self.off >= self.n {
            self.fail(quoteLine, quoteCol, "E0003", "unterminated rune literal — not closed before the end of the line")
            return
        }
        let c = self.codeHere()
        if c == 10 || c == 13 {
            self.fail(quoteLine, quoteCol, "E0003", "unterminated rune literal — not closed before the end of the line")
            return
        }
        if c == 92 {
            // one escape counts as the one content character
            self.consumeEscape()
            if self.failed {
                return
            }
        } else if c == 39 {
            self.fail(quoteLine, quoteCol, "E0003", "unterminated rune literal — a rune holds exactly one character or one escape") // '' holds nothing
            return
        } else {
            self.advance() // exactly one character
        }
        if self.off >= self.n {
            self.fail(quoteLine, quoteCol, "E0003", "unterminated rune literal — not closed before the end of the line")
            return
        }
        let c2 = self.codeHere()
        if c2 == 10 || c2 == 13 {
            self.fail(quoteLine, quoteCol, "E0003", "unterminated rune literal — not closed before the end of the line")
            return
        }
        if c2 != 39 {
            self.fail(quoteLine, quoteCol, "E0003", "unterminated rune literal — a rune holds exactly one character or one escape")
            return
        }
        self.advance() // closing '
    }

    // scanString consumes one string literal token, validating escapes
    // and interpolation balance (E0002/E0005/E0007) on the way.
    pub fn scanString(mut self) -> Token {
        let ln = self.line
        let cl = self.col
        let start = self.off
        let _ = self.consumeStringLit(false) // a hard failure latches; the token never emits
        return Token { kind: "string", text: self.src.byteSlice(start, self.off), line: ln, col: cl, attrName: "", attrArgs: "" }
    }

    // consumeStringLit consumes one string literal starting at its opening
    // quote. soft=true reports an end-of-line run by returning false —
    // used where the quote may be the enclosing literal's own close (an
    // interpolation hole that never balanced); otherwise the run is E0002
    // at the opening quote. In the hard case the port latches and returns
    // false, where Go's fail panics and unwinds (the caller checks the
    // latch).
    pub fn consumeStringLit(mut self, soft: Bool) -> Bool {
        let quoteLine = self.line
        let quoteCol = self.col
        self.advance() // opening "
        while true {
            var atEnd = false
            if self.off >= self.n {
                atEnd = true
            } else {
                let c0 = self.codeHere()
                if c0 == 10 || c0 == 13 {
                    atEnd = true
                }
            }
            if atEnd {
                if soft {
                    return false
                }
                self.fail(quoteLine, quoteCol, "E0002", "unterminated string literal — not closed before the end of the line")
                return false
            }
            let c = self.codeHere()
            if c == 34 {
                self.advance()
                return true
            }
            if c == 92 {
                // A backslash may not dangle: the literal then never
                // closed, which is the primary fact.
                var dangling = false
                if self.off + 1 >= self.n {
                    dangling = true
                } else {
                    let nc = self.codeNext()
                    if nc == 10 || nc == 13 {
                        dangling = true
                    }
                }
                if dangling {
                    if soft {
                        return false
                    }
                    self.fail(quoteLine, quoteCol, "E0002", "unterminated string literal — not closed before the end of the line")
                    return false
                }
                self.consumeEscape()
                if self.failed {
                    return false
                }
            } else if c == 36 && self.codeNext() == 123 {
                let holeLine = self.line
                let holeCol = self.col
                self.advance() // '$'
                self.advance() // '{'
                self.consumeHole(holeLine, holeCol, quoteLine, quoteCol)
                if self.failed {
                    return false
                }
            } else {
                self.advance()
            }
        }
        return false // unreachable: the loop above only exits by return
    }

    // consumeHole consumes an interpolation hole after "${", stopping after
    // the "}" that balances it. A hole is a balanced-brace expression
    // region: parentheses and brackets opened inside it hold it open — a
    // "}" inside open parens is ordinary region text, which is what makes
    // chapter 1's own example "${f(}" unbalanced (the quote then falls
    // inside the still-open hole). Nested literals inside the hole are
    // consumed with their own rules, and their braces do not count. A
    // quote that cannot close a nested literal is the enclosing literal's
    // own close — with the hole still open that is E0007 at the opening
    // ${. (The message's literal "${" is assembled by concatenation so
    // this source's own string literals never open a hole.)
    pub fn consumeHole(mut self, holeLine: Int64, holeCol: Int64, quoteLine: Int64, quoteCol: Int64) {
        var depth: Int64 = 1  // braces; the hole's own ${ counts as one
        var parens: Int64 = 0 // open ( or [ within the hole so far
        while depth > 0 {
            var atEnd = false
            if self.off >= self.n {
                atEnd = true
            } else {
                let c0 = self.codeHere()
                if c0 == 10 || c0 == 13 {
                    atEnd = true
                }
            }
            if atEnd {
                self.fail(quoteLine, quoteCol, "E0002", "unterminated string literal — not closed before the end of the line")
                return
            }
            let c = self.codeHere()
            if c == 123 {
                depth = depth + 1
                self.advance()
            } else if c == 125 {
                if parens == 0 {
                    depth = depth - 1
                }
                self.advance()
            } else if c == 40 || c == 91 {
                parens = parens + 1
                self.advance()
            } else if c == 41 || c == 93 {
                if parens > 0 {
                    parens = parens - 1
                }
                self.advance()
            } else if c == 34 {
                let ok = self.consumeStringLit(true)
                if ok == false {
                    self.fail(holeLine, holeCol, "E0007", "unbalanced interpolation braces — the $" + "{ hole is not closed inside the literal")
                    return
                }
            } else if c == 39 {
                self.consumeRuneLit()
                if self.failed {
                    return
                }
            } else {
                self.advance()
            }
        }
    }

    // consumeEscape validates one escape sequence at the current backslash:
    // the closed set n t r 0 \ " ' and \u{h..} (1-6 hex digits, value at
    // most U+10FFFF, surrogates forbidden). The cursor lands after the
    // escape. The default arm renders the offending character the way Go's
    // strconv.Quote does inside the message (quoteBody), so control
    // characters stay printable.
    pub fn consumeEscape(mut self) {
        let escLine = self.line
        let escCol = self.col
        self.advance() // backslash
        if self.off >= self.n {
            // A trailing backslash at end of input: defensive (the string
            // and rune scanners check line ends first), kept total.
            self.fail(escLine, escCol, "E0005", "invalid escape sequence — a trailing \"\\\" is not in the closed set")
            return
        }
        let c = self.codeHere()
        if c == 110 || c == 116 || c == 114 || c == 48 || c == 92 || c == 34 || c == 39 {
            self.advance()
            return
        }
        if c == 117 {
            self.advance()
            var braceOk = true
            if self.off >= self.n {
                braceOk = false
            } else if self.codeHere() != 123 {
                braceOk = false
            } else {
                braceOk = true
            }
            if braceOk == false {
                self.fail(escLine, escCol, "E0005", "invalid escape sequence — \"\\u\" wants {h..} with 1-6 hex digits")
                return
            }
            self.advance() // '{'
            var cnt: Int64 = 0
            var val: Int64 = 0
            while true {
                var isHex = false
                if self.off < self.n {
                    if lexnum.isHexDigitB(self.codeHere()) {
                        isHex = true
                    }
                }
                if isHex == false {
                    break
                }
                cnt = cnt + 1
                val = val * 16 + lexnum.hexVal(self.codeHere())
                self.advance()
            }
            var bad = false
            if cnt < 1 {
                bad = true
            } else if cnt > 6 {
                bad = true
            } else if self.off >= self.n {
                bad = true
            } else if self.codeHere() != 125 {
                bad = true
            } else if val > 0x10FFFF {
                bad = true
            } else if val >= 0xD800 && val <= 0xDFFF {
                bad = true
            } else {
                bad = false
            }
            if bad {
                self.fail(escLine, escCol, "E0005", "invalid escape sequence — \"\\u{h..}\" wants 1-6 hex digits, a value at most U+10FFFF, and no surrogates")
                return
            }
            self.advance() // '}'
            return
        }
        // default: quote the offending character for the message
        let w = lexnum.widthOf(c)
        let body = lexnum.quoteBody(self.src.byteSlice(self.off, self.off + w))
        self.fail(escLine, escCol, "E0005", "invalid escape sequence — \"\\" + body + "\" is not in the closed set")
    }

    // scanAttr consumes one attribute unit: the token `#[`, a name, optional
    // parenthesized arguments, and the closing `]` — one lexical structure.
    // Validation order: form (E0001), then the literal-only argument rule
    // (E0009), then the closed whitelist (E0008) — with an empty
    // whitelist, checking the name first would leave E0009 unreachable.
    // The whitelist is empty in this build, so every well-formed unit dies
    // E0008 at its start and the Token never reaches emit (the attr fields
    // stay on the record for the serialization spec's own shape).
    pub fn scanAttr(mut self) -> Token {
        let ln = self.line
        let cl = self.col
        let start = self.off
        if self.codeNext() != 91 {
            self.fail(ln, cl, "E0001", "invalid character — \"#\" must be followed by \"[\" to open an attribute unit")
            return Token { kind: "", text: "", line: ln, col: cl, attrName: "", attrArgs: "" }
        }
        self.advance() // '#'
        self.advance() // '['
        self.skipHoriz()
        var nameOk = true
        if self.off >= self.n {
            nameOk = false
        } else if isIdentStartCode(self.codeHere()) == false {
            nameOk = false
        } else {
            nameOk = true
        }
        if nameOk == false {
            let nl = self.line
            let nc = self.col
            self.fail(nl, nc, "E0001", "invalid character — the attribute unit expects a name, optional (arguments), then \"]\" on one line")
            return Token { kind: "", text: "", line: ln, col: cl, attrName: "", attrArgs: "" }
        }
        let nameLine = self.line
        let nameCol = self.col
        let nameStart = self.off
        while self.off < self.n {
            if isIdentCharCode(self.codeHere()) {
                self.advance()
            } else {
                break
            }
        }
        let name = self.src.byteSlice(nameStart, self.off)
        if isKeyword(name) {
            self.fail(nameLine, nameCol, "E0001", "invalid character — the attribute unit expects a name, optional (arguments), then \"]\" on one line") // a keyword is not a name
            return Token { kind: "", text: "", line: ln, col: cl, attrName: "", attrArgs: "" }
        }
        self.skipHoriz()
        var argsRaw = ""
        var argsOff: Int64 = 0
        if self.off < self.n {
            if self.codeHere() == 40 {
                argsOff = self.off + 1
                self.consumeAttrArgs()
                if self.failed {
                    return Token { kind: "", text: "", line: ln, col: cl, attrName: "", attrArgs: "" }
                }
                argsRaw = lexnum.trimSpace(self.src.byteSlice(argsOff, self.off - 1))
            }
        }
        self.skipHoriz()
        var closeOk = true
        if self.off >= self.n {
            closeOk = false
        } else if self.codeHere() != 93 {
            closeOk = false
        } else {
            closeOk = true
        }
        if closeOk == false {
            let nl = self.line
            let nc = self.col
            self.fail(nl, nc, "E0001", "invalid character — the attribute unit expects a name, optional (arguments), then \"]\" on one line")
            return Token { kind: "", text: "", line: ln, col: cl, attrName: "", attrArgs: "" }
        }
        self.advance() // ']'
        if argsRaw != "" {
            self.validateAttrArgs(argsRaw, argsOff)
            if self.failed {
                return Token { kind: "", text: "", line: ln, col: cl, attrName: "", attrArgs: "" }
            }
        }
        // the whitelist is empty in this build: every name reports E0008
        self.fail(ln, cl, "E0008", "unknown attribute — " + lexnum.quoteText(name) + " is not in the closed whitelist")
        return Token { kind: "", text: "", line: ln, col: cl, attrName: "", attrArgs: "" }
    }

    // skipHoriz skips the attribute unit's horizontal whitespace.
    pub fn skipHoriz(mut self) {
        while self.off < self.n {
            let c = self.codeHere()
            if c == 32 || c == 9 {
                self.advance()
            } else {
                break
            }
        }
    }

    // consumeAttrArgs consumes a balanced parenthesized argument region,
    // starting at '(' and stopping after its matching ')'. Strings and
    // runes inside are consumed with their own literal rules; a newline
    // before the unit closes is a form violation. The expected-closer
    // stack is a String (this build cannot construct a byte list): the
    // top is its last byte, push appends, pop slices it away.
    pub fn consumeAttrArgs(mut self) {
        var stack = ")"
        self.advance() // '('
        while stack.byteLength() > 0 {
            var atEnd = false
            if self.off >= self.n {
                atEnd = true
            } else {
                let c0 = self.codeHere()
                if c0 == 10 || c0 == 13 {
                    atEnd = true
                }
            }
            if atEnd {
                let nl = self.line
                let nc = self.col
                self.fail(nl, nc, "E0001", "invalid character — the attribute unit expects a name, optional (arguments), then \"]\" on one line")
                return
            }
            let c = self.codeHere()
            if c == 40 {
                stack = stack + ")"
                self.advance()
            } else if c == 91 {
                stack = stack + "]"
                self.advance()
            } else if c == 41 || c == 93 {
                let sn = stack.byteLength()
                let closer = self.src.byteSlice(self.off, self.off + 1)
                if closer != stack.byteSlice(sn - 1, sn) {
                    let nl = self.line
                    let nc = self.col
                    self.fail(nl, nc, "E0001", "invalid character — the attribute unit expects a name, optional (arguments), then \"]\" on one line")
                    return
                }
                stack = stack.byteSlice(0, sn - 1)
                self.advance()
            } else if c == 34 {
                let sl = self.line
                let sc = self.col
                let ok = self.consumeStringLit(true)
                if ok == false {
                    self.fail(sl, sc, "E0002", "unterminated string literal — not closed before the end of the line")
                    return
                }
            } else if c == 39 {
                self.consumeRuneLit()
                if self.failed {
                    return
                }
            } else {
                self.advance()
            }
        }
    }

    // failAt latches a diagnostic positioned at a byte offset (the
    // argument-region validator reports at the argument's own start).
    pub fn failAt(mut self, off: Int64, code: String, message: String) {
        let (ln, cl) = self.posAt(off)
        self.fail(ln, cl, code, message)
    }

    // validateAttrArgs checks the literal-only argument rule (E0009)
    // against the raw argument text: each argument is a string, number,
    // boolean, or a literal list of those; anything else — an expression,
    // call, or reference — fails at the argument's start.
    pub fn validateAttrArgs(mut self, raw: String, base: Int64) {
        let n = raw.byteLength()
        var i: Int64 = 0
        while true {
            if self.failed {
                return
            }
            while i < n {
                let c = lexnum.byteAt(raw, i)
                if c == 32 || c == 9 {
                    i = i + 1
                } else {
                    break
                }
            }
            if i >= n {
                return
            }
            // var (not let): a let bound from a bare local var aliases the
            // var's storage in this build's compiler (the snapshot reads
            // the current value, not the value at binding) — a var-to-var
            // copy is a real copy. Registered as follow-up #31.
            var argStart: Int64 = i
            let (ni, ok) = self.parseArgLiteral(raw, i, base)
            i = ni
            if ok == false {
                self.failAt(base + argStart, "E0009", "non-literal attribute argument — " + lexnum.quoteText(lexnum.collectArg(raw, argStart)) + ": arguments are compile-time literals only")
                return
            }
            while i < n {
                let c = lexnum.byteAt(raw, i)
                if c == 32 || c == 9 {
                    i = i + 1
                } else {
                    break
                }
            }
            if i >= n {
                return
            }
            if lexnum.byteAt(raw, i) == 44 {
                i = i + 1
            } else {
                self.failAt(base + argStart, "E0009", "non-literal attribute argument — " + lexnum.quoteText(lexnum.collectArg(raw, argStart)) + ": arguments are compile-time literals only")
                return
            }
        }
    }

    // parseArgLiteral parses one literal at raw[i], returning the offset
    // just past it and whether it is a literal. False means the argument
    // is not a literal (an expression, call, or reference — as in the
    // `1e5` cut, which is two tokens); a malformed numeric inside the
    // region reports E0006 directly at the argument's own position (a bad
    // literal is a literal-form error, not a non-literal argument).
    pub fn parseArgLiteral(mut self, raw: String, i: Int64, base: Int64) -> (Int64, Bool) {
        let n = raw.byteLength()
        let b = lexnum.byteAt(raw, i)
        if b == 34 {
            // a string literal is one argument unless it interpolates
            let (end, interp) = lexnum.skipArgString(raw, i)
            if end < 0 || interp {
                return (i, false)
            }
            return (end, true)
        }
        if b == 91 {
            // a literal list of literals
            var j = i + 1
            while true {
                if self.failed {
                    return (i, false)
                }
                while j < n {
                    let c = lexnum.byteAt(raw, j)
                    if c == 32 || c == 9 {
                        j = j + 1
                    } else {
                        break
                    }
                }
                if j >= n {
                    return (i, false)
                }
                if lexnum.byteAt(raw, j) == 93 {
                    return (j + 1, true)
                }
                let (nj, ok) = self.parseArgLiteral(raw, j, base)
                if ok == false {
                    return (i, false)
                }
                j = nj
                while j < n {
                    let c = lexnum.byteAt(raw, j)
                    if c == 32 || c == 9 {
                        j = j + 1
                    } else {
                        break
                    }
                }
                var comma = false
                if j < n {
                    if lexnum.byteAt(raw, j) == 44 {
                        comma = true
                    }
                }
                if comma {
                    j = j + 1
                    continue
                }
                if j >= n {
                    return (i, false)
                }
                if lexnum.byteAt(raw, j) != 93 {
                    return (i, false)
                }
            }
        }
        if b == 116 {
            if lexnum.hasPrefixAt(raw, i, "true") {
                if i + 4 >= n {
                    return (i + 4, true)
                }
                if isIdentCharCode(lexnum.byteAt(raw, i + 4)) == false {
                    return (i + 4, true)
                }
                return (i, false)
            }
            return (i, false)
        }
        if b == 102 {
            if lexnum.hasPrefixAt(raw, i, "false") {
                if i + 5 >= n {
                    return (i + 5, true)
                }
                if isIdentCharCode(lexnum.byteAt(raw, i + 5)) == false {
                    return (i + 5, true)
                }
                return (i, false)
            }
            return (i, false)
        }
        if lexnum.isDigitB(b) == false {
            return (i, false)
        }
        // a numeric literal, validated by its own clauses (E0006 at the
        // argument's position)
        let end = lexnum.numericSpan(raw, i)
        let text = raw.byteSlice(i, end)
        let tn = text.byteLength()
        var isBased = false
        if tn >= 2 {
            if lexnum.byteAt(text, 0) == 48 {
                let b1 = lexnum.byteAt(text, 1)
                if b1 == 120 || b1 == 111 || b1 == 98 {
                    isBased = true
                }
            }
        }
        if isBased {
            let detail = lexnum.validateBased(text)
            if detail != "" {
                self.failAt(base + i, "E0006", "invalid numeric literal — " + lexnum.quoteText(text) + ": " + detail)
            }
            return (end, true)
        }
        if lexnum.hasDot(text) {
            let detail = lexnum.validateFloat(text)
            if detail != "" {
                self.failAt(base + i, "E0006", "invalid numeric literal — " + lexnum.quoteText(text) + ": " + detail)
            }
            return (end, true)
        }
        let j = lexnum.digitRunEnd(text, 0)
        let digits = text.byteSlice(0, j)
        let tail = text.byteSlice(j, tn)
        let detail = lexnum.checkDigitRun(digits, true)
        if detail != "" {
            self.failAt(base + i, "E0006", "invalid numeric literal — " + lexnum.quoteText(text) + ": " + detail)
        }
        if tail == "" {
            return (end, true)
        }
        if lexnum.knownIntSuffix(tail) {
            return (end, true)
        }
        if lexnum.knownFloatSuffix(tail) || lexnum.allLetters(tail) {
            self.failAt(base + i, "E0006", "invalid numeric literal — " + lexnum.quoteText(text) + ": the suffix set is closed (i8 i16 i32 i64 u8 u16 u32 u64, floats f32 f64)")
            return (end, true)
        }
        return (i, false) // not one literal token (as in `1e5`): the argument is non-literal
    }

    // scanNumber consumes one numeric literal: a greedy numeric-shaped
    // span, then a validation against chapter 1's forms. A violation
    // reports E0006 at the span start with the clause that failed. One
    // form cuts the token short: an undotted decimal followed by an
    // identifier-shaped tail (as in `1e5` — no dot means no float
    // attempt) emits the integer and the tail re-lexes as a separate
    // identifier token.
    pub fn scanNumber(mut self) -> Token {
        let ln = self.line
        let cl = self.col
        let start = self.off
        let end = lexnum.numericSpan(self.src, start)
        let text = self.src.byteSlice(start, end)
        let tn = text.byteLength()
        var consume = tn
        var kind = "int"

        var isBased = false
        if tn >= 2 {
            if lexnum.byteAt(text, 0) == 48 {
                let b1 = lexnum.byteAt(text, 1)
                if b1 == 120 || b1 == 111 || b1 == 98 {
                    isBased = true
                }
            }
        }
        if isBased {
            let detail = lexnum.validateBased(text)
            if detail != "" {
                self.fail(ln, cl, "E0006", "invalid numeric literal — " + lexnum.quoteText(text) + ": " + detail)
                return Token { kind: "", text: "", line: ln, col: cl, attrName: "", attrArgs: "" }
            }
        } else if lexnum.hasDot(text) {
            kind = "float"
            let detail = lexnum.validateFloat(text)
            if detail != "" {
                self.fail(ln, cl, "E0006", "invalid numeric literal — " + lexnum.quoteText(text) + ": " + detail)
                return Token { kind: "", text: "", line: ln, col: cl, attrName: "", attrArgs: "" }
            }
        } else {
            let i = lexnum.digitRunEnd(text, 0)
            let digits = text.byteSlice(0, i)
            let tail = text.byteSlice(i, tn)
            let detail = lexnum.checkDigitRun(digits, true)
            if detail != "" {
                self.fail(ln, cl, "E0006", "invalid numeric literal — " + lexnum.quoteText(text) + ": " + detail)
                return Token { kind: "", text: "", line: ln, col: cl, attrName: "", attrArgs: "" }
            }
            var cut = false
            if tail != "" {
                if lexnum.knownIntSuffix(tail) == false {
                    if lexnum.knownFloatSuffix(tail) || lexnum.allLetters(tail) {
                        // `42f32` (a float suffix on an integer form) and
                        // `42int` (a letter-shaped suffix attempt) both
                        // violate the closed set
                        self.fail(ln, cl, "E0006", "invalid numeric literal — " + lexnum.quoteText(text) + ": the suffix set is closed (i8 i16 i32 i64 u8 u16 u32 u64, floats f32 f64)")
                        return Token { kind: "", text: "", line: ln, col: cl, attrName: "", attrArgs: "" }
                    }
                    cut = true
                }
            }
            if cut {
                consume = i // the tail re-lexes as an identifier
            }
        }

        self.off = start + consume
        self.ri = self.ri + consume
        self.col = self.col + consume // numeric spans are ASCII
        return Token { kind: kind, text: text.byteSlice(0, consume), line: ln, col: cl, attrName: "", attrArgs: "" }
    }

    // scanOperator consumes one operator or punctuation token — maximal
    // munch tries the two-byte forms first — or reports E0001 for a
    // character matching nothing in the inventory. The reference splits
    // non-ASCII misses by unicode.IsLetter, which We has no table for;
    // every non-ASCII miss takes the identifier-homoglyph shape (the
    // corpus's other shape is the plain ASCII miss, kept exact).
    pub fn scanOperator(mut self) -> Token {
        let ln = self.line
        let cl = self.col
        var end2 = self.off + 2
        if end2 > self.n {
            end2 = self.n
        }
        let pair = self.src.byteSlice(self.off, end2)
        if pair == "==" || pair == "!=" || pair == "<=" || pair == ">=" || pair == "&&" || pair == "||" || pair == "<<" || pair == ">>" || pair == "->" || pair == "=>" || pair == ".." {
            self.off = self.off + 2
            self.ri = self.ri + 2
            self.col = self.col + 2
            return Token { kind: pair, text: pair, line: ln, col: cl, attrName: "", attrArgs: "" }
        }
        let c = self.codeHere()
        if isOneCharOpCode(c) {
            let t = self.src.byteSlice(self.off, self.off + 1)
            self.advance()
            return Token { kind: t, text: t, line: ln, col: cl, attrName: "", attrArgs: "" }
        }
        let w = lexnum.widthOf(c)
        let t = self.src.byteSlice(self.off, self.off + w)
        if c >= 128 {
            self.fail(ln, cl, "E0001", "invalid character — " + lexnum.quote(t) + " in an identifier: identifiers are ASCII-only (homoglyph confusability is a security surface)")
        } else {
            self.fail(ln, cl, "E0001", "invalid character — " + lexnum.quote(t) + " matches no token in the lexical inventory")
        }
        return Token { kind: "", text: "", line: ln, col: cl, attrName: "", attrArgs: "" }
    }
}
